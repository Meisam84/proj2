# Development env sample
SECRET_KEY=replace-this-with-a-secure-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CELERY_BROKER_URL=redis://redis:6379/0

# Postgres (for docker-compose)
DATABASE_URL=postgres://irib_user:irib_pass@db:5432/irib_db
POSTGRES_DB=irib_db
POSTGRES_USER=irib_user
POSTGRES_PASSWORD=irib_pass

# SMTP / Email (optional) - uncomment and set to enable sending real emails
# If EMAIL_HOST is set, settings.py will switch to SMTP backend automatically.
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=user@example.com
#EMAIL_HOST_PASSWORD=supersecret
#EMAIL_USE_TLS=True
#DEFAULT_FROM_EMAIL=no-reply@example.com

# Optional: Twilio credentials for SMS alerts (optional)
#TWILIO_ACCOUNT_SID=your_account_sid
#TWILIO_AUTH_TOKEN=your_auth_token
#TWILIO_FROM_NUMBER=+1234567890

# Example Mailtrap settings for E2E testing (replace with your Mailtrap creds)
#EMAIL_HOST=smtp.mailtrap.io
#EMAIL_PORT=587
#EMAIL_HOST_USER=your_mailtrap_user
#EMAIL_HOST_PASSWORD=your_mailtrap_pass
