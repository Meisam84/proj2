<FaDownload />\n                    دانلود پوستر\n                  </Link>\n                </div>\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Recent Announcements */}\n      {recentAnnouncements.length > 0 && (\n        <section className=\"announcements-section\">\n      <h2 className=\"section-title\">آخرین آفیش‌ها</h2>\n          <div className=\"announcements-grid\">\n            {recentAnnouncements.map(announcement => (\n              <div key={announcement.id} className=\"announcement-card\">\n                <div className=\"card-header\">\n                  <h3 className=\"card-title\">{announcement.title}</h3>\n                  <span className=\"date-badge\">{persianDate.toPersian(announcement.date)}</span>\n                </div>\n                <p className=\"card-description\">{announcement.description}</p>\n                <div className=\"card-details\">\n                  <div className=\"detail-item\">\n                    <span className=\"detail-label\">زمان:</span>\n                    <span className=\"detail-value\">{announcement.time}</span>\n                  </div>\n                  <div className=\"detail-item\">\n                    <span className=\"detail-label\">مکان:</span>\n                    <span className=\"detail-value\">{announcement.venue}</span>\n                  </div>\n                </div>\n                <div className=\"card-actions\">\n                  <Link to={`/poster/${announcement.id}`} className=\"btn btn-outline\">\n                    <FaDownload />\n                    مشاهده پوستر\n                  </Link>\n                </div>\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Empty State */}\n      {announcements.length === 0 && (\n        <section className=\"empty-section\">\n          <div className=\"empty-content\">\n            <FaTheaterMasks className=\"empty-icon\" />\n      <h3>هنوز آ