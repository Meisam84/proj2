oading] = useState(true);\n\n  const token = localStorage.getItem('token');\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\n\n  useEffect(() => { fetchRoles(); }, []);\n\n  const fetchRoles = async () => {\n    try {\n      const res = await axios.get('/api/roles');\n      setRoles(res.data);\n    } catch (e) {\n      toast.error('خطا در دریافت نقش‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const addRole = async () => {\n    if (!code.trim() || !name.trim()) {\n      toast.error('کد و نام نقش الزامی است');\n      return;\n    }\n    const rankValue = typeof rank === 'number' ? rank : 999;\n    try {\n      await axios.post('/api/roles', { code, name, rank: rankValue }, { headers: authHeaders });\n      toast.success('نقش با موفقیت ثبت شد');\n      setCode('');\n      setName('');\n      setRank('');\n      fetchRoles();\n    } catch (e) {\n      toast.error('ثبت نقش با خطا مواجه شد');\n    }\n  };\n\n  const deleteRole = async (id: number) => {\n    if (!window.confirm('از حذف نقش مطمئن هستید؟')) return;\n    try {\n      await axios.delete(`/api/roles/${id}`, { headers: authHeaders });\n      toast.success('نقش حذف شد');\n      fetchRoles();\n    } catch (e) {\n      toast.error('حذف نقش با خطا مواجه شد');\n    }\n  };\n\n  if (loading) {\n    return <div className=\"loading-container\"><div className=\"loading-spinner\"></div><p>در حال بارگذاری...</p></div>;\n  }\n\n  return (\n    <div className=\"page-container\">\n      <div className=\"page-header\">\n        <h1>مدیریت نقش‌ها</h1>\n      </div>\n\n      <div className=\"form-card\">\n        <div className=\"form-row\">\n          <label>کد نقش</label>\n          <input value={code} onChange={(e) => setCode(e.target.value)} placeholder=\"مثلاً cameraman\" />\n        </div>\n      <div className=\"form-row\">\n        <label>نام نقش</label>\n        <input value={name} onChange={(e) => setName(e.target.value)} placeholder=\"مثلاً تصویربردار\" />\n      </div>\n      <div className=\"form-row\">\n        <label>رتبه (سلسله‌مراتبی)</label>\n        <input type=\"number\" value={rank} onChange={(e) => setRank(e.target.value ? Number(e.target.value) : '')} placeholder=\"مثلاً 1 برای تهیه‌کننده\" />\n        <small className=\"muted\">عدد کوچکتر یعنی جایگاه بالاتر؛ اگر ندهید 999 در نظر گرفته می‌شود.</small>\n      </div>\n      <button className=\"btn btn-success\" onClick={addRole}><FaPlus /> افزودن نقش</button>\n    </div>\n\n      <div className=\"list-card\">\n        {roles.length === 0 ? (\n          <p>نقشی ثبت نشده است.</p>\n        ) : (\n          <table className=\"data-table\">\n          <thead>\n            <tr>\n              <th>کد</th>\n              <th>نام</th>\n              <th>رتبه</th>\n              <th>عملیات</th>\n            </tr>\n          </thead>\n          <tbody>\n            {roles.map((r) => (\n              <tr key={r.id}>\n                <td>{r.code}</td>\n                <td>{r.name}</td>\n                <td>{r.rank ?? 999}</td>\n                <td>\n                  <button className=\"action-btn delete\" onClick={() => deleteRole(r.id)} title=\"حذف\"><FaTrash /></button>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n          </table>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Roles;","import React, { useEffect, useMemo, useState } from 'react';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport { Link } from 'react-router-dom';\n\nconst toPersianDigits = (str: string | number) => {\n  const s = String(str);\n  const d = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\n  return s.replace(/[0-9]/g, (w) => d[+w]);\n};\n\nconst Estimates: React.FC = () => {\n  const [estimates, setEstimates] = useState<any[]>([]);\n  const [programs, setPrograms] = useState<any[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [programId, setProgramId] = useState<string>('');\n  const token = localStorage.getItem('token');\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\n\n  useEffect(() => {\n    fetchPrograms();\n  }, []);\n\n  useEffect(() => {\n    fetchEstimates();\n  }, [programId]);\n\n  const fetchPrograms = async () => {\n    try {\n      const res = await axios.get('/api/programs');\n      setPrograms(res.data);\n    } catch {\n      toast.error('خطا در دریافت برنامه‌ها');\n    }\n  };\n\n  const fetchEstimates = async () => {\n    setLoading(true);\n    try {\n      const url = programId ? `/api/estimates?program_id=${programId}` : '/api/estimates';\n      const res = await axios.get(url);\n      setEstimates(res.data);\n    } catch {\n      toast.error('خطا در دریافت برآوردها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const deleteEstimate = async (id: number) => {\n    if (!window.confirm('از حذف برآورد مطمئن هستید؟')) return;\n    try {\n      await axios.delete(`/api/estimates/${id}`, { headers: authHeaders });\n      toast.success('برآورد حذف شد');\n      fetchEstimates();\n    } catch {\n      toast.error('حذف برآورد با خطا مواجه شد');\n    }\n  };\n\n  return (\n    <div className=\"page-container\">\n      <div className=\"page-header\">\n        <h1>برآوردهای برنامه‌ها</h1>\n        <Link to=\"/estimates/new\" className=\"btn btn-primary\">ثبت برآورد جدید</Link>\n      </div>\n\n      <div className=\"filters\">\n        <div className=\"form-row\">\n          <label>برنامه</label>\n          <select value={programId} onChange={(e) => setProgramId(e.target.value)}>\n            <option value=\"\">همه</option>\n            {programs.map((p) => (\n              <option key={p.id} value={p.id}>{p.name}</option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {loading ? (\n        <div className=\"loading-container\"><div className=\"loading-spinner\"></div><p>در حال بارگذاری...</p></div>\n      ) : (\n        <div className=\"list-card\">\n          {estimates.length === 0 ? (\n            <p>برآوردی یافت نشد.</p>\n          ) : (\n            <table className=\"data-table\">\n              <thead>\n                <tr>\n                  <th>کد برآورد</th>\n                  <th>برنامه</th>\n                  <th>مدت (دقیقه)</th>\n                  <th>تعداد برنامه</th>\n                  <th>نرخ هر دقیقه</th>\n                  <th>مبلغ کل</th>\n                  <th>تاریخ ثبت</th>\n                  <th>انقضا</th>\n                  <th>عملیات</th>\n                </tr>\n              </thead>\n              <tbody>\n                {estimates.map((e) => {\n                  const totalMinutes = (e.program_count || 0) * (e.duration_minutes || 0);\n                  const totalAmount = totalMinutes * (e.minute_rate || 0);\n                  const prog = programs.find((p) => p.id === e.program_id);\n                  return (\n                    <tr key={e.id}>\n                      <td>{e.estimate_code}</td>\n                      <td>{prog ? prog.name : '—'}</td>\n                      <td>{toPersianDigits(e.duration_minutes)}</td>\n                      <td>{toPersianDigits(e.program_count)}</td>\n                      <td>{toPersianDigits(e.minute_rate)}</td>\n                      <td>{toPersianDigits(totalAmount)}</td>\n                      <td>{e.created_at?.slice(0, 10) || '—'}</td>\n                      <td>{e.expiration_date?.slice(0, 10) || '—'}</td>\n                      <td>\n                        <Link to={`/estimates/${e.id}`} className=\"action-btn\">جزئیات</Link>\n                        <button className=\"action-btn delete\" onClick={() => deleteEstimate(e.id)}>حذف</button>\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Estimates;","import React, { useEffect, useMemo, useState } from 'react';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport { useNavigate } from 'react-router-dom';\nimport DatePicker from 'react-multi-date-picker';\nimport persian from 'react-date-object/calendars/persian';\nimport persian_fa from 'react-date-object/locales/persian_fa';\n\nconst toPersianDigits = (str: string | number) => {\n  const s = String(str);\n  const d = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\n  return s.replace(/[0-9]/g, (w) => d[+w]);\n};\n\nconst CreateEstimate: React.FC = () => {\n  const [programs, setPrograms] = useState<any[]>([]);\n  const [roles, setRoles] = useState<any[]>([]);\n\n  const [form, setForm] = useState<any>({\n    program_id: '',\n    estimate_code: '',\n    duration_minutes: '',\n    program_count: '',\n    minute_rate: '',\n    expiration_date: '',\n    linked_to_estimate_id: '',\n    hospitality_cost: '',\n    transport_cost: '',\n    misc_cost: '',\n    description: ''\n  });\n\n  const [roleWageDraft, setRoleWageDraft] = useState<any>({\n    role_id: '',\n    role_name: '',\n    role_code: '',\n    wage_amount: '',\n    wage_percent: ''\n  });\n\n  const [createdEstimateId, setCreatedEstimateId] = useState<number | null>(null);\n  const navigate = useNavigate();\n\n  const token = localStorage.getItem('token');\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\n\n  useEffect(() => { fetchPrograms(); fetchRoles(); }, []);\n\n  const fetchPrograms = async () => {\n    try { const res = await axios.get('/api/programs'); setPrograms(res.data); }\n    catch { toast.error('خطا در دریافت برنامه‌ها'); }\n  };\n\n  const fetchRoles = async () => {\n    try { const res = await axios.get('/api/roles'); setRoles(res.data); }\n    catch { toast.error('خطا در دریافت نقش‌ها'); }\n  };\n\n  const onChange = (key: string, value: any) => setForm((f: any) => ({ ...f, [key]: value }));\n\n  const submitEstimate = async () => {\n    const required = ['program_id','estimate_code','duration_minutes','program_count','minute_rate'];\n    for (const k of required) {\n      if (!String(form[k] || '').trim()) { toast.error('فیلدهای اصلی را کامل کنید'); return; }\n    }\n    try {\n      const payload = {\n        program_id: Number(form.program_id),\n        estimate_code: form.estimate_code.trim(),\n        duration_minutes: Number(form.duration_minutes),\n        program_count: Number(form.program_count),\n        minute_rate: Number(form.minute_rate),\n        expiration_date: form.expiration_date || null,\n        linked_to_estimate_id: form.linked_to_estimate_id ? Number(form.linked_to_estimate_id) : null,\n        hospitality_cost: form.hospitality_cost ? Number(form.hospitality_cost) : 0,\n        transport_cost: form.transport_cost ? Number(form.transport_cost) : 0,\n        misc_cost: form.misc_cost ? Number(form.misc_cost) : 0,\n        description: form.description || ''\n      };\n      const res = await axios.post('/api/estimates', payload, { headers: authHeaders });\n      setCreatedEstimateId(res.data.id);\n      toast.success('برآورد ثبت شد، حالا دستمزد نقش‌ها را اضافه کنید');\n    } catch {\n      toast.error('ثبت برآورد با خطا مواجه شد');\n    }\n  };\n\n  const addRoleWage = async () => {\n    if (!createdEstimateId) { toast.error('ابتدا برآورد را ثبت کنید'); return; }\n    const payload: any = {\n      role_id: roleWageDraft.role_id ? Number(roleWageDraft.role_id) : null,\n      role_code: roleWageDraft.role_code || null,\n      role_name: roleWageDraft.role_name || null,\n      wage_amount: roleWageDraft.wage_amount ? Number(roleWageDraft.wage_amount) : null,\n      wage_percent: roleWageDraft.wage_percent ? Number(roleWageDraft.wage_percent) : null\n    };\n    if (!payload.role_id && !payload.role_code && !payload.role_name) {\n      toast.error('حداقل یکی از نقش یا نام/کد نقش را وارد کنید');\n      return;\n    }\n    try {\n      await axios.post(`/api/estimates/${createdEstimateId}/roles`, payload, { headers: authHeaders });\n      toast.success('دستمزد نقش اضافه شد');\n      setRoleWageDraft({ role_id: '', role_name: '', role_code: '', wage_amount: '', wage_percent: '' });\n    } catch {\n      toast.error('ثبت دستمزد نقش با خطا مواجه شد');\n    }\n  };\n\n  const totalMinutes = useMemo(() => {\n    const d = Number(form.duration_minutes || 0); const c = Number(form.program_count || 0);\n    return d * c;\n  }, [form.duration_minutes, form.program_count]);\n\n  const totalAmount = useMemo(() => {\n    const r = Number(form.minute_rate || 0); return r * totalMinutes;\n  }, [form.minute_rate, totalMinutes]);\n\n  return (\n    <div className=\"page-container\">\n      <div className=\"page-header\">\n        <h1>ثبت برآورد جدید</h1>\n        <button className=\"btn\" onClick={() => navigate('/estimates')}>بازگشت</button>\n      </div>\n\n      <div className=\"form-card\">\n        <div className=\"form-row\">\n          <label>برنامه</label>\n          <select value={form.program_id} onChange={(e) => onChange('program_id', e.target.value)}>\n            <option value=\"\">انتخاب کنید</option>\n            {programs.map((p) => (\n              <option key={p.id} value={p.id}>{p.name}</option>\n            ))}\n          </select>\n        </div>\n\n        <div className=\"form-row\">\n          <label>کد برآورد یکتا</label>\n          <input value={form.estimate_code} onChange={(e) => onChange('estimate_code', e.target.value)} placeholder=\"مثلاً EST-1403-001\" />\n        </div>\n\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>مدت هر برنامه (دقیقه)</label>\n            <input type=\"number\" value={form.duration_minutes} onChange={(e) => onChange('duration_minutes', e.target.value)} />\n          </div>\n          <div className=\"form-row\">\n            <label>تعداد برنامه</label>\n            <input type=\"number\" value={form.program_count} onChange={(e) => onChange('program_count', e.target.value)} />\n          </div>\n          <div className=\"form-row\">\n            <label>نرخ هر دقیقه (تومان)</label>\n            <input type=\"number\" value={form.minute_rate} onChange={(e) => onChange('minute_rate', e.target.value)} />\n          </div>\n        </div>\n\n        <div className=\"hint-row\">\n          <span>دقیقه کل: {toPersianDigits(totalMinutes)}</span>\n          <span>مبلغ کل: {toPersianDigits(totalAmount)}</span>\n        </div>\n\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>تاریخ انقضا (شمسی)</label>\n            <DatePicker\n              calendar={persian}\n              locale={persian_fa}\n              value={form.expiration_date ? new Date(form.expiration_date) : undefined}\n              format=\"YYYY-MM-DD\"\n              onChange={(date: any) => {\n                try {\n                  const str = Array.isArray(date) ? '' : date?.format?.('YYYY-MM-DD') || '';\n                  onChange('expiration_date', str);\n                } catch {\n                  onChange('expiration_date', '');\n                }\n              }}\n              inputClass=\"date-input\"\n            />\n          </div>\n          <div className=\"form-row\">\n            <label>برآورد پیوست (اختیاری)</label>\n            <input value={form.linked_to_estimate_id} onChange={(e) => onChange('linked_to_estimate_id', e.target.value)} placeholder=\"شناسه برآورد قبلی\" />\n          </div>\n        </div>\n\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>پذیرایی</label>\n            <input type=\"number\" value={form.hospitality_cost} onChange={(e) => onChange('hospitality_cost', e.target.value)} />\n          </div>\n          <div className=\"form-row\">\n            <label>ایاب و ذهاب</label>\n            <input type=\"number\" value={form.transport_cost} onChange={(e) => onChange('transport_cost', e.target.value)} />\n          </div>\n          <div className=\"form-row\">\n            <label>هزینه‌های متفرقه</label>\n            <input type=\"number\" value={form.misc_cost} onChange={(e) => onChange('misc_cost', e.target.value)} />\n          </div>\n        </div>\n\n        <div className=\"form-row\">\n          <label>توضیحات</label>\n          <textarea value={form.description} onChange={(e) => onChange('description', e.target.value)} />\n        </div>\n\n        <button className=\"btn btn-success\" onClick={submitEstimate}>ثبت برآورد</button>\n      </div>\n\n      <div className=\"form-card\">\n        <h2>تعریف دستمزد نقش‌ها</h2>\n        {!createdEstimateId && <p className=\"muted\">برای اضافه کردن نقش‌ها، ابتدا برآورد را ثبت کنید.</p>}\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>انتخاب از لیست نقش‌ها</label>\n            <small className=\"muted\">مرتب بر اساس رتبه (عدد کوچکتر یعنی جایگاه بالاتر)</small>\n            <select value={roleWageDraft.role_id} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, role_id: e.target.value }))}>\n              <option value=\"\">—</option>\n              {roles.map((r) => <option key={r.id} value={r.id}>{r.name} ({r.code} • رتبه {r.rank ?? 999})</option>)}\n            </select>\n          </div>\n          <div className=\"form-row\">\n            <label>یا کد نقش</label>\n            <input value={roleWageDraft.role_code} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, role_code: e.target.value }))} placeholder=\"مثلاً soundman\" />\n          </div>\n          <div className=\"form-row\">\n            <label>نام نقش</label>\n            <input value={roleWageDraft.role_name} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, role_name: e.target.value }))} placeholder=\"مثلاً صدابردار\" />\n          </div>\n        </div>\n\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>حق‌الزحمه عددی (تومان)</label>\n            <input type=\"number\" value={roleWageDraft.wage_amount} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, wage_amount: e.target.value }))} />\n          </div>\n          <div className=\"form-row\">\n            <label>حق‌الزحمه درصدی (%)</label>\n            <input type=\"number\" value={roleWageDraft.wage_percent} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, wage_percent: e.target.value }))} />\n          </div>\n        </div>\n\n        <button className=\"btn\" onClick={addRoleWage}>افزودن دستمزد نقش</button>\n      </div>\n    </div>\n  );\n};\n\nexport default CreateEstimate;","import React, { useEffect, useState } from 'react';\r\nimport axios from 'axios';\r\nimport { useParams, useNavigate } from 'react-router-dom';\r\nimport { toast } from '../libs/toast';\r\n\r\nconst toPersianDigits = (str: string | number) => {\r\n  const s = String(str);\r\n  const d = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\r\n  return s.replace(/[0-9]/g, (w) => d[+w]);\r\n};\r\n\r\nconst EstimateDetail: React.FC = () => {\r\n  const { id } = useParams();\r\n  const [estimate, setEstimate] = useState<any>(null);\r\n  const [roles, setRoles] = useState<any[]>([]);\r\n  const [savingRoleId, setSavingRoleId] = useState<number | null>(null);\r\n  const [programs, setPrograms] = useState<any[]>([]);\r\n  const navigate = useNavigate();\r\n\r\n  useEffect(() => { fetchPrograms(); }, []);\r\n  useEffect(() => { if (id) fetchEstimate(); }, [id]);\r\n\r\n  const fetchPrograms = async () => {\r\n    try { const res = await axios.get('/api/programs'); setPrograms(res.data); }\r\n    catch { /* ignore */ }\r\n  };\r\n\r\n  const fetchEstimate = async () => {\r\n    try {\r\n      const res = await axios.get(`/api/estimates/${id}`);\r\n      setEstimate(res.data.estimate);\r\n      setRoles(res.data.roles || []);\r\n    } catch {\r\n      toast.error('دریافت جزئیات برآورد با خطا مواجه شد');\r\n    }\r\n  };\r\n\r\n  const token = localStorage.getItem('token');\r\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\r\n\r\n  const updateRoleWage = async (row: any) => {\r\n    if (!id) return;\r\n    setSavingRoleId(row.id);\r\n    const payload: any = {\r\n      role_id: row.role_id || null,\r\n      role_code: row.role_code || null,\r\n      role_name: row.role_name || null,\r\n      wage_amount: row.wage_amount || null,\r\n      wage_percent: row.wage_percent || null,\r\n    };\r\n    try {\r\n      await axios.post(`/api/estimates/${id}/roles`, payload, { headers: authHeaders });\r\n      toast.success('دستمزد نقش به‌روزرسانی شد');\r\n    } catch {\r\n      toast.error('به‌روزرسانی دستمزد با خطا مواجه شد');\r\n    } finally {\r\n      setSavingRoleId(null);\r\n    }\r\n  };\r\n\r\n  if (!estimate) {\r\n    return <div className=\"loading-container\"><div className=\"loading-spinner\"></div><p>در حال بارگذاری...</p></div>;\r\n  }\r\n\r\n  const prog = programs.find((p) => p.id === estimate.program_id);\r\n  const totalMinutes = (estimate.program_count || 0) * (estimate.duration_minutes || 0);\r\n  const totalAmount = totalMinutes * (estimate.minute_rate || 0);\r\n\r\n  return (\r\n    <div className=\"page-container\">\r\n      <div className=\"page-header\">\r\n        <h1>جزئیات برآورد {estimate.estimate_code}</h1>\r\n        <button className=\"btn\" onClick={() => navigate('/estimates')}>بازگشت</button>\r\n      </div>\r\n\r\n      <div className=\"form-card\">\r\n        <div className=\"info-grid\">\r\n          <div><strong>برنامه:</strong> {prog ? prog.name : '—'}</div>\r\n          <div><strong>مدت هر برنامه:</strong> {toPersianDigits(estimate.duration_minutes)} دقیقه</div>\r\n          <div><strong>تعداد برنامه:</strong> {toPersianDigits(estimate.program_count)}</div>\r\n          <div><strong>نرخ هر دقیقه:</strong> {toPersianDigits(estimate.minute_rate)} تومان</div>\r\n          <div><strong>دقیقه کل:</strong> {toPersianDigits(totalMinutes)}</div>\r\n          <div><strong>مبلغ کل:</strong> {toPersianDigits(totalAmount)}</div>\r\n          <div><strong>پذیرایی:</strong> {toPersianDigits(estimate.hospitality_cost || 0)}</div>\r\n          <div><strong>ایاب و ذهاب:</strong> {toPersianDigits(estimate.transport_cost || 0)}</div>\r\n          <div><strong>متفرقه:</strong> {toPersianDigits(estimate.misc_cost || 0)}</div>\r\n          <div><strong>تاریخ ثبت:</strong> {estimate.created_at?.slice(0, 10) || '—'}</div>\r\n          <div><strong>انقضا:</strong> {estimate.expiration_date?.slice(0, 10) || '—'}</div>\r\n        </div>\r\n        {estimate.linked_to_estimate_id && (\r\n          <div className=\"hint-row\">پیوست به برآورد: {estimate.linked_to_estimate_id}</div>\r\n        )}\r\n      </div>\r\n\r\n      <div className=\"list-card\">\r\n        <h2>نقش‌ها و دستمزدها</h2>\r\n        {roles.length === 0 ? (\r\n          <p>نقشی برای این برآورد ثبت نشده است.</p>\r\n        ) : (\r\n          <table className=\"data-table\">\r\n            <thead>\r\n              <tr>\r\n                <th>نقش</th>\r\n                <th>کد نقش</th>\r\n                <th>دستمزد عددی</th>\r\n                <th>دستمزد درصدی</th>\r\n                <th>شناسه نقش</th>\r\n                <th>ذخیره</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              {roles.map((r) => (\r\n                <tr key={r.id}>\r\n                  <td>{r.role_name || '—'}</td>\r\n                  <td>{r.role_code || '—'}</td>\r\n                  <td>\r\n                    <input\r\n                      type=\"number\"\r\n                      value={r.wage_amount || ''}\r\n                      onChange={(e) => setRoles((rows) => rows.map((rw) => rw.id === r.id ? { ...rw, wage_amount: e.target.value ? Number(e.target.value) : null } : rw))}\r\n                      style={{ width: 120 }}\r\n                    />\r\n                  </td>\r\n                  <td>\r\n                    <input\r\n                      type=\"number\"\r\n                      value={r.wage_percent || ''}\r\n                      onChange={(e) => setRoles((rows) => rows.map((rw) => rw.id === r.id ? { ...rw, wage_percent: e.target.value ? Number(e.target.value) : null } : rw))}\r\n                      style={{ width: 80 }}\r\n                    />\r\n                  </td>\r\n                  <td>{r.role_id || '—'}</td>\r\n                  <td>\r\n                    <button className=\"btn\" onClick={() => updateRoleWage(r)} disabled={savingRoleId === r.id}>\r\n                      {savingRoleId === r.id ? 'در حال ذخیره…' : 'ذخیره'}\r\n                    </button>\r\n                  </td>\r\n                </tr>\r\n              ))}\r\n            </tbody>\r\n          </table>\r\n        )}\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default EstimateDetail;","import React, { useState } from 'react';\nimport { toast } from '../libs/toast';\nimport * as XLSX from 'xlsx';\nimport axios from 'axios';\nimport './BulkUpload.css';\n\nconst BulkUpload: React.FC = () => {\n  const [file, setFile] = useState<File | null>(null);\n  const [previewRows, setPreviewRows] = useState<any[]>([]);\n  const [target, setTarget] = useState<'actors' | 'roles'>('actors');\n  const [mapping, setMapping] = useState<any>({});\n  const [loading, setLoading] = useState(false);\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const f = e.target.files?.[0] || null;\n    setFile(f);\n    setPreviewRows([]);\n    setMapping({});\n    if (f) parseFile(f);\n  };\n\n  const parseFile = async (f: File) => {\n    try {\n      const buf = await f.arrayBuffer();\n      const wb = XLSX.read(buf, { type: 'array' });\n      const ws = wb.Sheets[wb.SheetNames[0]];\n      const rows = XLSX.utils.sheet_to_json(ws, { defval: '' });\n      setPreviewRows(rows.slice(0, 20));\n      // Auto map headers by heuristic\n      const headers = Object.keys(rows[0] || {});\n      const lower = (s: string) => s.toLowerCase();\n      const guess: any = {};\n      if (target === 'actors') {\n        guess.name = headers.find(h => /name|نام/.test(lower(h))) || headers[0];\n        guess.role = headers.find(h => /role|نقش/.test(lower(h))) || headers[1] || headers[0];\n        guess.phone = headers.find(h => /phone|تلفن|موبایل/.test(lower(h)));\n        guess.email = headers.find(h => /email|ایمیل/.test(lower(h)));\n        guess.bio = headers.find(h => /bio|زندگی/.test(lower(h)));\n        guess.photo = headers.find(h => /photo|عکس/.test(lower(h)));\n      } else {\n        guess.code = headers.find(h => /code|کد/.test(lower(h))) || headers[0];\n        guess.name = headers.find(h => /name|نام/.test(lower(h))) || headers[1] || headers[0];\n      }\n      setMapping(guess);\n    } catch (e) {\n      toast.error('خطا در خواندن فایل اکسل');\n    }\n  };\n\n  const buildItems = (): any[] => {\n    return previewRows.map((row: any) => {\n      if (target === 'actors') {\n        return {\n          name: row[mapping.name] || '',\n          role: row[mapping.role] || '',\n          phone: mapping.phone ? row[mapping.phone] : undefined,\n          email: mapping.email ? row[mapping.email] : undefined,\n          bio: mapping.bio ? row[mapping.bio] : undefined,\n          photo: mapping.photo ? row[mapping.photo] : undefined,\n        };\n      } else {\n        return {\n          code: row[mapping.code] || '',\n          name: row[mapping.name] || '',\n        };\n      }\n    }).filter(it => (target === 'actors' ? it.name && it.role : it.code && it.name));\n  };\n\n  const handleImport = async () => {\n    const items = buildItems();\n    if (items.length === 0) {\n      toast.error('هیچ رکورد معتبری برای واردسازی یافت نشد');\n      return;\n    }\n    setLoading(true);\n    try {\n      const token = localStorage.getItem('token');\n      const url = target === 'actors' ? '/api/actors/bulk' : '/api/roles/bulk';\n      const res = await axios.post(url, { items }, {\n        headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n      });\n      toast.success(`واردسازی ${res.data.count} رکورد با موفقیت انجام شد`);\n    } catch (e) {\n      toast.error('خطا در واردسازی داده‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"bulk-container\">\n      <div className=\"bulk-header\">\n        <h1>واردسازی اکسل</h1>\n      <p>فایل اکسل عوامل یا نقش‌ها را آپلود و ثبت دسته‌ای انجام دهید.</p>\n      </div>\n\n      <div className=\"bulk-controls\">\n        <div className=\"target-switch\">\n          <label>\n            <input type=\"radio\" checked={target==='actors'} onChange={()=>setTarget('actors')} /> عوامل\n          </label>\n          <label>\n            <input type=\"radio\" checked={target==='roles'} onChange={()=>setTarget('roles')} /> نقش‌ها\n          </label>\n        </div>\n        <input type=\"file\" accept=\".xlsx,.xls\" onChange={handleFileChange} />\n      </div>\n\n      {previewRows.length > 0 && (\n        <div className=\"bulk-preview\">\n          <h3>پیش‌نمایش و نگاشت ستون‌ها</h3>\n          <div className=\"mapping\">\n            {target === 'actors' ? (\n              <>\n                <FieldMap label=\"نام\" value={mapping.name} onChange={(v)=>setMapping({...mapping,name:v})} headers={Object.keys(previewRows[0]||{})} />\n                <FieldMap label=\"نقش\" value={mapping.role} onChange={(v)=>setMapping({...mapping,role:v})} headers={Object.keys(previewRows[0]||{})} />\n                <FieldMap label=\"تلفن\" value={mapping.phone} onChange={(v)=>setMapping({...mapping,phone:v})} headers={Object.keys(previewRows[0]||{})} optional />\n                <FieldMap label=\"ایمیل\" value={mapping.email} onChange={(v)=>setMapping({...mapping,email:v})} headers={Object.keys(previewRows[0]||{})} optional />\n                <FieldMap label=\"بیو\" value={mapping.bio} onChange={(v)=>setMapping({...mapping,bio:v})} headers={Object.keys(previewRows[0]||{})} optional />\n                <FieldMap label=\"عکس\" value={mapping.photo} onChange={(v)=>setMapping({...mapping,photo:v})} headers={Object.keys(previewRows[0]||{})} optional />\n              </>\n            ) : (\n              <>\n                <FieldMap label=\"کد\" value={mapping.code} onChange={(v)=>setMapping({...mapping,code:v})} headers={Object.keys(previewRows[0]||{})} />\n                <FieldMap label=\"نام\" value={mapping.name} onChange={(v)=>setMapping({...mapping,name:v})} headers={Object.keys(previewRows[0]||{})} />\n              </>\n            )}\n          </div>\n\n          <table className=\"preview-table\">\n            <thead>\n              <tr>\n                {Object.keys(previewRows[0]).map((h) => (<th key={h}>{h}</th>))}\n              </tr>\n            </thead>\n            <tbody>\n              {previewRows.map((row, idx) => (\n                <tr key={idx}>\n                  {Object.keys(previewRows[0]).map((h) => (<td key={h}>{row[h]}</td>))}\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      <div className=\"bulk-actions\">\n        <button className=\"import-btn\" disabled={!file || loading} onClick={handleImport}>\n          {loading ? 'در حال واردسازی...' : 'واردسازی'}\n        </button>\n      </div>\n    </div>\n  );\n};\n\nconst FieldMap: React.FC<{ label: string; value?: string; headers: string[]; onChange: (v: string)=>void; optional?: boolean }>\n  = ({ label, value, headers, onChange, optional }) => {\n  return (\n    <div className=\"field-map\">\n      <span className=\"label\">{label}{optional ? ' (اختیاری)' : ''}</span>\n      <select value={value || ''} onChange={(e)=>onChange(e.target.value)}>\n        <option value=\"\">— انتخاب ستون —</option>\n        {headers.map((h) => (<option key={h} value={h}>{h}</option>))}\n      </select>\n    </div>\n  );\n};\n\nexport default BulkUpload;","import React from 'react';\nimport { BrowserRouter as Router, Routes, Route } from 'react-router-dom';\nimport { ToastContainer } from './libs/toast';\n\n// Context\nimport { AuthProvider } from './contexts/AuthContext';\n\n// Components\nimport Layout from './components/Layout/Layout';\nimport ProtectedRoute from './components/Auth/ProtectedRoute';\n\n// Pages\nimport Home from './pages/Home';\nimport Dashboard from './pages/Dashboard';\nimport Login from './pages/Login';\nimport Announcements from './pages/Announcements';\nimport CreateAnnouncement from './pages/CreateAnnouncement';\nimport AnnouncementDetail from './pages/AnnouncementDetail';\nimport Actors from './pages/Actors';\nimport Programs from './pages/Programs';\nimport CreateActor from './pages/CreateActor';\nimport CreateProgram from './pages/CreateProgram';\nimport DisplayPage from './pages/DisplayPage';\nimport PosterView from './pages/PosterView';\nimport Roles from './pages/Roles';\nimport Estimates from './pages/Estimates';\nimport CreateEstimate from './pages/CreateEstimate';\nimport EstimateDetail from './pages/EstimateDetail';\nimport BulkUpload from './pages/BulkUpload';\n\n// Styles\nimport './App.css';\n\nfunction App() {\n  return (\n    <AuthProvider>\n      <Router>\n        <div className=\"App\">\n          <Routes>\n            {/* Public Routes */}\n            <Route path=\"/login\" element={<Login />} />\n            <Route path=\"/display\" element={<DisplayPage />} />\n            <Route path=\"/poster/:id\" element={<PosterView />} />\n\n            {/* Main Layout Routes */}\n            <Route path=\"/\" element={<Layout />}>\n              <Route index element={<Home />} />\n\n              {/* Protected Admin Routes */}\n              <Route path=\"/dashboard\" element={\n                <ProtectedRoute>\n                  <Dashboard />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/announcements\" element={\n                <ProtectedRoute>\n                  <Announcements />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/announcements/create\" element={\n                <ProtectedRoute>\n                  <CreateAnnouncement />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/announcements/new\" element={\n                <ProtectedRoute>\n                  <CreateAnnouncement />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/announcements/:id\" element={\n                <ProtectedRoute>\n                  <AnnouncementDetail />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/announcements/edit/:id\" element={\n                <ProtectedRoute>\n                  <CreateAnnouncement />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/announcements/:id/edit\" element={\n                <ProtectedRoute>\n                  <CreateAnnouncement />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/actors\" element={\n                <ProtectedRoute>\n                  <Actors />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/actors/new\" element={\n                <ProtectedRoute>\n                  <CreateActor />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/programs\" element={\n                <ProtectedRoute>\n                  <Programs />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/programs/new\" element={\n                <ProtectedRoute>\n                  <CreateProgram />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/roles\" element={\n                <ProtectedRoute>\n                  <Roles />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/bulk-upload\" element={\n                <ProtectedRoute>\n                  <BulkUpload />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/estimates\" element={\n                <ProtectedRoute>\n                  <Estimates />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/estimates/new\" element={\n                <ProtectedRoute>\n                  <CreateEstimate />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/estimates/:id\" element={\n                <ProtectedRoute>\n                  <EstimateDetail />\n                </ProtectedRoute>\n              } />\n            </Route>\n          </Routes>\n\n          <ToastContainer\n            position=\"top-left\"\n            autoClose={5000}\n            hideProgressBar={false}\n            newestOnTop={false}\n            closeOnClick\n            rtl={true}\n            pauseOnFocusLoss\n            draggable\n            pauseOnHover\n            theme=\"light\"\n          />\n        </div>\n      </Router>\n    </AuthProvider>\n  );\n}\n\nexport default App;\n","import React from 'react';\nimport ReactDOM from 'react-dom/client';\nimport App from './App';\n\n// Suppress noisy React warning from react-toastify about defaultProps in function components\n// This does not affect functionality; it only hides the console warning.\nconst originalConsoleError = console.error;\nconsole.error = (...args) => {\n  if (typeof args[0] === 'string' && args[0].includes('Support for defaultProps will be removed from function components')) {\n    return;\n  }\n  originalConsoleError(...args);\n};\n\nconst root = ReactDOM.createRoot(document.getElementById('root'));\nroot.render(\n  <React.StrictMode>\n    <App />\n  </React.StrictMode>\n);"]}}