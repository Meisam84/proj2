Error downloading poster:', error);\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"poster-view-loading\">\n        <div className=\"spinner\"></div>\n        <p>در حال بارگیری...</p>\n      </div>\n    );\n  }\n\n  if (!announcement) {\n    return (\n      <div className=\"poster-view-error\">\n        <p>آفیش مورد نظر یافت نشد</p>\n        <button onClick={() => navigate('/')} className=\"btn btn-primary\">\n          بازگشت به خانه\n        </button>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"poster-view-container\">\n      <div className=\"print-logo\" aria-hidden=\"true\">\n        <Logo src=\"/logo.png.jpg\" height={144} width={144} alt=\"لوگو\" />\n      </div>\n      <div className=\"poster-actions\">\n        <button onClick={() => navigate(-1)} className=\"btn btn-secondary\">\n          بازگشت\n        </button>\n        <div className=\"action-buttons\">\n          <button onClick={handlePrint} className=\"btn btn-print\">\n            چاپ\n          </button>\n          <button onClick={handleDownload} className=\"btn btn-download\">\n            دانلود\n          </button>\n        </div>\n      </div>\n\n      <div id=\"poster-content\" className=\"poster-content\">\n        <div className=\"poster-header\">\n          <h1>{announcement.title}</h1>\n          <div className=\"announcement-meta\">\n            <span className=\"announcement-date\">\n              {new Date(announcement.date).toLocaleDateString('fa-IR')}\n            </span>\n            <span className=\"announcement-time\">\n              ساعت {announcement.time}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"poster-body\">\n          {announcement.poster_image && (\n            <div className=\"poster-image\">\n              <img\n                src={announcement.poster_image.startsWith('http') ? announcement.poster_image : `/uploads/${announcement.poster_image}`}\n                alt={announcement.title}