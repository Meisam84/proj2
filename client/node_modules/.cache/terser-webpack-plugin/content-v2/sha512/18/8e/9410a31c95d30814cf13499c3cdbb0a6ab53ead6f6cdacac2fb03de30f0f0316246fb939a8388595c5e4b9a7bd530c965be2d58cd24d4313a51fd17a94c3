Interval);\n    };\n  }, []);\n\n  const updateCurrentDate = () => {\n    const now = new Date();\n    const persianDate = now.toLocaleDateString('fa-IR', {\n      year: 'numeric',\n      month: 'long',\n      day: 'numeric',\n      weekday: 'long'\n    });\n    setCurrentDate(persianDate);\n  };\n\n  const updateCurrentTime = () => {\n    const now = new Date();\n    const timeStr = now.toLocaleTimeString('fa-IR', {\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit'\n    });\n    setCurrentTime(timeStr);\n  };\n\n  const fetchAnnouncements = async () => {\n    try {\n      const today = new Date().toISOString().split('T')[0];\n      const response = await axios.get(`/api/announcements?date=${today}&status=published`);\n      setAnnouncements(response.data);\n    } catch (error) {\n      toast.error('خطا در دریافت آفیش‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const formatDate = (dateString: string) => {\n    return new Date(dateString).toLocaleDateString('fa-IR');\n  };\n\n  const timeDiffMinutes = (dateStr: string, timeStr: string) => {\n    try {\n      const [h, m] = (timeStr || '00:00').split(':').map(Number);\n      const dt = new Date(dateStr);\n      dt.setHours(h || 0, m || 0, 0, 0);\n      const diffMs = dt.getTime() - now.getTime();\n      return Math.round(diffMs / 60000);\n    } catch { return null; }\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  if (loading) {\n    return (\n      <div className=\"display-loading\">\n        <div className=\"loading-spinner\"></div>\n        <p>در حال بارگذاری آفیش‌ها...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"display-container\">\n      <div className=\"print-logo\" aria-hidden=\"true\">\n        <Logo src=\"/logo.png.jpg\" height={144} width={144} alt=\"لوگو\" />\n      </div>\n      <header className=\"display-header\">\n        <div className=\"header-content\">\n          <h1 className=\"system-title\">سامانه رسا</