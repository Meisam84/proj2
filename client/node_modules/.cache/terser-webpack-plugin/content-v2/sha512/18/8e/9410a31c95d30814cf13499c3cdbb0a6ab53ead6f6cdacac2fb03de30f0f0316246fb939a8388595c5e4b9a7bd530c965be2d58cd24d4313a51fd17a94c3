by mini-css-extract-plugin","// extracted by mini-css-extract-plugin","// extracted by mini-css-extract-plugin","// extracted by mini-css-extract-plugin","/* eslint-disable @typescript-eslint/no-var-requires */\n// Runtime switch between development and production CJS bundles of react-toastify\n// to keep CRA4 compatibility in dev while using optimized bundle in prod.\n\nconst mod =\n  process.env.NODE_ENV === 'production'\n    ? require('react-toastify/dist/react-toastify.cjs.production.min.js')\n    : require('react-toastify/dist/react-toastify.cjs.development.js');\n\nexport const toast = mod.toast;\n// In some versions, ToastContainer may be exported as default; fallback accordingly.\nexport const ToastContainer = mod.ToastContainer || mod.default;\nexport type ToastOptions = import('react-toastify').ToastOptions;","import React, { createContext, useState, useContext, useEffect } from 'react';\nimport axios from 'axios';\n\ninterface Admin {\n  id: number;\n  username: string;\n  fullName: string;\n  role: string;\n}\n\ninterface AuthContextType {\n  admin: Admin | null;\n  login: (username: string, password: string) => Promise<boolean>;\n  logout: () => void;\n  loading: boolean;\n}\n\nconst AuthContext = createContext<AuthContextType | undefined>(undefined);\n\nexport const useAuth = () => {\n  const context = useContext(AuthContext);\n  if (!context) {\n    throw new Error('useAuth must be used within an AuthProvider');\n  }\n  return context;\n};\n\nexport const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [admin, setAdmin] = useState<Admin | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    checkAuthStatus();\n  }, []);\n\n  const checkAuthStatus = async () => {\n    const token = localStorage.getItem('token');\n    if (token) {\n      try {\n        axios.defaults.headers.common.Authorization = `Bearer ${token}`;\n        const response = await axios.post('/api/auth/verify', {});\n        setAdmin(response.data.admin);\n      } catch (error) {\n        localStorage.removeItem('token');\n        delete axios.defaults.headers.common.Authorization;\n      }\n    }\n    setLoading(false);\n  };\n\n  const login = async (username: string, password: string): Promise<boolean> => {\n    try {\n      const response = await axios.post('/api/auth/login', {\n        username,\n        password,\n      });\n\n      const { token, admin: adminData } = response.data;\n      localStorage.setItem('token', token);\n      axios.defaults.headers.common.Authorization = `Bearer ${token}`;\n      setAdmin(adminData);\n      return true;\n    } catch (error) {\n      return false;\n    }\n  };\n\n  const logout = () => {\n    localStorage.removeItem('token');\n    delete axios.defaults.headers.common.Authorization;\n    setAdmin(null);\n  };\n\n  const value = {\n    admin,\n    login,\n    logout,\n    loading,\n  };\n\n  return (\n    <AuthContext.Provider value={value}>\n      {children}\n    </AuthContext.Provider>\n  );\n};","import React, { useEffect, useRef, useState } from 'react';\n\ntype LogoProps = {\n  src?: string;\n  height?: number;\n  width?: number;\n  threshold?: number; // 0-255, higher removes more near-white\n  className?: string;\n  alt?: string;\n};\n\n// Client-side background remover: makes near-white pixels transparent\nexport default function Logo({\n  src = '/logo.png',\n  height = 32,\n  width,\n  threshold = 240,\n  className,\n  alt = 'لوگو',\n}: LogoProps) {\n  const [dataUrl, setDataUrl] = useState<string | null>(null);\n  const [naturalSize, setNaturalSize] = useState<{ w: number; h: number } | null>(null);\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  useEffect(() => {\n    const img = new Image();\n    img.crossOrigin = 'anonymous';\n    img.onload = () => {\n      const w = img.naturalWidth;\n      const h = img.naturalHeight;\n      setNaturalSize({ w, h });\n      const canvas = document.createElement('canvas');\n      canvas.width = w;\n      canvas.height = h;\n      const ctx = canvas.getContext('2d');\n      if (!ctx) return;\n      ctx.drawImage(img, 0, 0);\n      const imageData = ctx.getImageData(0, 0, w, h);\n      const data = imageData.data;\n      for (let i = 0; i < data.length; i += 4) {\n        const r = data[i];\n        const g = data[i + 1];\n        const b = data[i + 2];\n        // If close to white, make transparent\n        if (r >= threshold && g >= threshold && b >= threshold) {\n          data[i + 3] = 0;\n        }\n      }\n      ctx.putImageData(imageData, 0, 0);\n      const url = canvas.toDataURL('image/png');\n      setDataUrl(url);\n      canvasRef.current = canvas;\n    };\n    img.onerror = () => {\n      // Fallback: just use original src\n      setDataUrl(null);\n    };\n    img.src = src;\n  }, [src, threshold]);\n\n  const computedStyle: React.CSSProperties = {\n    height,\n    width,\n    display: 'inline-block',\n    objectFit: 'contain',\n  };\n\n  // If we have a processed data URL, use it; otherwise use raw src\n  const finalSrc = dataUrl ?? src;\n\n  return (\n    <img\n      src={finalSrc}\n      alt={alt}\n      className={className}\n      style={computedStyle}\n      loading=\"eager\"\n    />\n  );\n}\nexport const ThemeToggle: React.FC = () => {\n  const [theme, setTheme] = React.useState<string>(() => localStorage.getItem('theme') || 'light');\n  React.useEffect(() => {\n    document.body.classList.toggle('dark', theme === 'dark');\n    localStorage.setItem('theme', theme);\n  }, [theme]);\n  return (\n    <button onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')} className=\"login-btn\" style={{ marginInlineEnd: 8 }}>\n      {theme === 'dark' ? 'تم روشن' : 'تم تاریک'}\n    </button>\n  );\n};","import React, { useState } from 'react';\nimport { Link, useNavigate } from 'react-router-dom';\nimport { useAuth } from '../../contexts/AuthContext';\nimport { FaBars, FaTimes, FaUser, FaSignOutAlt } from 'react-icons/fa';\nimport './Header.css';\nimport Logo from '../Logo';\n\nconst Header: React.FC = () => {\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\n  const { admin, logout } = useAuth();\n  const navigate = useNavigate();\n\n  const handleLogout = () => {\n    logout();\n    navigate('/login');\n  };\n\n  const toggleMenu = () => {\n    setIsMenuOpen(!isMenuOpen);\n  };\n\n  return (\n    <header className=\"header\">\n      <div className=\"header-container\">\n        <div className=\"header-logo\">\n          <Link to=\"/\">\n            <Logo src=\"/logo.png.jpg\" height={108} width={108} className=\"logo-image\" alt=\"لوگو\" />\n            <span className=\"logo-text\">سامانه رسا</span>\n          </Link>\n        </div>\n\n        <nav className={`header-nav ${isMenuOpen ? 'active' : ''}`}>\n          <ul className=\"nav-list\">\n            <li className=\"nav-item\">\n              <Link to=\"/\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                صفحه اصلی\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/display\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                نمایش برنامه‌ها\n              </Link>\n            </li>\n            {admin && (\n              <>\n                <li className=\"nav-item\">\n                  <Link to=\"/dashboard\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    داشبورد\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/announcements\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    آفیش‌ها\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/actors\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    عوامل\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/programs\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    برنامه‌ها\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/roles\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    نقش‌ها\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/bulk-upload\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    آپلود اکسل\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/estimates\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    برآوردها\n                  </Link>\n                </li>\n              </>\n            )}\n          </ul>\n        </nav>\n\n        <div className=\"header-actions\">\n          <ThemeToggle />\n          {admin ? (\n            <div className=\"user-menu\">\n              <div className=\"user-info\">\n                <FaUser className=\"user-icon\" />\n                <span className=\"user-name\">{admin.fullName}</span>\n              </div>\n              <button className=\"logout-btn\" onClick={handleLogout}>\n                <FaSignOutAlt />\n                <span>خروج</span>\n              </button>\n            </div>\n          ) : (\n            <Link to=\"/login\" className=\"login-btn\">\n              ورود\n            </Link>\n          )}\n        </div>\n\n        <button className=\"menu-toggle\" onClick={toggleMenu}>\n          {isMenuOpen ? <FaTimes /> : <FaBars />}\n        </button>\n      </div>\n    </header>\n  );\n};\n\nexport default Header;","import React from 'react';\nimport { FaEnvelope, FaPhone, FaMapMarkerAlt } from 'react-icons/fa';\nimport './Footer.css';\n\nconst Footer: React.FC = () => {\n  const currentYear = new Date().getFullYear();\n  \n  return (\n    <footer className=\"footer\">\n      <div className=\"footer-container\">\n        <div className=\"footer-content\">\n          <div className=\"footer-section\">\n            <h3>درباره سامانه</h3>\n            <p>\n              سامانه مدیریت یکپارچه و هوشمند صدور آفیش رسا (سامانه رسا)،\n              برای مدیریت هوشمند و یکپارچه برنامه‌ها و رویدادها طراحی شده است.\n            </p>\n          </div>\n          \n          <div className=\"footer-section\">\n            <h3>لینک‌های سریع</h3>\n            <ul>\n              <li><a href=\"/\">صفحه اصلی</a></li>\n              <li><a href=\"/display\">نمایش برنامه‌ها</a></li>\n              <li><a href=\"/dashboard\">داشبورد مدیریت</a></li>\n            </ul>\n          </div>\n          \n          <div className=\"footer-section\">\n            <h3>تماس با ما</h3>\n            <div className=\"contact-info\">\n              <div className=\"contact-item\">\n                <FaPhone />\n                <span>۰۲۱-۱۲۳۴۵۶۷۸</span>\n              </div>\n              <div className=\"contact-item\">\n                <FaEnvelope />\n                <span>info@example.com</span>\n              </div>\n              <div className=\"contact-item\">\n                <FaMapMarkerAlt />\n                <span>تهران، خیابان example</span>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div className=\"footer-bottom\">\n          <div className=\"footer-bottom-content\">\n            <p>&copy; {currentYear} سامانه رسا. تمامی حقوق محفوظ است.</p>\n            <div className=\"footer-links\">\n              <a href=\"#privacy\">حریم خصوصی</a>\n              <a href=\"#terms\">شرایط استفاده</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nexport default Footer;","import React from 'react';\nimport { Outlet } from 'react-router-dom';\nimport Header from './Header';\nimport Footer from './Footer';\nimport './Layout.css';\n\nconst Layout: React.FC = () => {\n  return (\n    <div className=\"layout\">\n      <Header />\n      <main className=\"main-content\">\n        <Outlet />\n      </main>\n      <Footer />\n    </div>\n  );\n};\n\nexport default Layout;","import React from 'react';\nimport { Navigate } from 'react-router-dom';\nimport { useAuth } from '../../contexts/AuthContext';\n\ninterface ProtectedRouteProps {\n  children: React.ReactNode;\n}\n\nconst ProtectedRoute: React.FC<ProtectedRouteProps> = ({ children }) => {\n  const { admin, loading } = useAuth();\n\n  if (loading) {\n    return (\n      <div style={{ \n        display: 'flex', \n        justifyContent: 'center', \n        alignItems: 'center', \n        height: '100vh',\n        fontSize: '18px',\n        color: '#667eea'\n      }}>\n        در حال بارگذاری...\n      </div>\n    );\n  }\n\n  if (!admin) {\n    return <Navigate to=\"/login\" replace />;\n  }\n\n  return <>{children}</>;\n};\n\nexport default ProtectedRoute;","import moment from 'moment-jalaali';\n\n// Configure moment-jalaali\nmoment.loadPersian({\n  dialect: 'persian-modern',\n  usePersianDigits: true\n});\n\nexport const persianDate = {\n  // Get current Persian date\n  getCurrentDate() {\n    return moment().format('jYYYY/jMM/jDD');\n  },\n  \n  // Get current Persian datetime\n  getCurrentDateTime() {\n    return moment().format('jYYYY/jMM/jDD - HH:mm');\n  },\n  \n  // Convert Gregorian to Persian\n  toPersian(date) {\n    return moment(date).format('jYYYY/jMM/jDD');\n  },\n  \n  // Convert Persian to Gregorian\n  toGregorian(persianDate) {\n    return moment(persianDate, 'jYYYY/jMM/jDD').format('YYYY-MM-DD');\n  },\n  \n  // Get Persian day name\n  getDayName(date = null) {\n    const targetDate = date ? moment(date) : moment();\n    return targetDate.format('dddd');\n  },\n  \n  // Get Persian month name\n  getMonthName(date = null) {\n    const targetDate = date ? moment(date) : moment();\n    return targetDate.format('jMMMM');\n  },\n  \n  // Add days to Persian date\n  addDays(days, date = null) {\n    const targetDate = date ? moment(date) : moment();\n    return targetDate.add(days, 'days').format('jYYYY/jMM/jDD');\n  },\n  \n  // Get date range (for yesterday, today, tomorrow)\n  getDateRange() {\n    const today = moment();\n    const yesterday = moment().subtract(1, 'days');\n    const tomorrow = moment().add(1, 'days');\n    \n    return {\n      yesterday: {\n        gregorian: yesterday.format('YYYY-MM-DD'),\n        persian: yesterday.format('jYYYY/jMM/jDD'),\n        dayName: yesterday.format('dddd')\n      },\n      today: {\n        gregorian: today.format('YYYY-MM-DD'),\n        persian: today.format('jYYYY/jMM/jDD'),\n        dayName: today.format('dddd')\n      },\n      tomorrow: {\n        gregorian: tomorrow.format('YYYY-MM-DD'),\n        persian: tomorrow.format('jYYYY/jMM/jDD'),\n        dayName: tomorrow.format('dddd')\n      }\n    };\n  },\n  \n  // Format time in Persian style\n  formatTime(time) {\n    return moment(time, 'HH:mm').format('HH:mm');\n  },\n  \n  // Get Persian calendar for a month\n  getMonthCalendar(year, month) {\n    const startDate = moment(`${year}/${month}/1`, 'jYYYY/jMM/jDD');\n    const daysInMonth = startDate.jDaysInMonth();\n    const calendar = [];\n    \n    for (let day = 1; day <= daysInMonth; day++) {\n      const currentDate = moment(`${year}/${month}/${day}`, 'jYYYY/jMM/jDD');\n      calendar.push({\n        day,\n        date: currentDate.format('jYYYY/jMM/jDD'),\n        gregorian: currentDate.format('YYYY-MM-DD'),\n        dayName: currentDate.format('dddd'),\n        isToday: currentDate.isSame(moment(), 'day')\n      });\n    }\n    \n    return calendar;\n  }\n};\n\nexport default persianDate;","import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { FaCalendarAlt, FaUsers, FaTheaterMasks, FaDownload } from 'react-icons/fa';\nimport axios from 'axios';\nimport persianDate from '../utils/persianDate';\nimport './Home.css';\n\ninterface Announcement {\n  id: number;\n  title: string;\n  description: string;\n  date: string;\n  time: string;\n  venue: string;\n  price?: string;\n  program_title?: string;\n  created_at: string;\n}\n\nconst Home: React.FC = () => {\n  const [announcements, setAnnouncements] = useState<Announcement[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [currentDate, setCurrentDate] = useState('');\n  const [currentTime, setCurrentTime] = useState('');\n\n  useEffect(() => {\n    setCurrentDate(persianDate.getCurrentDateTime());\n    setCurrentTime(new Date().toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    const timeInterval = setInterval(() => {\n      setCurrentTime(new Date().toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    }, 1000);\n    fetchAnnouncements();\n    return () => clearInterval(timeInterval);\n  }, []);\n\n  const fetchAnnouncements = async () => {\n    try {\n      const response = await axios.get('/api/announcements', {\n        params: { limit: 6, status: 'published' }\n      });\n      setAnnouncements(response.data);\n    } catch (error) {\n      console.error('Error fetching announcements:', error);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const getTodayAnnouncements = () => {\n    const todayGregorian = new Date().toISOString().split('T')[0];\n    return announcements.filter(ann => ann.date === todayGregorian);\n  };\n\n  const getRecentAnnouncements = () => {\n    return announcements.slice(0, 3);\n  };\n\n  if (loading) {\n    return (\n      <div className=\"home-container\">\n        <div className=\"loading\">در حال بارگذاری...</div>\n      </div>\n    );\n  }\n\n  const todayAnnouncements = getTodayAnnouncements();\n  const recentAnnouncements = getRecentAnnouncements();\n\n  return (\n    <div className=\"home-container\">\n      {/* Hero Section */}\n      <section className=\"hero-section\">\n        <div className=\"hero-content\">\n          <h1 className=\"hero-title\">سامانه مدیریت یکپارچه و هوشمند صدور آفیش رسا</h1>\n          <p className=\"hero-description\">\n            یک پلتفرم یکپارچه برای مدیریت هوشمند صدور آفیش – سامانه رسا\n          </p>\n          <div className=\"hero-stats\">\n            <div className=\"stat-item\">\n              <FaCalendarAlt className=\"stat-icon\" />\n              <div className=\"stat-info\">\n                <div className=\"stat-number\">{announcements.length}</div>\n        <div className=\"stat-label\">آفیش ثبت شده</div>\n              </div>\n            </div>\n            <div className=\"stat-item\">\n              <FaUsers className=\"stat-icon\" />\n              <div className=\"stat-info\">\n                <div className=\"stat-number\">{todayAnnouncements.length}</div>\n                <div className=\"stat-label\">برنامه امروز</div>\n              </div>\n            </div>\n          </div>\n          <div className=\"hero-actions\">\n            <Link to=\"/display\" className=\"btn btn-primary\">\n              <FaTheaterMasks />\n              مشاهده برنامه‌ها\n            </Link>\n            <Link to=\"/dashboard\" className=\"btn btn-secondary\">\n              داشبورد مدیریت\n            </Link>\n          </div>\n        </div>\n      </section>\n\n      {/* Current Date */}\n      <section className=\"date-section\">\n        <div className=\"date-display\">\n          <div className=\"date-item\">\n            <span className=\"date-label\">تاریخ امروز:</span>\n            <span className=\"date-value\">{currentDate}</span>\n          </div>\n          <div className=\"date-item\">\n            <span className=\"date-label\">روز هفته:</span>\n            <span className=\"date-value\">{persianDate.getDayName()}</span>\n          </div>\n          <div className=\"date-item\">\n            <span className=\"date-label\">ساعت اکنون:</span>\n            <span className=\"date-value\">{currentTime}</span>\n          </div>\n        </div>\n      </section>\n\n      {/* Today's Announcements */}\n      {todayAnnouncements.length > 0 && (\n        <section className=\"announcements-section\">\n          <h2 className=\"section-title\">برنامه‌های امروز</h2>\n          <div className=\"announcements-grid\">\n            {todayAnnouncements.map(announcement => (\n              <div key={announcement.id} className=\"announcement-card today\">\n                <div className=\"card-header\">\n                  <h3 className=\"card-title\">{announcement.title}</h3>\n                  <span className=\"time-badge\">{announcement.time}</span>\n                </div>\n                <p className=\"card-description\">{announcement.description}</p>\n                <div className=\"card-details\">\n                  <div className=\"detail-item\">\n                    <span className=\"detail-label\">مکان:</span>\n                    <span className=\"detail-value\">{announcement.venue}</span>\n                  </div>\n                  {announcement.price && (\n                    <div className=\"detail-item\">\n                      <span className=\"detail-label\">قیمت:</span>\n                      <span className=\"detail-value\">{announcement.price}</span>\n                    </div>\n                  )}\n                </div>\n                <div className=\"card-actions\">\n                  <Link to={`/poster/${announcement.id}`} className=\"btn btn-outline\">\n                    <FaDownload />\n                    دانلود پوستر\n                  </Link>\n                </div>\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Recent Announcements */}\n      {recentAnnouncements.length > 0 && (\n        <section className=\"announcements-section\">\n      <h2 className=\"section-title\">آخرین آفیش‌ها</h2>\n          <div className=\"announcements-grid\">\n            {recentAnnouncements.map(announcement => (\n              <div key={announcement.id} className=\"announcement-card\">\n                <div className=\"card-header\">\n                  <h3 className=\"card-title\">{announcement.title}</h3>\n                  <span className=\"date-badge\">{persianDate.toPersian(announcement.date)}</span>\n                </div>\n                <p className=\"card-description\">{announcement.description}</p>\n                <div className=\"card-details\">\n                  <div className=\"detail-item\">\n                    <span className=\"detail-label\">زمان:</span>\n                    <span className=\"detail-value\">{announcement.time}</span>\n                  </div>\n                  <div className=\"detail-item\">\n                    <span className=\"detail-label\">مکان:</span>\n                    <span className=\"detail-value\">{announcement.venue}</span>\n                  </div>\n                </div>\n                <div className=\"card-actions\">\n                  <Link to={`/poster/${announcement.id}`} className=\"btn btn-outline\">\n                    <FaDownload />\n                    مشاهده پوستر\n                  </Link>\n                </div>\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Empty State */}\n      {announcements.length === 0 && (\n        <section className=\"empty-section\">\n          <div className=\"empty-content\">\n            <FaTheaterMasks className=\"empty-icon\" />\n      <h3>هنوز آفیشی ثبت نشده</h3>\n      <p>اولین آفیش خود را ایجاد کنید و برنامه‌های خود را مدیریت کنید.</p>\n            <Link to=\"/dashboard\" className=\"btn btn-primary\">\n              شروع کنید\n            </Link>\n          </div>\n        </section>\n      )}\n    </div>\n  );\n};\n\nexport default Home;","import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport {\n  FaTachometerAlt, FaUsers, FaCalendarAlt, FaFileAlt,\n  FaChartBar, FaCog, FaSignOutAlt, FaPlus, FaEye, FaEdit, FaTrash\n} from 'react-icons/fa';\nimport axios from 'axios';\nimport { useAuth } from '../contexts/AuthContext';\nimport './Dashboard.css';\n\nconst Dashboard: React.FC = () => {\n  const { logout } = useAuth();\n  const [stats, setStats] = useState({\n    totalAnnouncements: 0,\n    todayAnnouncements: 0,\n    totalActors: 0,\n    totalPrograms: 0\n  });\n  const [recentAnnouncements, setRecentAnnouncements] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [currentDate, setCurrentDate] = useState('');\n  const [currentTime, setCurrentTime] = useState('');\n\n  useEffect(() => {\n    fetchDashboardData();\n    // Live date/time\n    const now = new Date();\n    setCurrentDate(now.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }));\n    setCurrentTime(now.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    const dateInterval = setInterval(() => {\n      const d = new Date();\n      setCurrentDate(d.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }));\n    }, 60000);\n    const timeInterval = setInterval(() => {\n      const d = new Date();\n      setCurrentTime(d.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    }, 1000);\n    return () => {\n      clearInterval(dateInterval);\n      clearInterval(timeInterval);\n    };\n  }, []);\n\n  useEffect(() => {\n    const onKey = (e: KeyboardEvent) => {\n      if (e.ctrlKey || e.altKey || e.metaKey) return;\n      const k = e.key.toLowerCase();\n      if (k === 'n') { window.location.href = '/announcements/new'; }\n      if (k === 'a') { window.location.href = '/actors'; }\n      if (k === 'p') { window.location.href = '/programs'; }\n      if (k === 'd') { window.location.href = '/dashboard'; }\n    };\n    window.addEventListener('keydown', onKey);\n    return () => window.removeEventListener('keydown', onKey);\n  }, []);\n\n  const fetchDashboardData = async () => {\n    try {\n      const [announcementsRes, actorsRes, programsRes] = await Promise.all([\n        axios.get('/api/announcements'),\n        axios.get('/api/actors'),\n        axios.get('/api/programs')\n      ]);\n\n      const announcements = announcementsRes.data;\n      const today = new Date().toISOString().split('T')[0];\n      const todayCount = announcements.filter((a: any) => a.date === today).length;\n\n      setStats({\n        totalAnnouncements: announcements.length,\n        todayAnnouncements: todayCount,\n        totalActors: actorsRes.data.length,\n        totalPrograms: programsRes.data.length\n      });\n\n      setRecentAnnouncements(announcements.slice(0, 5));\n    } catch (error) {\n      toast.error('خطا در دریافت اطلاعات داشبورد');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDeleteAnnouncement = async (id: string) => {\n  if (window.confirm('آیا از حذف این آفیش مطمئن هستید؟')) {\n      try {\n        await axios.delete(`/api/announcements/${id}`);\n    toast.success('آفیش با موفقیت حذف شد');\n        fetchDashboardData();\n      } catch (error) {\n    toast.error('خطا در حذف آفیش');\n      }\n    }\n  };\n\n  const menuItems = [\n  { title: 'آفیش‌ها', icon: FaFileAlt, link: '/announcements', color: '#3498db' },\n    { title: 'عوامل', icon: FaUsers, link: '/actors', color: '#2ecc71' },\n    { title: 'برنامه‌ها', icon: FaCalendarAlt, link: '/programs', color: '#e74c3c' },\n    { title: 'نمایش عمومی', icon: FaEye, link: '/display', color: '#9b59b6' },\n  ];\n\n  if (loading) {\n    return (\n      <div className=\"dashboard-loading\">\n        <div className=\"loading-spinner\"></div>\n        <p>در حال بارگذاری...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"dashboard-container\">\n      <div className=\"dashboard-header\">\n        <h1>داشبورد مدیریت</h1>\n        <div className=\"header-actions\">\n          <div className=\"header-meta\">\n            <div className=\"current-date\">{currentDate}</div>\n            <div className=\"live-time\">{currentTime}</div>\n          </div>\n          <button onClick={logout} className=\"btn btn-danger\">\n            <FaSignOutAlt />\n            خروج\n          </button>\n        </div>\n      </div>\n\n      <div className=\"stats-grid\">\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#3498db' }}>\n            <FaFileAlt />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.totalAnnouncements}</h3>\n  <p>کل آفیش‌ها</p>\n          </div>\n        </div>\n\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#2ecc71' }}>\n            <FaCalendarAlt />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.todayAnnouncements}</h3>\n  <p>آفیش‌های امروز</p>\n          </div>\n        </div>\n\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#e74c3c' }}>\n            <FaUsers />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.totalActors}</h3>\n            <p>کل عوامل</p>\n          </div>\n        </div>\n\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#f39c12' }}>\n            <FaChartBar />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.totalPrograms}</h3>\n            <p>کل برنامه‌ها</p>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"dashboard-content\">\n        <div className=\"quick-actions\">\n          <h2>عملیات سریع</h2>\n          <div className=\"action-grid\">\n            {menuItems.map((item, index) => (\n              <Link key={index} to={item.link} className=\"action-card\" style={{ borderColor: item.color }}>\n                <div className=\"action-icon\" style={{ color: item.color }}>\n                  <item.icon />\n                </div>\n                <h3>{item.title}</h3>\n              </Link>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"recent-announcements\">\n          <div className=\"section-header\">\n  <h2>آخرین آفیش‌ها</h2>\n            <Link to=\"/announcements/new\" className=\"btn btn-success\">\n              <FaPlus />\n  آفیش جدید\n            </Link>\n          </div>\n\n          <div className=\"announcements-table\">\n            <table>\n              <thead>\n                <tr>\n                  <th>عنوان</th>\n                  <th>تاریخ</th>\n                  <th>زمان</th>\n                  <th>برنامه</th>\n                  <th>عملیات</th>\n                </tr>\n              </thead>\n              <tbody>\n                {recentAnnouncements.length === 0 ? (\n                  <tr>\n  <td colSpan={5} className=\"empty-message\">هیچ آفیشی یافت نشد</td>\n                  </tr>\n                ) : (\n                  recentAnnouncements.map((announcement: any) => (\n                    <tr key={announcement.id}>\n                      <td>{announcement.title}</td>\n                      <td>{announcement.date}</td>\n                      <td>{announcement.time}</td>\n                      <td>{announcement.program_title || '-'}</td>\n                      <td className=\"actions\">\n                        <Link to={`/announcements/${announcement.id}`} className=\"action-btn view\">\n                          <FaEye />\n                        </Link>\n                        <Link to={`/announcements/${announcement.id}/edit`} className=\"action-btn edit\">\n                          <FaEdit />\n                        </Link>\n                        <button\n                          onClick={() => handleDeleteAnnouncement(announcement.id)}\n                          className=\"action-btn delete\"\n                        >\n                          <FaTrash />\n                        </button>\n                      </td>\n                    </tr>\n                  ))\n                )}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Dashboard;\n","import React, { useState } from 'react';\nimport { useNavigate, Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport { FaUser, FaLock, FaSignInAlt } from 'react-icons/fa';\nimport { useAuth } from '../contexts/AuthContext';\nimport './Login.css';\nimport Logo from '../components/Logo';\n\nconst Login: React.FC = () => {\n  const [username, setUsername] = useState('');\n  const [password, setPassword] = useState('');\n  const [loading, setLoading] = useState(false);\n  const { login } = useAuth();\n  const navigate = useNavigate();\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!username || !password) {\n      toast.error('لطفاً نام کاربری و رمز عبور را وارد کنید');\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const success = await login(username, password);\n      if (success) {\n        toast.success('ورود موفقیت‌آمیز بود');\n        navigate('/dashboard');\n      } else {\n        toast.error('نام کاربری یا رمز عبور اشتباه است');\n      }\n    } catch (error) {\n      toast.error('خطا در ورود. لطفاً دوباره تلاش کنید');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"login-container\">\n      <div className=\"login-card\">\n        <div className=\"login-header\">\n          <div className=\"login-logo\">\n            <Logo src=\"/logo.png.jpg\" height={144} width={144} alt=\"لوگو\" />\n            <h1>ورود به سامانه رسا</h1>\n          </div>\n          <p className=\"login-subtitle\">به سامانه مدیریت یکپارچه و هوشمند صدور آفیش رسا خوش آمدید</p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"login-form\">\n          <div className=\"form-group\">\n            <label htmlFor=\"username\" className=\"form-label\">\n              <FaUser />\n              نام کاربری\n            </label>\n            <input\n              type=\"text\"\n              id=\"username\"\n              value={username}\n              onChange={(e) => setUsername(e.target.value)}\n              className=\"form-input\"\n              placeholder=\"نام کاربری خود را وارد کنید\"\n              disabled={loading}\n            />\n          </div>\n\n          <div className=\"form-group\">\n            <label htmlFor=\"password\" className=\"form-label\">\n              <FaLock />\n              رمز عبور\n            </label>\n            <input\n              type=\"password\"\n              id=\"password\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              className=\"form-input\"\n              placeholder=\"رمز عبور خود را وارد کنید\"\n              disabled={loading}\n            />\n          </div>\n\n          <button type=\"submit\" className=\"login-btn\" disabled={loading}>\n            {loading ? (\n              <span className=\"loading-spinner\">در حال ورود...</span>\n            ) : (\n              <>\n                <FaSignInAlt />\n                ورود\n              </>\n            )}\n          </button>\n        </form>\n\n        <div className=\"login-footer\">\n          <p>رمز عبور پیش‌فرض: admin123</p>\n          <Link to=\"/\">بازگشت به صفحه اصلی</Link>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Login;\n","export const toPersianDigits = (input: string | number): string => {\n  const str = String(input);\n  const map: Record<string, string> = {\n    '0': '۰', '1': '۱', '2': '۲', '3': '۳', '4': '۴',\n    '5': '۵', '6': '۶', '7': '۷', '8': '۸', '9': '۹',\n  };\n  return str.replace(/[0-9]/g, (d) => map[d]);\n};\n\nexport const toEnglishDigits = (input: string): string => {\n  const map: Record<string, string> = {\n    '۰': '0', '۱': '1', '۲': '2', '۳': '3', '۴': '4',\n    '۵': '5', '۶': '6', '۷': '7', '۸': '8', '۹': '9',\n  };\n  return input.replace(/[۰-۹]/g, (d) => map[d] || d);\n};\n\n// Ensures HH:mm is normalized to English digits for backend\nexport const normalizeTime = (time: string): string => {\n  return toEnglishDigits(time.trim());\n};","import html2canvas from 'html2canvas';\nimport { jsPDF } from 'jspdf';\nimport persianDate from './persianDate';\n\nexport const announcementGenerator = {\n  // Generate poster HTML\n  generatePosterHTML(announcement) {\n    const {\n      title,\n      description,\n      date,\n      time,\n      venue,\n      price,\n      program_title,\n      program_type,\n      actors\n    } = announcement;\n    \n    const persianDateStr = persianDate.toPersian(date);\n    const dayName = persianDate.getDayName(date);\n    \n    return `\n      <div dir=\"rtl\" style=\"\n        width: 800px;\n        height: 1000px;\n        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        padding: 40px;\n        font-family: 'IRANSans', Tahoma, Arial, sans-serif;\n        color: white;\n        position: relative;\n        overflow: hidden;\n      \">\n        <!-- Decorative background -->\n        <div style=\"\n          position: absolute;\n          top: 0;\n          left: 0;\n          right: 0;\n          bottom: 0;\n          background: url('data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><circle cx=\"20\" cy=\"20\" r=\"2\" fill=\"rgba(255,255,255,0.1)\"/><circle cx=\"80\" cy=\"40\" r=\"1.5\" fill=\"rgba(255,255,255,0.1)\"/><circle cx=\"40\" cy=\"80\" r=\"1\" fill=\"rgba(255,255,255,0.1)\"/></svg>');\n          z-index: 1;\n        \"></div>\n        \n        <!-- Main content -->\n        <div style=\"position: relative; z-index: 2; height: 100%;\">\n          <!-- Header -->\n          <div style=\"\n            text-align: center;\n            margin-bottom: 40px;\n            border-bottom: 2px solid rgba(255,255,255,0.3);\n            padding-bottom: 20px;\n          \">\n            <h1 style=\"\n              font-size: 48px;\n              margin: 0 0 10px 0;\n              font-weight: bold;\n              text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n            \">${title}</h1>\n            ${program_title ? `<h2 style=\"\n              font-size: 32px;\n              margin: 0;\n              font-weight: normal;\n              color: rgba(255,255,255,0.9);\n            \">${program_title}</h2>` : ''}\n          </div>\n          \n          <!-- Date and Time Section -->\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n          \">\n            <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n              <div style=\"text-align: center;\">\n                <div style=\"font-size: 24px; font-weight: bold; margin-bottom: 5px;\">${dayName}</div>\n                <div style=\"font-size: 28px;\">${persianDateStr}</div>\n              </div>\n              <div style=\"text-align: center;\">\n                <div style=\"font-size: 20px; margin-bottom: 5px;\">ساعت</div>\n                <div style=\"font-size: 32px; font-weight: bold;\">${time}</div>\n              </div>\n            </div>\n          </div>\n          \n          <!-- Venue Section -->\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 10px;\">📍 محل برگزاری</div>\n            <div style=\"font-size: 24px; font-weight: bold;\">${venue}</div>\n          </div>\n          \n          <!-- Description -->\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n            min-height: 150px;\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 15px;\">📝 توضیحات</div>\n            <div style=\"font-size: 18px; line-height: 1.6;\">${description}</div>\n          </div>\n          \n          <!-- Actors Section -->\n          ${actors && actors.length > 0 ? `\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 15px;\">🎭 عوامل</div>\n            <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\">\n              ${actors.map(actor => `\n                <div style=\"font-size: 16px;\">\n                  <strong>${actor.name}</strong>\n                  ${actor.role_in_program ? `<br><small>${actor.role_in_program}</small>` : ''}\n                </div>\n              `).join('')}\n            </div>\n          </div>\n          ` : ''}\n          \n          <!-- Price Section -->\n          ${price ? `\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            backdrop-filter: blur(10px);\n            text-align: center;\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 10px;\">💰 قیمت بلیت</div>\n            <div style=\"font-size: 32px; font-weight: bold; color: #FFD700;\">${price}</div>\n          </div>\n          ` : ''}\n          \n          <!-- Footer -->\n          <div style=\"\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            text-align: center;\n            padding: 20px;\n            border-top: 2px solid rgba(255,255,255,0.3);\n          \">\n            <div style=\"font-size: 16px; opacity: 0.8;\">\n              تهیه شده با سامانه رسا\n            </div>\n            <div style=\"font-size: 14px; opacity: 0.6; margin-top: 5px;\">\n              ${persianDate.getCurrentDateTime()}\n            </div>\n          </div>\n        </div>\n      </div>\n    `;\n  },\n  \n  // Generate poster image\n  async generatePosterImage(announcement) {\n    const html = this.generatePosterHTML(announcement);\n    \n    // Create temporary container\n    const container = document.createElement('div');\n    container.innerHTML = html;\n    container.style.position = 'absolute';\n    container.style.left = '-9999px';\n    container.style.top = '-9999px';\n    document.body.appendChild(container);\n    \n    try {\n      const canvas = await html2canvas(container, {\n        width: 800,\n        height: 1000,\n        scale: 2,\n        backgroundColor: null,\n        useCORS: true,\n        allowTaint: true\n      });\n      \n      document.body.removeChild(container);\n      return canvas.toDataURL('image/png', 1.0);\n    } catch (error) {\n      document.body.removeChild(container);\n      throw error;\n    }\n  },\n  \n  // Generate PDF\n  async generatePDF(announcement) {\n    const imageData = await this.generatePosterImage(announcement);\n    \n    const pdf = new jsPDF({\n      orientation: 'portrait',\n      unit: 'mm',\n      format: 'a4'\n    });\n    \n    // Calculate dimensions to fit A4\n    const pdfWidth = 210; // A4 width in mm\n    const pdfHeight = 297; // A4 height in mm\n    const imageWidth = 800;\n    const imageHeight = 1000;\n    \n    // Calculate scaling to fit the page\n    const scale = Math.min(pdfWidth / imageWidth, pdfHeight / imageHeight) * 25.4; // Convert pixels to mm\n    const width = imageWidth * scale / 25.4;\n    const height = imageHeight * scale / 25.4;\n    \n    // Center the image\n    const x = (pdfWidth - width) / 2;\n    const y = (pdfHeight - height) / 2;\n    \n    pdf.addImage(imageData, 'PNG', x, y, width, height);\n    \n    return pdf.output('blob');\n  }\n};\n\nexport default announcementGenerator;","import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport {\n  FaPlus, FaEye, FaEdit, FaTrash, FaSearch, FaCalendar,\n  FaDownload, FaPrint, FaFilePdf\n} from 'react-icons/fa';\nimport axios from 'axios';\nimport DateObject from 'react-date-object';\nimport persian from 'react-date-object/calendars/persian';\nimport gregorian from 'react-date-object/calendars/gregorian';\nimport DatePicker from 'react-multi-date-picker';\nimport { toPersianDigits } from '../utils/locale';\nimport announcementGenerator from '../utils/announcementGenerator';\nimport './Announcements.css';\n\nconst Announcements: React.FC = () => {\n  const [announcements, setAnnouncements] = useState([]);\n  const [filteredAnnouncements, setFilteredAnnouncements] = useState([]);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [dateFilter, setDateFilter] = useState('');\n  const [statusFilter, setStatusFilter] = useState<string>('');\n  const [presetName, setPresetName] = useState('');\n  const [presets, setPresets] = useState<Array<{ name: string; search: string; date: string; status: string }>>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchAnnouncements();\n    const saved = localStorage.getItem('ann_filter_presets');\n    if (saved) {\n      try { setPresets(JSON.parse(saved)); } catch { }\n    }\n  }, []);\n\n  useEffect(() => {\n    filterAnnouncements();\n  }, [announcements, searchTerm, dateFilter]);\n\n  const fetchAnnouncements = async () => {\n    try {\n      const response = await axios.get('/api/announcements');\n      setAnnouncements(response.data);\n    } catch (error) {\n      toast.error('خطا در دریافت آفیش‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const filterAnnouncements = () => {\n    let filtered = announcements;\n\n    if (searchTerm) {\n      filtered = filtered.filter((announcement: any) =>\n        announcement.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        (announcement.program_title || announcement.program?.name || '')\n          .toLowerCase().includes(searchTerm.toLowerCase()) ||\n        announcement.actors?.some((actor: any) =>\n          actor.name.toLowerCase().includes(searchTerm.toLowerCase())\n        )\n      );\n    }\n\n    if (dateFilter) {\n      filtered = filtered.filter((announcement: any) =>\n        announcement.date === dateFilter\n      );\n    }\n\n    if (statusFilter) {\n      filtered = filtered.filter((announcement: any) =>\n        (announcement.status || '') === statusFilter\n      );\n    }\n\n    setFilteredAnnouncements(filtered);\n  };\n\n  const handleDelete = async (id: string) => {\n    if (window.confirm('آیا از حذف این آفیش مطمئن هستید؟')) {\n      try {\n        // Optimistic UI\n        const prev = announcements;\n        setAnnouncements((list: any) => list.filter((a: any) => a.id !== id));\n        setFilteredAnnouncements((list: any) => list.filter((a: any) => a.id !== id));\n        const token = localStorage.getItem('token');\n        await axios.delete(`/api/announcements/${id}`, {\n          headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n        });\n        toast.success('آفیش با موفقیت حذف شد');\n      } catch (error) {\n        toast.error('خطا در حذف آفیش؛ بازگشت به حالت قبل');\n        fetchAnnouncements();\n      }\n    }\n  };\n\n  const savePreset = () => {\n    if (!presetName.trim()) { toast.error('نام پرِست را وارد کنید'); return; }\n    const next = presets.filter(p => p.name !== presetName).concat([{ name: presetName, search: searchTerm, date: dateFilter, status: statusFilter }]);\n    setPresets(next);\n    localStorage.setItem('ann_filter_presets', JSON.stringify(next));\n    toast.success('پرِست ذخیره شد');\n  };\n\n  const applyPreset = (p: { name: string; search: string; date: string; status: string }) => {\n    setSearchTerm(p.search);\n    setDateFilter(p.date);\n    setStatusFilter(p.status);\n  };\n\n  const handlePrint = async (announcement: any) => {\n    try {\n      await announcementGenerator.generatePDF(announcement);\n      toast.success('فایل PDF با موفقیت ایجاد شد');\n    } catch (error) {\n      toast.error('خطا در ایجاد فایل PDF');\n    }\n  };\n\n  const formatDate = (dateString: string) => {\n    try {\n      const obj = new DateObject({ date: new Date(dateString) });\n      return obj.convert(persian).format('YYYY/MM/DD');\n    } catch {\n      return dateString;\n    }\n  };\n\n  const formatTime = (timeString: string) => {\n    return toPersianDigits(timeString || '');\n  };\n\n  if (loading) {\n    return (\n      <div className=\"announcements-container\">\n        <div className=\"page-header\">\n          <h1>مدیریت آفیش‌ها</h1>\n          <button className=\"add-btn\" disabled>\n            <FaPlus />\n            آفیش جدید\n          </button>\n        </div>\n        <div className=\"filters-section skeleton-block\" />\n        <div className=\"announcements-grid\">\n          {Array.from({ length: 6 }).map((_, i) => (\n            <div key={i} className=\"announcement-card skeleton\">\n              <div className=\"skeleton-title\" />\n              <div className=\"skeleton-line\" />\n              <div className=\"skeleton-line\" />\n              <div className=\"skeleton-line short\" />\n              <div className=\"card-footer\">\n                <div className=\"skeleton-badge\" />\n                <div className=\"skeleton-small\" />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"announcements-container\">\n      <div className=\"page-header\">\n        <h1>مدیریت آفیش‌ها</h1>\n        <Link to=\"/announcements/new\" className=\"add-btn\">\n          <FaPlus />\n          آفیش جدید\n        </Link>\n      </div>\n\n      <div className=\"filters-section\">\n        <div className=\"search-box\">\n          <FaSearch />\n          <input\n            type=\"text\"\n            placeholder=\"جستجو در عنوان، برنامه یا عوامل...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"search-input\"\n          />\n        </div>\n        <div className=\"date-filter\">\n          <FaCalendar />\n          <DatePicker\n            calendar={persian}\n            inputClass=\"date-input\"\n            value={dateFilter ? new DateObject({ date: new Date(dateFilter) }).convert(persian) : null}\n            onChange={(val: any) => {\n              if (!val) { setDateFilter(''); return; }\n              try {\n                const obj = val instanceof DateObject ? val : new DateObject(val);\n                const g = obj.convert(gregorian).format('YYYY-MM-DD');\n                setDateFilter(g);\n              } catch {\n                toast.error('خطا در تنظیم فیلتر تاریخ');\n              }\n            }}\n            format=\"YYYY/MM/DD\"\n            placeholder=\"فیلتر تاریخ (شمسی)\"\n          />\n          {dateFilter && (\n            <button\n              onClick={() => setDateFilter('')}\n              className=\"clear-date-btn\"\n            >\n              حذف فیلتر\n            </button>\n          )}\n        </div>\n        <div className=\"status-filter\">\n          <select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value)} className=\"status-select\">\n            <option value=\"\">همه وضعیت‌ها</option>\n            <option value=\"published\">منتشر شده</option>\n            <option value=\"draft\">پیش‌نویس</option>\n          </select>\n        </div>\n        <div className=\"preset-controls\">\n          <input type=\"text\" value={presetName} onChange={(e) => setPresetName(e.target.value)} placeholder=\"نام پرِست\" className=\"preset-input\" />\n          <button className=\"btn btn-light\" onClick={savePreset}>ذخیره پرِست</button>\n          {presets.length > 0 && (\n            <select onChange={(e) => { const p = presets.find(pp => pp.name === e.target.value); if (p) applyPreset(p); }} className=\"preset-select\">\n              <option value=\"\">اعمال پرِست...</option>\n              {presets.map(p => (<option key={p.name} value={p.name}>{p.name}</option>))}\n            </select>\n          )}\n        </div>\n      </div>\n\n      <div className=\"announcements-grid\">\n        {filteredAnnouncements.length === 0 ? (\n          <div className=\"empty-state\">\n            <FaFilePdf />\n            <p>هیچ آفیشی یافت نشد</p>\n            <Link to=\"/announcements/new\" className=\"create-first-btn\">\n              ایجاد اولین آفیش\n            </Link>\n          </div>\n        ) : (\n          filteredAnnouncements.map((announcement: any) => (\n            <div key={announcement.id} className=\"announcement-card\">\n              <div className=\"card-header\">\n                <h3>{announcement.title}</h3>\n                <div className=\"card-actions\">\n                  <button\n                    onClick={() => handlePrint(announcement)}\n                    className=\"action-btn print\"\n                    title=\"چاپ/دانلود PDF\"\n                  >\n                    <FaDownload />\n                  </button>\n                  <Link\n                    to={`/announcements/${announcement.id}`}\n                    className=\"action-btn view\"\n                    title=\"مشاهده\"\n                  >\n                    <FaEye />\n                  </Link>\n                  <Link\n                    to={`/announcements/${announcement.id}/edit`