tors(actRes.data);\n      } catch (err) {\n        // silent fail\n      }\n    };\n    loadOptions();\n    const draft = localStorage.getItem('announcement_draft');\n    if (!isEdit && draft) {\n      try {\n        const d = JSON.parse(draft);\n        setFormData(d.formData || formData);\n        setStatus(d.status || 'draft');\n      } catch { }\n    }\n  }, [id]);\n\n  const fetchAnnouncement = async () => {\n    try {\n      const response = await axios.get(`/api/announcements/${id}`);\n      const announcement = response.data;\n      setFormData({\n        title: announcement.title,\n        description: announcement.description,\n        date: announcement.date,\n        time: announcement.time,\n        location: announcement.venue,\n        programId: announcement.program_id ? String(announcement.program_id) : '',\n        actorIds: announcement.actors?.map((actor: any) => actor.id) || []\n      });\n    } catch (error) {\n      toast.error('خطا در دریافت اطلاعات آفیش');\n      navigate('/announcements');\n    }\n  };\n\n  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {\n    const { name, value } = e.target;\n    setFormData(prev => ({\n      ...prev,\n      [name]: value\n    }));\n    setTimeout(() => {\n      localStorage.setItem('announcement_draft', JSON.stringify({ formData: { ...formData, [name]: value }, status }));\n    }, 0);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.title || !formData.description || !formData.date || !formData.time || !formData.location) {\n      toast.error('لطفاً فیلدهای الزامی را پر کنید');\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const token = localStorage.getItem('token');\n      const payload = {\n        title: formData.title,\n        description: formData.description,\n        program_id: formData.programId || null,\n        date: formData.date,\n        time: normalizeTime(formData.time),\n        venue: formData.location,\n        price: null,\n        actor_ids: formData.actorIds || [],\n        actor_roles: (formData.actorIds || []).map(aid => actorRoles[aid] || null),\n        status,\n      };\n\n      if (isEdit) {\n        await axios.put(`/api/announcements/${id}`, payload, {\n          headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n        });\n        toast.success('آفیش با موفقیت ویرایش شد');\n      } else {\n        await axios.post('/api/announcements', payload, {\n          headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n        });\n        toast.success('آفیش با موفقیت ایجاد شد');\n      }\n\n      navigate('/announcements');\n      localStorage.removeItem('announcement_draft');\n    } catch (error) {\n      toast.error(isEdit ? 'خطا در ویرایش آفیش' : 'خطا در ایجاد آفیش');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"announcement-form-container\">\n      <h2>{isEdit ? 'ویرایش آفیش' : 'ایجاد آفیش جدید'}</h2>\n\n      <form onSubmit={handleSubmit} className=\"announcement-form\">\n        <div className=\"form-group\">\n          <label htmlFor=\"title\">عنوان آفیش *</label>\n          <input\n            type=\"text\"\n            id=\"title\"\n            name=\"title\"\n            value={formData.title}\n            onChange={handleInputChange}\n            className=\"form-input\"\n            required\n          />\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"status\">وضعیت</label>\n          <select id=\"status\" value={status} onChange={(e) => { setStatus(e.target.value as any); localStorage.setItem('announcement_draft', JSON.stringify({ formData, status: e.target.value })); }} className=\"form-select\">\n            <option value=\"draft\">پیش‌نویس</option>\n            <option value=\"published\">منتشر شده</option>\n          </select>\n        </div>\n\n        <div class