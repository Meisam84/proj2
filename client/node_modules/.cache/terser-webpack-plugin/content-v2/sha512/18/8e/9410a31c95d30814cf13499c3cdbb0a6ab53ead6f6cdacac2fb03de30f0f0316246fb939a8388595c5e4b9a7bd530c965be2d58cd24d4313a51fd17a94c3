nstanceof DateObject ? val : new DateObject(val);\n                  const time = obj.format('HH:mm');\n                  setFormData(prev => ({ ...prev, time }));\n                } catch {\n                  toast.error('خطا در تنظیم زمان');\n                }\n              }}\n              placeholder=\"انتخاب زمان (فارسی)\"\n              required\n            />\n          </div>\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"location\">مکان</label>\n          <input\n            type=\"text\"\n            id=\"location\"\n            name=\"location\"\n            value={formData.location}\n            onChange={handleInputChange}\n            className=\"form-input\"\n          />\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"programId\">برنامه مرتبط</label>\n          <select\n            id=\"programId\"\n            name=\"programId\"\n            value={formData.programId}\n            onChange={handleInputChange}\n            className=\"form-select\"\n          >\n            <option value=\"\">بدون برنامه</option>\n            {programs.map((p: any) => (\n              <option key={p.id} value={String(p.id)}>{p.title}</option>\n            ))}\n          </select>\n        </div>\n\n        <div className=\"form-group\">\n          <label>انتخاب عوامل و نقش در برنامه</label>\n          <div className=\"actors-grid\">\n            {actors.map((a: any) => {\n              const checked = formData.actorIds.includes(String(a.id));\n              return (\n                <div className=\"actor-checkbox\" key={a.id}>\n                  <input\n                    type=\"checkbox\"\n                    checked={checked}\n                    onChange={(e) => {\n                      const isChecked = e.target.checked;\n                      setFormData(prev => ({\n                        ...prev,\n                        actorIds: isChecked\n                          ? [...prev.actorIds, String(a.id)]\n                          : prev.actorIds.filter(id => id !== String(a.id))\n                      }));\n                    }}\n                  />\n                  <label>{a.name} <span className=\"actor-role\">({a.role})</span></label>\n                  {checked && (\n                    <input\n                      type=\"text\"\n                      placeholder=\"نقش در برنامه\"\n                      value={actorRoles[String(a.id)] || ''}\n                      onChange={(e) => setActorRoles(prev => ({ ...prev, [String(a.id)]: e.target.value }))}\n                      className=\"form-input\"\n                      style={{ maxWidth: '180px' }}\n                    />\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        <div className=\"form-actions\">\n          <button type=\"submit\" className=\"save-btn\" disabled={loading}>\n            {loading ? (\n              <span>در حال ذخیره...</span>\n            ) : (\n              <>\n                <FaSave />\n                {isEdit ? 'ویرایش آفیش' : 'ایجاد آفیش'}\n              </>\n            )}\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => navigate('/announcements')}\n            className=\"cancel-btn\"\n            disabled={loading}\n          >\n            <FaTimes />\n            انصراف\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => { localStorage.setItem('announcement_draft', JSON.stringify({ formData, status })); toast.success('پیش‌نویس ذخیره شد'); }}\n            className=\"save-btn\"\n            disabled={loading}\n            style={{ marginInlineStart: '8px' }}\n          >\n            ذخیره پیش‌نویس\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n};\n\nexport default AnnouncementForm;\n","import React from 'react';\nimport AnnouncementForm from './AnnouncementForm';\n\nconst CreateAnnouncement: React.FC = () => {\n  return <AnnouncementForm />;\n};\n\nexport default CreateAnnouncement;","import React, { useEffect, useState } from 'react';\nimport { useParams, useNavigate, Link } from 'react-router-dom';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport DateObject from 'react-date-object';\nimport persian from 'react-date-object/calendars/persian';\nimport { toPersianDigits } from '../utils/locale';\nimport { FaCalendarAlt, FaClock, FaMapMarkerAlt, FaEdit, FaTrash } from 'react-icons/fa';\n\nconst AnnouncementDetail: React.FC = () => {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const [announcement, setAnnouncement] = useState<any>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    const fetchData = async () => {\n      try {\n        const res = await axios.get(`/api/announcements/${id}`);\n        setAnnouncement(res.data);\n      } catch (err) {\n    toast.error('خطا در دریافت آفیش');\n        navigate('/announcements');\n      } finally {\n        setLoading(false);\n      }\n    };\n    fetchData();\n  }, [id, navigate]);\n\n  const handleDelete = async () => {\n    if (!id) return;\n  if (!window.confirm('آیا از حذف این آفیش مطمئن هستید؟')) return;\n    try {\n      const token = localStorage.getItem('token');\n      await axios.delete(`/api/announcements/${id}`, {\n        headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n      });\n    toast.success('آفیش با موفقیت حذف شد');\n      navigate('/announcements');\n    } catch (err) {\n    toast.error('حذف آفیش با خطا مواجه شد');\n    }\n  };\n\n  const formatDateFa = (dateStr: string) => {\n    try {\n      const obj = new DateObject({ date: new Date(dateStr) });\n      return obj.convert(persian).format('YYYY/MM/DD');\n    } catch { return dateStr; }\n  };\n\n  if (loading) {\n    return <div className=\"loading-container\"><div className=\"loading-spin