 between development and production CJS bundles of react-toastify\n// to keep CRA4 compatibility in dev while using optimized bundle in prod.\n\nconst mod =\n  process.env.NODE_ENV === 'production'\n    ? require('react-toastify/dist/react-toastify.cjs.production.min.js')\n    : require('react-toastify/dist/react-toastify.cjs.development.js');\n\nexport const toast = mod.toast;\n// In some versions, ToastContainer may be exported as default; fallback accordingly.\nexport const ToastContainer = mod.ToastContainer || mod.default;\nexport type ToastOptions = import('react-toastify').ToastOptions;","import React, { createContext, useState, useContext, useEffect } from 'react';\nimport axios from 'axios';\n\ninterface Admin {\n  id: number;\n  username: string;\n  fullName: string;\n  role: string;\n}\n\ninterface AuthContextType {\n  admin: Admin | null;\n  login: (username: string, password: string) => Promise<boolean>;\n  logout: () => void;\n  loading: boolean;\n}\n\nconst AuthContext = createContext<AuthContextType | undefined>(undefined);\n\nexport const useAuth = () => {\n  const context = useContext(AuthContext);\n  if (!context) {\n    throw new Error('useAuth must be used within an AuthProvider');\n  }\n  return context;\n};\n\nexport const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [admin, setAdmin] = useState<Admin | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    checkAuthStatus();\n  }, []);\n\n  const checkAuthStatus = async () => {\n    const token = localStorage.getItem('token');\n    if (token) {\n      try {\n        axios.defaults.headers.common.Authorization = `Bearer ${token}`;\n        const response = await axios.post('/api/auth/verify', {});\n        setAdmin(response.data.admin);\n      } catch (error) {\n        localStorage.removeItem('token');\n        delete axios.defaults.headers.common.Authorization;\n      }\n    }\n    setLoading(false);\n  };\n\n  const login = async (username: string, password: string): Promise<boolean> => {\n    try {\n      const response = await axios.post('/api/auth/login', {\n        username,\n        password,\n      });\n\n      const { token, admin: adminData } = response.data;\n      localStorage.setItem('token', token);\n      axios.defaults.headers.common.Authorization = `Bearer ${token}`;\n      setAdmin(adminData);\n      return true;\n    } catch (error) {\n      return false;\n    }\n  };\n\n  const logout = () => {\n    localStorage.removeItem('token');\n    delete axios.defaults.headers.common.Authorization;\n    setAdmin(null);\n  };\n\n  const value = {\n    admin,\n    login,\n    logout,\n    loading,\n  };\n\n  return (\n    <AuthContext.Provider value={value}>\n      {children}\n    </AuthContext.Provider>\n  );\n};","import React, { useEffect, useRef, useState } from 'react';\n\ntype LogoProps = {\n  src?: string;\n  height?: number;\n  width?: number;\n  threshold?: number; // 0-255, higher removes more near-white\n  className?: string;\n  alt?: string;\n};\n\n// Client-side background remover: makes near-white pixels transparent\nexport default function Logo({\n  src = '/logo.png',\n  height = 32,\n  width,\n  threshold = 240,\n  className,\n  alt = 'لوگو',\n}: LogoProps) {\n  const [dataUrl, setDataUrl] = useState<string | null>(null);\n  const [naturalSize, setNaturalSize] = useState<{ w: number; h: number } | null>(null);\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  useEffect(() => {\n    const img = new Image();\n    img.crossOrigin = 'anonymous';\n    img.onload = () => {\n      const w = img.naturalWidth;\n      const h = img.naturalHeight;\n      setNaturalSize({ w, h });\n      const canvas = document.createElement('canvas');\n      canvas.width = w;\n      canvas.height = h;\n      const ctx = canvas.getContext('2d');\n      if (!ctx) return;\n      ctx.drawImage(img, 0, 0);\n      const imageData = ctx.getImageData(0, 0, w, h);\n      const data = imageData.data;\n      for (let i = 0; i < data.length; i += 4) {\n        const r = data[i];\n        const g = data[i + 1];\n        const b = data[i + 2];\n        // If close to white, make transparent\n        if (r >= threshold && g >= threshold && b >= threshold) {\n          data[i + 3] = 0;\n        }\n      }\n      ctx.putImageData(imageData, 0, 0);\n      const url = canvas.toDataURL('image/png');\n      setDataUrl(url);\n      canvasRef.current = canvas;\n    };\n    img.onerror = () => {\n      // Fallback: just use original src\n      setDataUrl(null);\n    };\n    img.src = src;\n  }, [src, threshold]);\n\n  const computedStyle: React.CSSProperties = {\n    height,\n    width,\n    display: 'inline-block',\n    objectFit: 'contain',\n  };\n\n  // If we have a processed data URL, use it; otherwise use raw src\n  const finalSrc = dataUrl ?? src;\n\n  return (\n    <img\n      src={finalSrc}\n      alt={alt}\n      className={className}\n      style={computedStyle}\n      loading=\"eager\"\n    />\n  );\n}\nexport const ThemeToggle: React.FC = () => {\n  const [theme, setTheme] = React.useState<string>(() => localStorage.getItem('theme') || 'light');\n  React.useEffect(() => {\n    document.body.classList.toggle('dark', theme === 'dark');\n    localStorage.setItem('theme', theme);\n  }, [theme]);\n  return (\n    <button onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')} className=\"login-btn\" style={{ marginInlineEnd: 8 }}>\n      {theme === 'dark' ? 'تم روشن' : 'تم تاریک'}\n    </button>\n  );\n};","import React, { useState } from 'react';\nimport { Link, useNavigate } from 'react-router-dom';\nimport { useAuth } from '../../contexts/AuthContext';\nimport { FaBars, FaTimes, FaUser, FaSignOutAlt } from 'react-icons/fa';\nimport './Header.css';\nimport Logo from '../Logo';\n\nconst Header: React.FC = () => {\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\n  const { admin, logout } = useAuth();\n  const navigate = useNavigate();\n\n  const handleLogout = () => {\n    logout();\n    navigate('/login');\n  };\n\n  const toggleMenu = () => {\n    setIsMenuOpen(!isMenuOpen);\n  };\n\n  return (\n    <header className=\"header\">\n      <div className=\"header-container\">\n        <div className=\"header-logo\">\n          <Link to=\"/\">\n            <Logo src=\"/logo.png.jpg\" height={108} width={108} className=\"logo-image\" alt=\"لوگو\" />\n            <span className=\"logo-text\">سامانه رسا</span>\n          </Link>\n        </div>\n\n        <nav className={`header-nav ${isMenuOpen ? 'active' : ''}`}>\n          <ul className=\"nav-list\">\n            <li className=\"nav-item\">\n              <Link to=\"/\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                صفحه اصلی\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/display\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                نمایش برنامه‌ها\n              </Link>\n            </li>\n            {admin && (\n              <>\n                <li className=\"nav-item\">\n                  <Link to=\"/dashboard\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    داشبورد\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/announcements\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    آفیش‌ها\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/actors\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    عوامل\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/programs\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    برنامه‌ها\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/roles\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    نقش‌ها\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/bulk-upload\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    آپلود اکسل\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/estimates\" className=\"nav-link\" onClick={() => setIsMenuOpen(false)}>\n                    برآوردها\n                  </Link>\n                </li>\n              </>\n            )}\n          </ul>\n        </nav>\n\n        <div className=\"header-actions\">\n          <ThemeToggle />\n          {admin ? (\n            <div className=\"user-menu\">\n              <div className=\"user-info\">\n                <FaUser className=\"user-icon\" />\n                <span className=\"user-name\">{admin.fullName}</span>\n              </div>\n              <button className=\"logout-btn\" onClick={handleLogout}>\n                <FaSignOutAlt />\n                <span>خروج</span>\n              </button>\n            </div>\n          ) : (\n            <Link to=\"/login\" className=\"login-btn\">\n              ورود\n            </Link>\n          )}\n        </div>\n\n        <button className=\"menu-toggle\" onClick={toggleMenu}>\n          {isMenuOpen ? <FaTimes /> : <FaBars />}\n        </button>\n      </div>\n    </header>\n  );\n};\n\nexport default Header;","import React from 'react';\nimport { FaEnvelope, FaPhone, FaMapMarkerAlt } from 'react-icons/fa';\nimport './Footer.css';\n\nconst Footer: React.FC = () => {\n  const currentYear = new Date().getFullYear();\n  \n  return (\n    <footer className=\"footer\">\n      <div className=\"footer-container\">\n        <div className=\"footer-content\">\n          <div className=\"footer-section\">\n            <h3>درباره سامانه</h3>\n            <p>\n              سامانه مدیریت یکپارچه و هوشمند صدور آفیش رسا (سامانه رسا)،\n              برای مدیریت هوشمند و یکپارچه برنامه‌ها و رویدادها طراحی شده است.\n            </p>\n          </div>\n          \n          <div className=\"footer-section\">\n            <h3>لینک‌های سریع</h3>\n            <ul>\n              <li><a href=\"/\">صفحه اصلی</a></li>\n              <li><a href=\"/display\">نمایش برنامه‌ها</a></li>\n              <li><a href=\"/dashboard\">داشبورد مدیریت</a></li>\n            </ul>\n          </div>\n          \n          <div className=\"footer-section\">\n            <h3>تماس با ما</h3>\n            <div className=\"contact-info\">\n              <div className=\"contact-item\">\n                <FaPhone />\n                <span>۰۲۱-۱۲۳۴۵۶۷۸</span>\n              </div>\n              <div className=\"contact-item\">\n                <FaEnvelope />\n                <span>info@example.com</span>\n              </div>\n              <div className=\"contact-item\">\n                <FaMapMarkerAlt />\n                <span>تهران، خیابان example</span>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div className=\"footer-bottom\">\n          <div className=\"footer-bottom-content\">\n            <p>&copy; {currentYear} سامانه رسا. تمامی حقوق محفوظ است.</p>\n            <div className=\"footer-links\">\n              <a href=\"#privacy\">حریم خصوصی</a>\n              <a href=\"#terms\">شرایط استفاده</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nexport default Footer;","import React from 'react';\nimport { Outlet } from 'react-router-dom';\nimport Header from './Header';\nimport Footer from './Footer';\nimport './Layout.css';\n\nconst Layout: React.FC = () => {\n  return (\n    <div className=\"layout\">\n      <Header />\n      <main className=\"main-content\">\n        <Outlet />\n      </main>\n      <Footer />\n    </div>\n  );\n};\n\nexport default Layout;","import React from 'react';\nimport { Navigate } from 'react-router-dom';\nimport { useAuth } from '../../contexts/AuthContext';\n\ninterface ProtectedRouteProps {\n  children: React.ReactNode;\n}\n\nconst ProtectedRoute: React.FC<ProtectedRouteProps> = ({ children }) => {\n  const { admin, loading } = useAuth();\n\n  if (loading) {\n    return (\n      <div style={{ \n        display: 'flex', \n        justifyContent: 'center', \n        alignItems: 'center', \n        height: '100vh',\n        fontSize: '18px',\n        color: '#667eea'\n      }}>\n        در حال بارگذاری...\n      </div>\n    );\n  }\n\n  if (!admin) {\n    return <Navigate to=\"/login\" replace />;\n  }\n\n  return <>{children}</>;\n};\n\nexport default ProtectedRoute;","import moment from 'moment-jalaali';\n\n// Configure moment-jalaali\nmoment.loadPersian({\n  dialect: 'persian-modern',\n  usePersianDigits: true\n});\n\nexport const persianDate = {\n  // Get current Persian date\n  getCurrentDate() {\n    return moment().format('jYYYY/jMM/jDD');\n  },\n  \n  // Get current Persian datetime\n  getCurrentDateTime() {\n    return moment().format('jYYYY/jMM/jDD - HH:mm');\n  },\n  \n  // Convert Gregorian to Persian\n  toPersian(date) {\n    return moment(date).format('jYYYY/jMM/jDD');\n  },\n  \n  // Convert Persian to Gregorian\n  toGregorian(persianDate) {\n    return moment(persianDate, 'jYYYY/jMM/jDD').format('YYYY-MM-DD');\n  },\n  \n  // Get Persian day name\n  getDayName(date = null) {\n    const targetDate = date ? moment(date) : moment();\n    return targetDate.format('dddd');\n  },\n  \n  // Get Persian month name\n  getMonthName(date = null) {\n    const targetDate = date ? moment(date) : moment();\n    return targetDate.format('jMMMM');\n  },\n  \n  // Add days to Persian date\n  addDays(days, date = null) {\n    const targetDate = date ? moment(date) : moment();\n    return targetDate.add(days, 'days').format('jYYYY/jMM/jDD');\n  },\n  \n  // Get date range (for yesterday, today, tomorrow)\n  getDateRange() {\n    const today = moment();\n    const yesterday = moment().subtract(1, 'days');\n    const tomorrow = moment().add(1, 'days');\n    \n    return {\n      yesterday: {\n        gregorian: yesterday.format('YYYY-MM-DD'),\n        persian: yesterday.format('jYYYY/jMM/jDD'),\n        dayName: yesterday.format('dddd')\n      },\n      today: {\n        gregorian: today.format('YYYY-MM-DD'),\n        persian: today.format('jYYYY/jMM/jDD'),\n        dayName: today.format('dddd')\n      },\n      tomorrow: {\n        gregorian: tomorrow.format('YYYY-MM-DD'),\n        persian: tomorrow.format('jYYYY/jMM/jDD'),\n        dayName: tomorrow.format('dddd')\n      }\n    };\n  },\n  \n  // Format time in Persian style\n  formatTime(time) {\n    return moment(time, 'HH:mm').format('HH:mm');\n  },\n  \n  // Get Persian calendar for a month\n  getMonthCalendar(year, month) {\n    const startDate = moment(`${year}/${month}/1`, 'jYYYY/jMM/jDD');\n    const daysInMonth = startDate.jDaysInMonth();\n    const calendar = [];\n    \n    for (let day = 1; day <= daysInMonth; day++) {\n      const currentDate = moment(`${year}/${month}/${day}`, 'jYYYY/jMM/jDD');\n      calendar.push({\n        day,\n        date: currentDate.format('jYYYY/jMM/jDD'),\n        gregorian: currentDate.format('YYYY-MM-DD'),\n        dayName: currentDate.format('dddd'),\n        isToday: currentDate.isSame(moment(), 'day')\n      });\n    }\n    \n    return calendar;\n  }\n};\n\nexport default persianDate;","import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { FaCalendarAlt, FaUsers, FaTheaterMasks, FaDownload } from 'react-icons/fa';\nimport axios from 'axios';\nimport persianDate from '../utils/persianDate';\nimport './Home.css';\n\ninterface Announcement {\n  id: number;\n  title: string;\n  description: string;\n  date: string;\n  time: string;\n  venue: string;\n  price?: string;\n  program_title?: string;\n  created_at: string;\n}\n\nconst Home: React.FC = () => {\n  const [announcements, setAnnouncements] = useState<Announcement[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [currentDate, setCurrentDate] = useState('');\n  const [currentTime, setCurrentTime] = useState('');\n\n  useEffect(() => {\n    setCurrentDate(persianDate.getCurrentDateTime());\n    setCurrentTime(new Date().toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    const timeInterval = setInterval(() => {\n      setCurrentTime(new Date().toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    }, 1000);\n    fetchAnnouncements();\n    return () => clearInterval(timeInterval);\n  }, []);\n\n  const fetchAnnouncements = async () => {\n    try {\n      const response = await axios.get('/api/announcements', {\n        params: { limit: 6, status: 'published' }\n      });\n      setAnnouncements(response.data);\n    } catch (error) {\n      console.error('Error fetching announcements:', error);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const getTodayAnnouncements = () => {\n    const todayGregorian = new Date().toISOString().split('T')[0];\n    return announcements.filter(ann => ann.date === todayGregorian);\n  };\n\n  const getRecentAnnouncements = () => {\n    return announcements.slice(0, 3);\n  };\n\n  if (loading) {\n    return (\n      <div className=\"home-container\">\n        <div className=\"loading\">در حال بارگذاری...</div>\n      </div>\n    );\n  }\n\n  const todayAnnouncements = getTodayAnnouncements();\n  const recentAnnouncements = getRecentAnnouncements();\n\n  return (\n    <div className=\"home-container\">\n      {/* Hero Section */}\n      <section className=\"hero-section\">\n        <div className=\"hero-content\">\n          <h1 className=\"hero-title\">سامانه مدیریت یکپارچه و هوشمند صدور آفیش رسا</h1>\n          <p className=\"hero-description\">\n            یک پلتفرم یکپارچه برای مدیریت هوشمند صدور آفیش – سامانه رسا\n          </p>\n          <div className=\"hero-stats\">\n            <div className=\"stat-item\">\n              <FaCalendarAlt className=\"stat-icon\" />\n              <div className=\"stat-info\">\n                <div className=\"stat-number\">{announcements.length}</div>\n        <div className=\"stat-label\">آفیش ثبت شده</div>\n              </div>\n            </div>\n            <div className=\"stat-item\">\n              <FaUsers className=\"stat-icon\" />\n              <div className=\"stat-info\">\n                <div className=\"stat-number\">{todayAnnouncements.length}</div>\n                <div className=\"stat-label\">برنامه امروز</div>\n              </div>\n            </div>\n          </div>\n          <div className=\"hero-actions\">\n            <Link to=\"/display\" className=\"btn btn-primary\">\n              <FaTheaterMasks />\n              مشاهده برنامه‌ها\n            </Link>\n            <Link to=\"/dashboard\" className=\"btn btn-secondary\">\n              داشبورد مدیریت\n            </Link>\n          </div>\n        </div>\n      </section>\n\n      {/* Current Date */}\n      <section className=\"date-section\">\n        <div className=\"date-display\">\n          <div className=\"date-item\">\n            <span className=\"date-label\">تاریخ امروز:</span>\n            <span className=\"date-value\">{currentDate}</span>\n          </div>\n          <div className=\"date-item\">\n            <span className=\"date-label\">روز هفته:</span>\n            <span className=\"date-value\">{persianDate.getDayName()}</span>\n          </div>\n          <div className=\"date-item\">\n            <span className=\"date-label\">ساعت اکنون:</span>\n            <span className=\"date-value\">{currentTime}</span>\n          </div>\n        </div>\n      </section>\n\n      {/* Today's Announcements */}\n      {todayAnnouncements.length > 0 && (\n        <section className=\"announcements-section\">\n          <h2 className=\"section-title\">برنامه‌های امروز</h2>\n          <div className=\"announcements-grid\">\n            {todayAnnouncements.map(announcement => (\n              <div key={announcement.id} className=\"announcement-card today\">\n                <div className=\"card-header\">\n                  <h3 className=\"card-title\">{announcement.title}</h3>\n                  <span className=\"time-badge\">{announcement.time}</span>\n                </div>\n                <p className=\"card-description\">{announcement.description}</p>\n                <div className=\"card-details\">\n                  <div className=\"detail-item\">\n                    <span className=\"detail-label\">مکان:</span>\n                    <span className=\"detail-value\">{announcement.venue}</span>\n                  </div>\n                  {announcement.price && (\n                    <div className=\"detail-item\">\n                      <span className=\"detail-label\">قیمت:</span>\n                      <span className=\"detail-value\">{announcement.price}</span>\n                    </div>\n                  )}\n                </div>\n                <div className=\"card-actions\">\n                  <Link to={`/poster/${announcement.id}`} className=\"btn btn-outline\">\n                    <FaDownload />\n                    دانلود پوستر\n                  </Link>\n                </div>\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Recent Announcements */}\n      {recentAnnouncements.length > 0 && (\n        <section className=\"announcements-section\">\n      <h2 className=\"section-title\">آخرین آفیش‌ها</h2>\n          <div className=\"announcements-grid\">\n            {recentAnnouncements.map(announcement => (\n              <div key={announcement.id} className=\"announcement-card\">\n                <div className=\"card-header\">\n                  <h3 className=\"card-title\">{announcement.title}</h3>\n                  <span className=\"date-badge\">{persianDate.toPersian(announcement.date)}</span>\n                </div>\n                <p className=\"card-description\">{announcement.description}</p>\n                <div className=\"card-details\">\n                  <div className=\"detail-item\">\n                    <span className=\"detail-label\">زمان:</span>\n                    <span className=\"detail-value\">{announcement.time}</span>\n                  </div>\n                  <div className=\"detail-item\">\n                    <span className=\"detail-label\">مکان:</span>\n                    <span className=\"detail-value\">{announcement.venue}</span>\n                  </div>\n                </div>\n                <div className=\"card-actions\">\n                  <Link to={`/poster/${announcement.id}`} className=\"btn btn-outline\">\n                    <FaDownload />\n                    مشاهده پوستر\n                  </Link>\n                </div>\n              </div>\n            ))}\n          </div>\n        </section>\n      )}\n\n      {/* Empty State */}\n      {announcements.length === 0 && (\n        <section className=\"empty-section\">\n          <div className=\"empty-content\">\n            <FaTheaterMasks className=\"empty-icon\" />\n      <h3>هنوز آفیشی ثبت نشده</h3>\n      <p>اولین آفیش خود را ایجاد کنید و برنامه‌های خود را مدیریت کنید.</p>\n            <Link to=\"/dashboard\" className=\"btn btn-primary\">\n              شروع کنید\n            </Link>\n          </div>\n        </section>\n      )}\n    </div>\n  );\n};\n\nexport default Home;","import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport {\n  FaTachometerAlt, FaUsers, FaCalendarAlt, FaFileAlt,\n  FaChartBar, FaCog, FaSignOutAlt, FaPlus, FaEye, FaEdit, FaTrash\n} from 'react-icons/fa';\nimport axios from 'axios';\nimport { useAuth } from '../contexts/AuthContext';\nimport './Dashboard.css';\n\nconst Dashboard: React.FC = () => {\n  const { logout } = useAuth();\n  const [stats, setStats] = useState({\n    totalAnnouncements: 0,\n    todayAnnouncements: 0,\n    totalActors: 0,\n    totalPrograms: 0\n  });\n  const [recentAnnouncements, setRecentAnnouncements] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [currentDate, setCurrentDate] = useState('');\n  const [currentTime, setCurrentTime] = useState('');\n\n  useEffect(() => {\n    fetchDashboardData();\n    // Live date/time\n    const now = new Date();\n    setCurrentDate(now.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }));\n    setCurrentTime(now.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    const dateInterval = setInterval(() => {\n      const d = new Date();\n      setCurrentDate(d.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }));\n    }, 60000);\n    const timeInterval = setInterval(() => {\n      const d = new Date();\n      setCurrentTime(d.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    }, 1000);\n    return () => {\n      clearInterval(dateInterval);\n      clearInterval(timeInterval);\n    };\n  }, []);\n\n  useEffect(() => {\n    const onKey = (e: KeyboardEvent) => {\n      if (e.ctrlKey || e.altKey || e.metaKey) return;\n      const k = e.key.toLowerCase();\n      if (k === 'n') { window.location.href = '/announcements/new'; }\n      if (k === 'a') { window.location.href = '/actors'; }\n      if (k === 'p') { window.location.href = '/programs'; }\n      if (k === 'd') { window.location.href = '/dashboard'; }\n    };\n    window.addEventListener('keydown', onKey);\n    return () => window.removeEventListener('keydown', onKey);\n  }, []);\n\n  const fetchDashboardData = async () => {\n    try {\n      const [announcementsRes, actorsRes, programsRes] = await Promise.all([\n        axios.get('/api/announcements'),\n        axios.get('/api/actors'),\n        axios.get('/api/programs')\n      ]);\n\n      const announcements = announcementsRes.data;\n      const today = new Date().toISOString().split('T')[0];\n      const todayCount = announcements.filter((a: any) => a.date === today).length;\n\n      setStats({\n        totalAnnouncements: announcements.length,\n        todayAnnouncements: todayCount,\n        totalActors: actorsRes.data.length,\n        totalPrograms: programsRes.data.length\n      });\n\n      setRecentAnnouncements(announcements.slice(0, 5));\n    } catch (error) {\n      toast.error('خطا در دریافت اطلاعات داشبورد');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDeleteAnnouncement = async (id: string) => {\n  if (window.confirm('آیا از حذف این آفیش مطمئن هستید؟')) {\n      try {\n        await axios.delete(`/api/announcements/${id}`);\n    toast.success('آفیش با موفقیت حذف شد');\n        fetchDashboardData();\n      } catch (error) {\n    toast.error('خطا در حذف آفیش');\n      }\n    }\n  };\n\n  const menuItems = [\n  { title: 'آفیش‌ها', icon: FaFileAlt, link: '/announcements', color: '#3498db' },\n    { title: 'عوامل', icon: FaUsers, link: '/actors', color: '#2ecc71' },\n    { title: 'برنامه‌ها', icon: FaCalendarAlt, link: '/programs', color: '#e74c3c' },\n    { title: 'نمایش عمومی', icon: FaEye, link: '/display', color: '#9b59b6' },\n  ];\n\n  if (loading) {\n    return (\n      <div className=\"dashboard-loading\">\n        <div className=\"loading-spinner\"></div>\n        <p>در حال بارگذاری...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"dashboard-container\">\n      <div className=\"dashboard-header\">\n        <h1>داشبورد مدیریت</h1>\n        <div className=\"header-actions\">\n          <div className=\"header-meta\">\n            <div className=\"current-date\">{currentDate}</div>\n            <div className=\"live-time\">{currentTime}</div>\n          </div>\n          <button onClick={logout} className=\"btn btn-danger\">\n            <FaSignOutAlt />\n            خروج\n          </button>\n        </div>\n      </div>\n\n      <div className=\"stats-grid\">\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#3498db' }}>\n            <FaFileAlt />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.totalAnnouncements}</h3>\n  <p>کل آفیش‌ها</p>\n          </div>\n        </div>\n\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#2ecc71' }}>\n            <FaCalendarAlt />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.todayAnnouncements}</h3>\n  <p>آفیش‌های امروز</p>\n          </div>\n        </div>\n\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#e74c3c' }}>\n            <FaUsers />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.totalActors}</h3>\n            <p>کل عوامل</p>\n          </div>\n        </div>\n\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#f39c12' }}>\n            <FaChartBar />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.totalPrograms}</h3>\n            <p>کل برنامه‌ها</p>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"dashboard-content\">\n        <div className=\"quick-actions\">\n          <h2>عملیات سریع</h2>\n          <div className=\"action-grid\">\n            {menuItems.map((item, index) => (\n              <Link key={index} to={item.link} className=\"action-card\" style={{ borderColor: item.color }}>\n                <div className=\"action-icon\" style={{ color: item.color }}>\n                  <item.icon />\n                </div>\n                <h3>{item.title}</h3>\n              </Link>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"recent-announcements\">\n          <div className=\"section-header\">\n  <h2>آخرین آفیش‌ها</h2>\n            <Link to=\"/announcements/new\" className=\"btn btn-success\">\n              <FaPlus />\n  آفیش جدید\n            </Link>\n          </div>\n\n          <div className=\"announcements-table\">\n            <table>\n              <thead>\n                <tr>\n                  <th>عنوان</th>\n                  <th>تاریخ</th>\n                  <th>زمان</th>\n                  <th>برنامه</th>\n                  <th>عملیات</th>\n                </tr>\n              </thead>\n              <tbody>\n                {recentAnnouncements.length === 0 ? (\n                  <tr>\n  <td colSpan={5} className=\"empty-message\">هیچ آفیشی یافت نشد</td>\n                  </tr>\n                ) : (\n                  recentAnnouncements.map((announcement: any) => (\n                    <tr key={announcement.id}>\n                      <td>{announcement.title}</td>\n                      <td>{announcement.date}</td>\n                      <td>{announcement.time}</td>\n                      <td>{announcement.program_title || '-'}</td>\n                      <td className=\"actions\">\n                        <Link to={`/announcements/${announcement.id}`} className=\"action-btn view\">\n                          <FaEye />\n                        </Link>\n                        <Link to={`/announcements/${announcement.id}/edit`} className=\"action-btn edit\">\n                          <FaEdit />\n                        </Link>\n                        <button\n                          onClick={() => handleDeleteAnnouncement(announcement.id)}\n                          className=\"action-btn delete\"\n                        >\n                          <FaTrash />\n                        </button>\n                      </td>\n                    </tr>\n                  ))\n                )}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Dashboard;\n","import React, { useState } from 'react';\nimport { useNavigate, Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport { FaUser, FaLock, FaSignInAlt } from 'react-icons/fa';\nimport { useAuth } from '../contexts/AuthContext';\nimport './Login.css';\nimport Logo from '../components/Logo';\n\nconst Login: React.FC = () => {\n  const [username, setUsername] = useState('');\n  const [password, setPassword] = useState('');\n  const [loading, setLoading] = useState(false);\n  const { login } = useAuth();\n  const navigate = useNavigate();\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!username || !password) {\n      toast.error('لطفاً نام کاربری و رمز عبور را وارد کنید');\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const success = await login(username, password);\n      if (success) {\n        toast.success('ورود موفقیت‌آمیز بود');\n        navigate('/dashboard');\n      } else {\n        toast.error('نام کاربری یا رمز عبور اشتباه است');\n      }\n    } catch (error) {\n      toast.error('خطا در ورود. لطفاً دوباره تلاش کنید');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"login-container\">\n      <div className=\"login-card\">\n        <div className=\"login-header\">\n          <div className=\"login-logo\">\n            <Logo src=\"/logo.png.jpg\" height={144} width={144} alt=\"لوگو\" />\n            <h1>ورود به سامانه رسا</h1>\n          </div>\n          <p className=\"login-subtitle\">به سامانه مدیریت یکپارچه و هوشمند صدور آفیش رسا خوش آمدید</p>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"login-form\">\n          <div className=\"form-group\">\n            <label htmlFor=\"username\" className=\"form-label\">\n              <FaUser />\n              نام کاربری\n            </label>\n            <input\n              type=\"text\"\n              id=\"username\"\n              value={username}\n              onChange={(e) => setUsername(e.target.value)}\n              className=\"form-input\"\n              placeholder=\"نام کاربری خود را وارد کنید\"\n              disabled={loading}\n            />\n          </div>\n\n          <div className=\"form-group\">\n            <label htmlFor=\"password\" className=\"form-label\">\n              <FaLock />\n              رمز عبور\n            </label>\n            <input\n              type=\"password\"\n              id=\"password\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              className=\"form-input\"\n              placeholder=\"رمز عبور خود را وارد کنید\"\n              disabled={loading}\n            />\n          </div>\n\n          <button type=\"submit\" className=\"login-btn\" disabled={loading}>\n            {loading ? (\n              <span className=\"loading-spinner\">در حال ورود...</span>\n            ) : (\n              <>\n                <FaSignInAlt />\n                ورود\n              </>\n            )}\n          </button>\n        </form>\n\n        <div className=\"login-footer\">\n          <p>رمز عبور پیش‌فرض: admin123</p>\n          <Link to=\"/\">بازگشت به صفحه اصلی</Link>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Login;\n","export const toPersianDigits = (input: string | number): string => {\n  const str = String(input);\n  const map: Record<string, string> = {\n    '0': '۰', '1': '۱', '2': '۲', '3': '۳', '4': '۴',\n    '5': '۵', '6': '۶', '7': '۷', '8': '۸', '9': '۹',\n  };\n  return str.replace(/[0-9]/g, (d) => map[d]);\n};\n\nexport const toEnglishDigits = (input: string): string => {\n  const map: Record<string, string> = {\n    '۰': '0', '۱': '1', '۲': '2', '۳': '3', '۴': '4',\n    '۵': '5', '۶': '6', '۷': '7', '۸': '8', '۹': '9',\n  };\n  return input.replace(/[۰-۹]/g, (d) => map[d] || d);\n};\n\n// Ensures HH:mm is normalized to English digits for backend\nexport const normalizeTime = (time: string): string => {\n  return toEnglishDigits(time.trim());\n};","import html2canvas from 'html2canvas';\nimport { jsPDF } from 'jspdf';\nimport persianDate from './persianDate';\n\nexport const announcementGenerator = {\n  // Generate poster HTML\n  generatePosterHTML(announcement) {\n    const {\n      title,\n      description,\n      date,\n      time,\n      venue,\n      price,\n      program_title,\n      program_type,\n      actors\n    } = announcement;\n    \n    const persianDateStr = persianDate.toPersian(date);\n    const dayName = persianDate.getDayName(date);\n    \n    return `\n      <div dir=\"rtl\" style=\"\n        width: 800px;\n        height: 1000px;\n        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        padding: 40px;\n        font-family: 'IRANSans', Tahoma, Arial, sans-serif;\n        color: white;\n        position: relative;\n        overflow: hidden;\n      \">\n        <!-- Decorative background -->\n        <div style=\"\n          position: absolute;\n          top: 0;\n          left: 0;\n          right: 0;\n          bottom: 0;\n          background: url('data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><circle cx=\"20\" cy=\"20\" r=\"2\" fill=\"rgba(255,255,255,0.1)\"/><circle cx=\"80\" cy=\"40\" r=\"1.5\" fill=\"rgba(255,255,255,0.1)\"/><circle cx=\"40\" cy=\"80\" r=\"1\" fill=\"rgba(255,255,255,0.1)\"/></svg>');\n          z-index: 1;\n        \"></div>\n        \n        <!-- Main content -->\n        <div style=\"position: relative; z-index: 2; height: 100%;\">\n          <!-- Header -->\n          <div style=\"\n            text-align: center;\n            margin-bottom: 40px;\n            border-bottom: 2px solid rgba(255,255,255,0.3);\n            padding-bottom: 20px;\n          \">\n            <h1 style=\"\n              font-size: 48px;\n              margin: 0 0 10px 0;\n              font-weight: bold;\n              text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n            \">${title}</h1>\n            ${program_title ? `<h2 style=\"\n              font-size: 32px;\n              margin: 0;\n              font-weight: normal;\n              color: rgba(255,255,255,0.9);\n            \">${program_title}</h2>` : ''}\n          </div>\n          \n          <!-- Date and Time Section -->\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n          \">\n            <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n              <div style=\"text-align: center;\">\n                <div style=\"font-size: 24px; font-weight: bold; margin-bottom: 5px;\">${dayName}</div>\n                <div style=\"font-size: 28px;\">${persianDateStr}</div>\n              </div>\n              <div style=\"text-align: center;\">\n                <div style=\"font-size: 20px; margin-bottom: 5px;\">ساعت</div>\n                <div style=\"font-size: 32px; font-weight: bold;\">${time}</div>\n              </div>\n            </div>\n          </div>\n          \n          <!-- Venue Section -->\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 10px;\">📍 محل برگزاری</div>\n            <div style=\"font-size: 24px; font-weight: bold;\">${venue}</div>\n          </div>\n          \n          <!-- Description -->\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n            min-height: 150px;\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 15px;\">📝 توضیحات</div>\n            <div style=\"font-size: 18px; line-height: 1.6;\">${description}</div>\n          </div>\n          \n          <!-- Actors Section -->\n          ${actors && actors.length > 0 ? `\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 15px;\">🎭 عوامل</div>\n            <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\">\n              ${actors.map(actor => `\n                <div style=\"font-size: 16px;\">\n                  <strong>${actor.name}</strong>\n                  ${actor.role_in_program ? `<br><small>${actor.role_in_program}</small>` : ''}\n                </div>\n              `).join('')}\n            </div>\n          </div>\n          ` : ''}\n          \n          <!-- Price Section -->\n          ${price ? `\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            backdrop-filter: blur(10px);\n            text-align: center;\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 10px;\">💰 قیمت بلیت</div>\n            <div style=\"font-size: 32px; font-weight: bold; color: #FFD700;\">${price}</div>\n          </div>\n          ` : ''}\n          \n          <!-- Footer -->\n          <div style=\"\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            text-align: center;\n            padding: 20px;\n            border-top: 2px solid rgba(255,255,255,0.3);\n          \">\n            <div style=\"font-size: 16px; opacity: 0.8;\">\n              تهیه شده با سامانه رسا\n            </div>\n            <div style=\"font-size: 14px; opacity: 0.6; margin-top: 5px;\">\n              ${persianDate.getCurrentDateTime()}\n            </div>\n          </div>\n        </div>\n      </div>\n    `;\n  },\n  \n  // Generate poster image\n  async generatePosterImage(announcement) {\n    const html = this.generatePosterHTML(announcement);\n    \n    // Create temporary container\n    const container = document.createElement('div');\n    container.innerHTML = html;\n    container.style.position = 'absolute';\n    container.style.left = '-9999px';\n    container.style.top = '-9999px';\n    document.body.appendChild(container);\n    \n    try {\n      const canvas = await html2canvas(container, {\n        width: 800,\n        height: 1000,\n        scale: 2,\n        backgroundColor: null,\n        useCORS: true,\n        allowTaint: true\n      });\n      \n      document.body.removeChild(container);\n      return canvas.toDataURL('image/png', 1.0);\n    } catch (error) {\n      document.body.removeChild(container);\n      throw error;\n    }\n  },\n  \n  // Generate PDF\n  async generatePDF(announcement) {\n    const imageData = await this.generatePosterImage(announcement);\n    \n    const pdf = new jsPDF({\n      orientation: 'portrait',\n      unit: 'mm',\n      format: 'a4'\n    });\n    \n    // Calculate dimensions to fit A4\n    const pdfWidth = 210; // A4 width in mm\n    const pdfHeight = 297; // A4 height in mm\n    const imageWidth = 800;\n    const imageHeight = 1000;\n    \n    // Calculate scaling to fit the page\n    const scale = Math.min(pdfWidth / imageWidth, pdfHeight / imageHeight) * 25.4; // Convert pixels to mm\n    const width = imageWidth * scale / 25.4;\n    const height = imageHeight * scale / 25.4;\n    \n    // Center the image\n    const x = (pdfWidth - width) / 2;\n    const y = (pdfHeight - height) / 2;\n    \n    pdf.addImage(imageData, 'PNG', x, y, width, height);\n    \n    return pdf.output('blob');\n  }\n};\n\nexport default announcementGenerator;","import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport {\n  FaPlus, FaEye, FaEdit, FaTrash, FaSearch, FaCalendar,\n  FaDownload, FaPrint, FaFilePdf\n} from 'react-icons/fa';\nimport axios from 'axios';\nimport DateObject from 'react-date-object';\nimport persian from 'react-date-object/calendars/persian';\nimport gregorian from 'react-date-object/calendars/gregorian';\nimport DatePicker from 'react-multi-date-picker';\nimport { toPersianDigits } from '../utils/locale';\nimport announcementGenerator from '../utils/announcementGenerator';\nimport './Announcements.css';\n\nconst Announcements: React.FC = () => {\n  const [announcements, setAnnouncements] = useState([]);\n  const [filteredAnnouncements, setFilteredAnnouncements] = useState([]);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [dateFilter, setDateFilter] = useState('');\n  const [statusFilter, setStatusFilter] = useState<string>('');\n  const [presetName, setPresetName] = useState('');\n  const [presets, setPresets] = useState<Array<{ name: string; search: string; date: string; status: string }>>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchAnnouncements();\n    const saved = localStorage.getItem('ann_filter_presets');\n    if (saved) {\n      try { setPresets(JSON.parse(saved)); } catch { }\n    }\n  }, []);\n\n  useEffect(() => {\n    filterAnnouncements();\n  }, [announcements, searchTerm, dateFilter]);\n\n  const fetchAnnouncements = async () => {\n    try {\n      const response = await axios.get('/api/announcements');\n      setAnnouncements(response.data);\n    } catch (error) {\n      toast.error('خطا در دریافت آفیش‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const filterAnnouncements = () => {\n    let filtered = announcements;\n\n    if (searchTerm) {\n      filtered = filtered.filter((announcement: any) =>\n        announcement.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        (announcement.program_title || announcement.program?.name || '')\n          .toLowerCase().includes(searchTerm.toLowerCase()) ||\n        announcement.actors?.some((actor: any) =>\n          actor.name.toLowerCase().includes(searchTerm.toLowerCase())\n        )\n      );\n    }\n\n    if (dateFilter) {\n      filtered = filtered.filter((announcement: any) =>\n        announcement.date === dateFilter\n      );\n    }\n\n    if (statusFilter) {\n      filtered = filtered.filter((announcement: any) =>\n        (announcement.status || '') === statusFilter\n      );\n    }\n\n    setFilteredAnnouncements(filtered);\n  };\n\n  const handleDelete = async (id: string) => {\n    if (window.confirm('آیا از حذف این آفیش مطمئن هستید؟')) {\n      try {\n        // Optimistic UI\n        const prev = announcements;\n        setAnnouncements((list: any) => list.filter((a: any) => a.id !== id));\n        setFilteredAnnouncements((list: any) => list.filter((a: any) => a.id !== id));\n        const token = localStorage.getItem('token');\n        await axios.delete(`/api/announcements/${id}`, {\n          headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n        });\n        toast.success('آفیش با موفقیت حذف شد');\n      } catch (error) {\n        toast.error('خطا در حذف آفیش؛ بازگشت به حالت قبل');\n        fetchAnnouncements();\n      }\n    }\n  };\n\n  const savePreset = () => {\n    if (!presetName.trim()) { toast.error('نام پرِست را وارد کنید'); return; }\n    const next = presets.filter(p => p.name !== presetName).concat([{ name: presetName, search: searchTerm, date: dateFilter, status: statusFilter }]);\n    setPresets(next);\n    localStorage.setItem('ann_filter_presets', JSON.stringify(next));\n    toast.success('پرِست ذخیره شد');\n  };\n\n  const applyPreset = (p: { name: string; search: string; date: string; status: string }) => {\n    setSearchTerm(p.search);\n    setDateFilter(p.date);\n    setStatusFilter(p.status);\n  };\n\n  const handlePrint = async (announcement: any) => {\n    try {\n      await announcementGenerator.generatePDF(announcement);\n      toast.success('فایل PDF با موفقیت ایجاد شد');\n    } catch (error) {\n      toast.error('خطا در ایجاد فایل PDF');\n    }\n  };\n\n  const formatDate = (dateString: string) => {\n    try {\n      const obj = new DateObject({ date: new Date(dateString) });\n      return obj.convert(persian).format('YYYY/MM/DD');\n    } catch {\n      return dateString;\n    }\n  };\n\n  const formatTime = (timeString: string) => {\n    return toPersianDigits(timeString || '');\n  };\n\n  if (loading) {\n    return (\n      <div className=\"announcements-container\">\n        <div className=\"page-header\">\n          <h1>مدیریت آفیش‌ها</h1>\n          <button className=\"add-btn\" disabled>\n            <FaPlus />\n            آفیش جدید\n          </button>\n        </div>\n        <div className=\"filters-section skeleton-block\" />\n        <div className=\"announcements-grid\">\n          {Array.from({ length: 6 }).map((_, i) => (\n            <div key={i} className=\"announcement-card skeleton\">\n              <div className=\"skeleton-title\" />\n              <div className=\"skeleton-line\" />\n              <div className=\"skeleton-line\" />\n              <div className=\"skeleton-line short\" />\n              <div className=\"card-footer\">\n                <div className=\"skeleton-badge\" />\n                <div className=\"skeleton-small\" />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"announcements-container\">\n      <div className=\"page-header\">\n        <h1>مدیریت آفیش‌ها</h1>\n        <Link to=\"/announcements/new\" className=\"add-btn\">\n          <FaPlus />\n          آفیش جدید\n        </Link>\n      </div>\n\n      <div className=\"filters-section\">\n        <div className=\"search-box\">\n          <FaSearch />\n          <input\n            type=\"text\"\n            placeholder=\"جستجو در عنوان، برنامه یا عوامل...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"search-input\"\n          />\n        </div>\n        <div className=\"date-filter\">\n          <FaCalendar />\n          <DatePicker\n            calendar={persian}\n            inputClass=\"date-input\"\n            value={dateFilter ? new DateObject({ date: new Date(dateFilter) }).convert(persian) : null}\n            onChange={(val: any) => {\n              if (!val) { setDateFilter(''); return; }\n              try {\n                const obj = val instanceof DateObject ? val : new DateObject(val);\n                const g = obj.convert(gregorian).format('YYYY-MM-DD');\n                setDateFilter(g);\n              } catch {\n                toast.error('خطا در تنظیم فیلتر تاریخ');\n              }\n            }}\n            format=\"YYYY/MM/DD\"\n            placeholder=\"فیلتر تاریخ (شمسی)\"\n          />\n          {dateFilter && (\n            <button\n              onClick={() => setDateFilter('')}\n              className=\"clear-date-btn\"\n            >\n              حذف فیلتر\n            </button>\n          )}\n        </div>\n        <div className=\"status-filter\">\n          <select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value)} className=\"status-select\">\n            <option value=\"\">همه وضعیت‌ها</option>\n            <option value=\"published\">منتشر شده</option>\n            <option value=\"draft\">پیش‌نویس</option>\n          </select>\n        </div>\n        <div className=\"preset-controls\">\n          <input type=\"text\" value={presetName} onChange={(e) => setPresetName(e.target.value)} placeholder=\"نام پرِست\" className=\"preset-input\" />\n          <button className=\"btn btn-light\" onClick={savePreset}>ذخیره پرِست</button>\n          {presets.length > 0 && (\n            <select onChange={(e) => { const p = presets.find(pp => pp.name === e.target.value); if (p) applyPreset(p); }} className=\"preset-select\">\n              <option value=\"\">اعمال پرِست...</option>\n              {presets.map(p => (<option key={p.name} value={p.name}>{p.name}</option>))}\n            </select>\n          )}\n        </div>\n      </div>\n\n      <div className=\"announcements-grid\">\n        {filteredAnnouncements.length === 0 ? (\n          <div className=\"empty-state\">\n            <FaFilePdf />\n            <p>هیچ آفیشی یافت نشد</p>\n            <Link to=\"/announcements/new\" className=\"create-first-btn\">\n              ایجاد اولین آفیش\n            </Link>\n          </div>\n        ) : (\n          filteredAnnouncements.map((announcement: any) => (\n            <div key={announcement.id} className=\"announcement-card\">\n              <div className=\"card-header\">\n                <h3>{announcement.title}</h3>\n                <div className=\"card-actions\">\n                  <button\n                    onClick={() => handlePrint(announcement)}\n                    className=\"action-btn print\"\n                    title=\"چاپ/دانلود PDF\"\n                  >\n                    <FaDownload />\n                  </button>\n                  <Link\n                    to={`/announcements/${announcement.id}`}\n                    className=\"action-btn view\"\n                    title=\"مشاهده\"\n                  >\n                    <FaEye />\n                  </Link>\n                  <Link\n                    to={`/announcements/${announcement.id}/edit`}\n                    className=\"action-btn edit\"\n                    title=\"ویرایش\"\n                  >\n                    <FaEdit />\n                  </Link>\n                  <button\n                    onClick={() => handleDelete(announcement.id)}\n                    className=\"action-btn delete\"\n                    title=\"حذف\"\n                  >\n                    <FaTrash />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"card-content\">\n                <div className=\"info-row\">\n                  <span className=\"label\">برنامه:</span>\n                  <span className=\"value\">{announcement.program_title || 'بدون برنامه'}</span>\n                </div>\n                <div className=\"info-row\">\n                  <span className=\"label\">تاریخ:</span>\n                  <span className=\"value\">{formatDate(announcement.date)}</span>\n                </div>\n                <div className=\"info-row\">\n                  <span className=\"label\">زمان:</span>\n                  <span className=\"value\">{formatTime(announcement.time)}</span>\n                </div>\n                <div className=\"info-row\">\n                  <span className=\"label\">مکان:</span>\n                  <span className=\"value\">{announcement.venue || 'ثبت نشده'}</span>\n                </div>\n                {/* نمایش عوامل در فهرست نیازمند دریافت جداگانه است؛ فعلاً پنهان می‌ماند */}\n                {announcement.description && (\n                  <div className=\"info-row\">\n                    <span className=\"label\">توضیحات:</span>\n                    <span className=\"value description\">{announcement.description}</span>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"card-footer\">\n                <div className=\"status-badge\">\n                  {announcement.status === 'published' ? 'منتشر شده' : 'پیش‌نویس'}\n                </div>\n                <div className=\"created-info\">\n                  ایجاد شده در: {formatDate(announcement.created_at?.split('T')[0])}\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Announcements;\n","import React, { useState, useEffect } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport { FaSave, FaTimes } from 'react-icons/fa';\nimport axios from 'axios';\nimport './AnnouncementForm.css';\nimport DatePicker from 'react-multi-date-picker';\nimport TimePicker from 'react-multi-date-picker/plugins/time_picker';\nimport persian from 'react-date-object/calendars/persian';\nimport DateObject from 'react-date-object';\nimport gregorian from 'react-date-object/calendars/gregorian';\nimport { normalizeTime } from '../utils/locale';\n\nconst AnnouncementForm: React.FC = () => {\n  const navigate = useNavigate();\n  const { id } = useParams<{ id: string }>();\n  const isEdit = Boolean(id);\n\n  const [formData, setFormData] = useState({\n    title: '',\n    description: '',\n    date: '',\n    time: '',\n    location: '',\n    programId: '',\n    actorIds: [] as string[]\n  });\n  const [status, setStatus] = useState<'draft' | 'published'>('draft');\n\n  const [loading, setLoading] = useState(false);\n  const [programs, setPrograms] = useState<any[]>([]);\n  const [actors, setActors] = useState<any[]>([]);\n  const [actorRoles, setActorRoles] = useState<Record<string, string>>({});\n\n  useEffect(() => {\n    if (isEdit) {\n      fetchAnnouncement();\n    }\n    // Load programs and actors\n    const loadOptions = async () => {\n      try {\n        const [progRes, actRes] = await Promise.all([\n          axios.get('/api/programs', { params: { limit: 100 } }),\n          axios.get('/api/actors', { params: { limit: 100 } })\n        ]);\n        setPrograms(progRes.data);\n        setActors(actRes.data);\n      } catch (err) {\n        // silent fail\n      }\n    };\n    loadOptions();\n    const draft = localStorage.getItem('announcement_draft');\n    if (!isEdit && draft) {\n      try {\n        const d = JSON.parse(draft);\n        setFormData(d.formData || formData);\n        setStatus(d.status || 'draft');\n      } catch { }\n    }\n  }, [id]);\n\n  const fetchAnnouncement = async () => {\n    try {\n      const response = await axios.get(`/api/announcements/${id}`);\n      const announcement = response.data;\n      setFormData({\n        title: announcement.title,\n        description: announcement.description,\n        date: announcement.date,\n        time: announcement.time,\n        location: announcement.venue,\n        programId: announcement.program_id ? String(announcement.program_id) : '',\n        actorIds: announcement.actors?.map((actor: any) => actor.id) || []\n      });\n    } catch (error) {\n      toast.error('خطا در دریافت اطلاعات آفیش');\n      navigate('/announcements');\n    }\n  };\n\n  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {\n    const { name, value } = e.target;\n    setFormData(prev => ({\n      ...prev,\n      [name]: value\n    }));\n    setTimeout(() => {\n      localStorage.setItem('announcement_draft', JSON.stringify({ formData: { ...formData, [name]: value }, status }));\n    }, 0);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.title || !formData.description || !formData.date || !formData.time || !formData.location) {\n      toast.error('لطفاً فیلدهای الزامی را پر کنید');\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const token = localStorage.getItem('token');\n      const payload = {\n        title: formData.title,\n        description: formData.description,\n        program_id: formData.programId || null,\n        date: formData.date,\n        time: normalizeTime(formData.time),\n        venue: formData.location,\n        price: null,\n        actor_ids: formData.actorIds || [],\n        actor_roles: (formData.actorIds || []).map(aid => actorRoles[aid] || null),\n        status,\n      };\n\n      if (isEdit) {\n        await axios.put(`/api/announcements/${id}`, payload, {\n          headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n        });\n        toast.success('آفیش با موفقیت ویرایش شد');\n      } else {\n        await axios.post('/api/announcements', payload, {\n          headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n        });\n        toast.success('آفیش با موفقیت ایجاد شد');\n      }\n\n      navigate('/announcements');\n      localStorage.removeItem('announcement_draft');\n    } catch (error) {\n      toast.error(isEdit ? 'خطا در ویرایش آفیش' : 'خطا در ایجاد آفیش');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"announcement-form-container\">\n      <h2>{isEdit ? 'ویرایش آفیش' : 'ایجاد آفیش جدید'}</h2>\n\n      <form onSubmit={handleSubmit} className=\"announcement-form\">\n        <div className=\"form-group\">\n          <label htmlFor=\"title\">عنوان آفیش *</label>\n          <input\n            type=\"text\"\n            id=\"title\"\n            name=\"title\"\n            value={formData.title}\n            onChange={handleInputChange}\n            className=\"form-input\"\n            required\n          />\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"status\">وضعیت</label>\n          <select id=\"status\" value={status} onChange={(e) => { setStatus(e.target.value as any); localStorage.setItem('announcement_draft', JSON.stringify({ formData, status: e.target.value })); }} className=\"form-select\">\n            <option value=\"draft\">پیش‌نویس</option>\n            <option value=\"published\">منتشر شده</option>\n          </select>\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"description\">توضیحات</label>\n          <textarea\n            id=\"description\"\n            name=\"description\"\n            value={formData.description}\n            onChange={handleInputChange}\n            className=\"form-textarea\"\n            rows={4}\n          />\n        </div>\n\n        <div className=\"form-row\">\n          <div className=\"form-group\">\n            <label htmlFor=\"date\">تاریخ *</label>\n            <DatePicker\n              calendar={persian}\n              inputClass=\"form-input\"\n              value={formData.date ? new DateObject({ date: new Date(formData.date) }).convert(persian) : null}\n              onChange={(val: any) => {\n                if (!val) {\n                  setFormData(prev => ({ ...prev, date: '' }));\n                  return;\n                }\n                try {\n                  const obj = val instanceof DateObject ? val : new DateObject(val);\n                  const greg = obj.convert(gregorian).format('YYYY-MM-DD');\n                  setFormData(prev => ({ ...prev, date: greg }));\n                } catch {\n                  toast.error('خطا در تنظیم تاریخ');\n                }\n              }}\n              format=\"YYYY/MM/DD\"\n              placeholder=\"انتخاب تاریخ به تقویم شمسی\"\n              required\n            />\n          </div>\n\n          <div className=\"form-group\">\n            <label htmlFor=\"time\">زمان *</label>\n            <DatePicker\n              calendar={persian}\n              format=\"HH:mm\"\n              inputClass=\"form-input\"\n              disableDayPicker\n              plugins={[<TimePicker hideSeconds />]}\n              value={formData.time || undefined}\n              onChange={(val: any) => {\n                if (!val) {\n                  setFormData(prev => ({ ...prev, time: '' }));\n                  return;\n                }\n                try {\n                  const obj = val instanceof DateObject ? val : new DateObject(val);\n                  const time = obj.format('HH:mm');\n                  setFormData(prev => ({ ...prev, time }));\n                } catch {\n                  toast.error('خطا در تنظیم زمان');\n                }\n              }}\n              placeholder=\"انتخاب زمان (فارسی)\"\n              required\n            />\n          </div>\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"location\">مکان</label>\n          <input\n            type=\"text\"\n            id=\"location\"\n            name=\"location\"\n            value={formData.location}\n            onChange={handleInputChange}\n            className=\"form-input\"\n          />\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"programId\">برنامه مرتبط</label>\n          <select\n            id=\"programId\"\n            name=\"programId\"\n            value={formData.programId}\n            onChange={handleInputChange}\n            className=\"form-select\"\n          >\n            <option value=\"\">بدون برنامه</option>\n            {programs.map((p: any) => (\n              <option key={p.id} value={String(p.id)}>{p.title}</option>\n            ))}\n          </select>\n        </div>\n\n        <div className=\"form-group\">\n          <label>انتخاب عوامل و نقش در برنامه</label>\n          <div className=\"actors-grid\">\n            {actors.map((a: any) => {\n              const checked = formData.actorIds.includes(String(a.id));\n              return (\n                <div className=\"actor-checkbox\" key={a.id}>\n                  <input\n                    type=\"checkbox\"\n                    checked={checked}\n                    onChange={(e) => {\n                      const isChecked = e.target.checked;\n                      setFormData(prev => ({\n                        ...prev,\n                        actorIds: isChecked\n                          ? [...prev.actorIds, String(a.id)]\n                          : prev.actorIds.filter(id => id !== String(a.id))\n                      }));\n                    }}\n                  />\n                  <label>{a.name} <span className=\"actor-role\">({a.role})</span></label>\n                  {checked && (\n                    <input\n                      type=\"text\"\n                      placeholder=\"نقش در برنامه\"\n                      value={actorRoles[String(a.id)] || ''}\n                      onChange={(e) => setActorRoles(prev => ({ ...prev, [String(a.id)]: e.target.value }))}\n                      className=\"form-input\"\n                      style={{ maxWidth: '180px' }}\n                    />\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        <div className=\"form-actions\">\n          <button type=\"submit\" className=\"save-btn\" disabled={loading}>\n            {loading ? (\n              <span>در حال ذخیره...</span>\n            ) : (\n              <>\n                <FaSave />\n                {isEdit ? 'ویرایش آفیش' : 'ایجاد آفیش'}\n              </>\n            )}\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => navigate('/announcements')}\n            className=\"cancel-btn\"\n            disabled={loading}\n          >\n            <FaTimes />\n            انصراف\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => { localStorage.setItem('announcement_draft', JSON.stringify({ formData, status })); toast.success('پیش‌نویس ذخیره شد'); }}\n            className=\"save-btn\"\n            disabled={loading}\n            style={{ marginInlineStart: '8px' }}\n          >\n            ذخیره پیش‌نویس\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n};\n\nexport default AnnouncementForm;\n","import React from 'react';\nimport AnnouncementForm from './AnnouncementForm';\n\nconst CreateAnnouncement: React.FC = () => {\n  return <AnnouncementForm />;\n};\n\nexport default CreateAnnouncement;","import React, { useEffect, useState } from 'react';\nimport { useParams, useNavigate, Link } from 'react-router-dom';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport DateObject from 'react-date-object';\nimport persian from 'react-date-object/calendars/persian';\nimport { toPersianDigits } from '../utils/locale';\nimport { FaCalendarAlt, FaClock, FaMapMarkerAlt, FaEdit, FaTrash } from 'react-icons/fa';\n\nconst AnnouncementDetail: React.FC = () => {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const [announcement, setAnnouncement] = useState<any>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    const fetchData = async () => {\n      try {\n        const res = await axios.get(`/api/announcements/${id}`);\n        setAnnouncement(res.data);\n      } catch (err) {\n    toast.error('خطا در دریافت آفیش');\n        navigate('/announcements');\n      } finally {\n        setLoading(false);\n      }\n    };\n    fetchData();\n  }, [id, navigate]);\n\n  const handleDelete = async () => {\n    if (!id) return;\n  if (!window.confirm('آیا از حذف این آفیش مطمئن هستید؟')) return;\n    try {\n      const token = localStorage.getItem('token');\n      await axios.delete(`/api/announcements/${id}`, {\n        headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n      });\n    toast.success('آفیش با موفقیت حذف شد');\n      navigate('/announcements');\n    } catch (err) {\n    toast.error('حذف آفیش با خطا مواجه شد');\n    }\n  };\n\n  const formatDateFa = (dateStr: string) => {\n    try {\n      const obj = new DateObject({ date: new Date(dateStr) });\n      return obj.convert(persian).format('YYYY/MM/DD');\n    } catch { return dateStr; }\n  };\n\n  if (loading) {\n    return <div className=\"loading-container\"><div className=\"loading-spinner\"></div><p>در حال بارگذاری...</p></div>;\n  }\n\n  if (!announcement) {\n  return <div className=\"container p-4\">آفیش یافت نشد</div>;\n  }\n\n  return (\n    <div className=\"container p-4\">\n      <div className=\"card\">\n        <div className=\"card-body\">\n          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>\n            <h1 style={{ margin: 0 }}>{announcement.title}</h1>\n            <div style={{ display: 'flex', gap: '8px' }}>\n              <Link to={`/announcements/${id}/edit`} className=\"btn btn-outline\">\n                <FaEdit /> ویرایش\n              </Link>\n              <button className=\"btn btn-danger\" onClick={handleDelete}>\n                <FaTrash /> حذف\n              </button>\n            </div>\n          </div>\n\n          {announcement.description && (\n            <p style={{ marginTop: '12px' }}>{announcement.description}</p>\n          )}\n\n          <div className=\"announcement-details\" style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: '10px', marginTop: '12px' }}>\n            <div className=\"detail-item\"><FaCalendarAlt /> <span>{formatDateFa(announcement.date)}</span></div>\n            <div className=\"detail-item\"><FaClock /> <span>{toPersianDigits(announcement.time)}</span></div>\n            <div className=\"detail-item\"><FaMapMarkerAlt /> <span>{announcement.venue}</span></div>\n          </div>\n\n          <div style={{ marginTop: '16px' }}>\n            <h3>برنامه</h3>\n            <p>{announcement.program_title || 'بدون برنامه'}</p>\n            {announcement.program_description && <p>{announcement.program_description}</p>}\n          </div>\n\n          {announcement.actors && announcement.actors.length > 0 && (\n            <div style={{ marginTop: '16px' }}>\n              <h3>عوامل</h3>\n              <ul>\n                {announcement.actors.map((actor: any) => (\n                  <li key={actor.id}>{actor.name}{actor.role_in_program ? ` - ${actor.role_in_program}` : ''}</li>\n                ))}\n              </ul>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default AnnouncementDetail;\n","import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport { FaPlus, FaEdit, FaTrash, FaSearch, FaUser } from 'react-icons/fa';\nimport axios from 'axios';\nimport './Actors.css';\nimport { toPersianDigits } from '../utils/locale';\n\nconst Actors: React.FC = () => {\n  const [actors, setActors] = useState([]);\n  const [filteredActors, setFilteredActors] = useState([]);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [roleFilter, setRoleFilter] = useState('');\n  const [presets, setPresets] = useState<Array<{ name: string; search: string; role: string }>>([]);\n  const [presetName, setPresetName] = useState('');\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchActors();\n    const saved = localStorage.getItem('actors_filter_presets');\n    if (saved) { try { setPresets(JSON.parse(saved)); } catch { } }\n  }, []);\n\n  useEffect(() => {\n    filterActors();\n  }, [actors, searchTerm]);\n\n  const fetchActors = async () => {\n    try {\n      const response = await axios.get('/api/actors');\n      setActors(response.data);\n    } catch (error) {\n      toast.error('خطا در دریافت لیست عوامل');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const filterActors = () => {\n    let filtered = actors;\n\n    if (searchTerm) {\n      filtered = filtered.filter((actor: any) =>\n        actor.name.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        actor.role?.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        actor.phone?.includes(searchTerm) ||\n        actor.email?.toLowerCase().includes(searchTerm.toLowerCase())\n      );\n    }\n\n    if (roleFilter) {\n      filtered = filtered.filter((actor: any) => (actor.role || '').toLowerCase() === roleFilter.toLowerCase());\n    }\n\n    setFilteredActors(filtered);\n  };\n\n  const savePreset = () => {\n    if (!presetName.trim()) { toast.error('نام پرِست را وارد کنید'); return; }\n    const next = presets.filter(p => p.name !== presetName).concat([{ name: presetName, search: searchTerm, role: roleFilter }]);\n    setPresets(next);\n    localStorage.setItem('actors_filter_presets', JSON.stringify(next));\n    toast.success('پرِست ذخیره شد');\n  };\n\n  const applyPreset = (name: string) => {\n    const p = presets.find(pp => pp.name === name);\n    if (p) { setSearchTerm(p.search); setRoleFilter(p.role); }\n  };\n\n  const handleDelete = async (id: string) => {\n    if (window.confirm('آیا از حذف این عامل مطمئن هستید؟')) {\n      try {\n        await axios.delete(`/api/actors/${id}`);\n        toast.success('عامل با موفقیت حذف شد');\n        fetchActors();\n      } catch (error) {\n        toast.error('خطا در حذف عامل');\n      }\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"actors-container\">\n        <div className=\"page-header\">\n          <h1>مدیریت عوامل</h1>\n          <button className=\"btn btn-success\" disabled>\n            <FaPlus />\n            عامل جدید\n          </button>\n        </div>\n        <div className=\"filters-section skeleton-block\" />\n        <div className=\"actors-grid\">\n          {Array.from({ length: 6 }).map((_, i) => (\n            <div key={i} className=\"actor-card skeleton\">\n              <div className=\"card-header\">\n                <div className=\"actor-info\">\n                  <div className=\"actor-avatar skeleton-avatar\" />\n                  <div style={{ flex: 1 }}>\n                    <div className=\"skeleton-title\" />\n                    <div className=\"skeleton-small\" />\n                  </div>\n                </div>\n                <div className=\"card-actions\">\n                  <div className=\"skeleton-small\" style={{ width: 35, height: 35 }} />\n                  <div className=\"skeleton-small\" style={{ width: 35, height: 35 }} />\n                </div>\n              </div>\n              <div className=\"card-content\">\n                <div className=\"skeleton-line\" />\n                <div className=\"skeleton-line\" />\n                <div className=\"skeleton-line short\" />\n              </div>\n              <div className=\"card-footer\">\n                <div className=\"skeleton-small\" />\n                <div className=\"skeleton-badge\" />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"actors-container\">\n      <div className=\"page-header\">\n        <h1>مدیریت عوامل</h1>\n        <Link to=\"/actors/new\" className=\"btn btn-success\">\n          <FaPlus />\n          عامل جدید\n        </Link>\n      </div>\n\n      <div className=\"filters-section\">\n        <div className=\"search-box\">\n          <FaSearch />\n          <input\n            type=\"text\"\n            placeholder=\"جستجو در نام، نقش، تلفن یا ایمیل...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"search-input\"\n          />\n        </div>\n        <div className=\"status-filter\" style={{ display: 'flex', gap: '8px', alignItems: 'center' }}>\n          <input\n            type=\"text\"\n            placeholder=\"فیلتر نقش دقیق (مثلاً کارگردان)\"\n            value={roleFilter}\n            onChange={(e) => setRoleFilter(e.target.value)}\n            className=\"search-input\"\n            style={{ maxWidth: '240px' }}\n          />\n          <input type=\"text\" value={presetName} onChange={(e) => setPresetName(e.target.value)} placeholder=\"نام پرِست\" className=\"preset-input\" />\n          <button className=\"btn btn-light\" onClick={savePreset}>ذخیره پرِست</button>\n          {presets.length > 0 && (\n            <select onChange={(e) => applyPreset(e.target.value)} className=\"preset-select\">\n              <option value=\"\">اعمال پرِست...</option>\n              {presets.map(p => (<option key={p.name} value={p.name}>{p.name}</option>))}\n            </select>\n          )}\n        </div>\n      </div>\n\n      <div className=\"actors-grid\">\n        {filteredActors.length === 0 ? (\n          <div className=\"empty-state\">\n            <FaUser />\n            <p>هیچ عاملی یافت نشد</p>\n            <Link to=\"/actors/new\" className=\"btn btn-success\">\n              ایجاد اولین عامل\n            </Link>\n          </div>\n        ) : (\n          filteredActors.map((actor: any) => (\n            <div key={actor.id} className=\"actor-card\">\n              <div className=\"card-header\">\n                <div className=\"actor-info\">\n                  <div className=\"actor-avatar\">\n                    <FaUser />\n                  </div>\n                  <div className=\"actor-details\">\n                    <h3>{actor.name}</h3>\n                    {actor.role && <p className=\"actor-role\">{actor.role}</p>}\n                  </div>\n                </div>\n                <div className=\"card-actions\">\n                  <Link\n                    to={`/actors/${actor.id}/edit`}\n                    className=\"action-btn edit\"\n                    title=\"ویرایش\"\n                  >\n                    <FaEdit />\n                  </Link>\n                  <button\n                    onClick={() => handleDelete(actor.id)}\n                    className=\"action-btn delete\"\n                    title=\"حذف\"\n                  >\n                    <FaTrash />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"card-content\">\n                {actor.phone && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">تلفن:</span>\n                    <span className=\"value\">{toPersianDigits(actor.phone)}</span>\n                  </div>\n                )}\n                {actor.email && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">ایمیل:</span>\n                    <span className=\"value\">{actor.email}</span>\n                  </div>\n                )}\n                {actor.address && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">آدرس:</span>\n                    <span className=\"value\">{actor.address}</span>\n                  </div>\n                )}\n                {actor.description && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">توضیحات:</span>\n                    <span className=\"value\">{actor.description}</span>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"card-footer\">\n                <div className=\"created-info\">\n                  ایجاد شده در: {new Date(actor.created_at).toLocaleDateString('fa-IR')}\n                </div>\n                <div className=\"status-badge\">\n                  {actor.status === 'active' ? 'فعال' : 'غیرفعال'}\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Actors;\n","import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport { FaPlus, FaEdit, FaTrash, FaSearch, FaCalendarAlt, FaClock } from 'react-icons/fa';\nimport axios from 'axios';\nimport './Programs.css';\nimport { toPersianDigits } from '../utils/locale';\n\nconst Programs: React.FC = () => {\n  const [programs, setPrograms] = useState([]);\n  const [filteredPrograms, setFilteredPrograms] = useState([]);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchPrograms();\n  }, []);\n\n  useEffect(() => {\n    filterPrograms();\n  }, [programs, searchTerm]);\n\n  const fetchPrograms = async () => {\n    try {\n      const response = await axios.get('/api/programs');\n      setPrograms(response.data);\n    } catch (error) {\n      toast.error('خطا در دریافت لیست برنامه‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const filterPrograms = () => {\n    let filtered = programs;\n\n    if (searchTerm) {\n      filtered = filtered.filter((program: any) =>\n        (program.title || '').toLowerCase().includes(searchTerm.toLowerCase()) ||\n        (program.description || '').toLowerCase().includes(searchTerm.toLowerCase()) ||\n        (program.program_type || '').toLowerCase().includes(searchTerm.toLowerCase())\n      );\n    }\n\n    setFilteredPrograms(filtered);\n  };\n\n  const handleDelete = async (id: string) => {\n    if (window.confirm('آیا از حذف این برنامه مطمئن هستید؟')) {\n      try {\n        await axios.delete(`/api/programs/${id}`);\n        toast.success('برنامه با موفقیت حذف شد');\n        fetchPrograms();\n      } catch (error) {\n        toast.error('خطا در حذف برنامه');\n      }\n    }\n  };\n\n  const getProgramTypeColor = (type: string) => {\n    const colors = {\n      'theater': '#e74c3c',\n      'music': '#9b59b6',\n      'dance': '#f39c12',\n      'concert': '#27ae60',\n      'workshop': '#3498db',\n      'exhibition': '#e67e22',\n      'conference': '#1abc9c',\n      'other': '#95a5a6'\n    };\n    return colors[type as keyof typeof colors] || colors.other;\n  };\n\n  const getProgramTypeLabel = (type: string) => {\n    const labels = {\n      'theater': 'تئاتر',\n      'music': 'موسیقی',\n      'dance': 'رقص',\n      'concert': 'کنسرت',\n      'workshop': 'کارگاه',\n      'exhibition': 'نمایشگاه',\n      'conference': 'کنفرانس',\n      'other': 'سایر'\n    };\n    return labels[type as keyof typeof labels] || labels.other;\n  };\n\n  if (loading) {\n    return (\n      <div className=\"loading-container\">\n        <div className=\"loading-spinner\"></div>\n        <p>در حال بارگذاری...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"programs-container\">\n      <div className=\"page-header\">\n        <h1>مدیریت برنامه‌ها</h1>\n        <Link to=\"/programs/new\" className=\"btn btn-success\">\n          <FaPlus />\n          برنامه جدید\n        </Link>\n      </div>\n\n      <div className=\"filters-section\">\n        <div className=\"search-box\">\n          <FaSearch />\n          <input\n            type=\"text\"\n            placeholder=\"جستجو در نام، توضیحات یا نوع برنامه...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"search-input\"\n          />\n        </div>\n      </div>\n\n      <div className=\"programs-grid\">\n        {filteredPrograms.length === 0 ? (\n          <div className=\"empty-state\">\n            <FaCalendarAlt />\n            <p>هیچ برنامه‌ای یافت نشد</p>\n            <Link to=\"/programs/new\" className=\"btn btn-success\">\n              ایجاد اولین برنامه\n            </Link>\n          </div>\n        ) : (\n          filteredPrograms.map((program: any) => (\n            <div key={program.id} className=\"program-card\">\n              <div className=\"card-header\">\n                <div className=\"program-info\">\n                  <div\n                    className=\"program-type-badge\"\n                    style={{ backgroundColor: getProgramTypeColor(program.program_type) }}\n                  >\n                    {getProgramTypeLabel(program.program_type)}\n                  </div>\n                  <h3>{program.title}</h3>\n                </div>\n                <div className=\"card-actions\">\n                  <Link\n                    to={`/programs/${program.id}/edit`}\n                    className=\"action-btn edit\"\n                    title=\"ویرایش\"\n                  >\n                    <FaEdit />\n                  </Link>\n                  <button\n                    onClick={() => handleDelete(program.id)}\n                    className=\"action-btn delete\"\n                    title=\"حذف\"\n                  >\n                    <FaTrash />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"card-content\">\n                {program.description && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">توضیحات:</span>\n                    <span className=\"value\">{program.description}</span>\n                  </div>\n                )}\n                {program.duration && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">مدت زمان:</span>\n                    <span className=\"value duration\">\n                      <FaClock />\n                      {toPersianDigits(program.duration)} دقیقه\n                    </span>\n                  </div>\n                )}\n                {program.capacity && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">ظرفیت:</span>\n                    <span className=\"value\">{toPersianDigits(program.capacity)} نفر</span>\n                  </div>\n                )}\n                {program.price && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">قیمت:</span>\n                    <span className=\"value price\">{toPersianDigits(program.price.toLocaleString())} تومان</span>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"card-footer\">\n                <div className=\"created-info\">\n                  ایجاد شده در: {new Date(program.created_at).toLocaleDateString('fa-IR')}\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Programs;\n","import React, { useState } from 'react';\nimport { useNavigate } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport axios from 'axios';\n\nconst CreateActor: React.FC = () => {\n  const navigate = useNavigate();\n  const [formData, setFormData] = useState({\n    name: '',\n    role: '',\n    bio: '',\n    phone: '',\n    email: '',\n  });\n  const [loading, setLoading] = useState(false);\n\n  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {\n    const { name, value } = e.target;\n    setFormData(prev => ({ ...prev, [name]: value }));\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formData.name || !formData.role) {\n      toast.error('نام و نقش الزامی است');\n      return;\n    }\n    try {\n      setLoading(true);\n      const token = localStorage.getItem('token');\n      await axios.post('/api/actors', formData, {\n        headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n      });\n      toast.success('عامل با موفقیت ایجاد شد');\n      navigate('/actors');\n    } catch (error) {\n      toast.error('ایجاد عامل با خطا مواجه شد');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"container p-4\">\n      <h1 className=\"mb-3\">ایجاد عامل جدید</h1>\n      <form onSubmit={handleSubmit} className=\"card\">\n        <div className=\"card-body\">\n          <div className=\"form-group\">\n            <label className=\"form-label\">نام</label>\n            <input name=\"name\" value={formData.name} onChange={handleChange} className=\"form-control\" placeholder=\"نام عامل\" />\n          </div>\n          <div className=\"form-group\">\n            <label className=\"form-label\">نقش</label>\n            <input name=\"role\" value={formData.role} onChange={handleChange} className=\"form-control\" placeholder=\"نقش عامل (کارگردان، بازیگر و ...)\" />\n          </div>\n          <div className=\"form-group\">\n            <label className=\"form-label\">بیوگرافی</label>\n            <textarea name=\"bio\" value={formData.bio} onChange={handleChange} className=\"form-control\" placeholder=\"توضیحات کوتاه\" />\n          </div>\n          <div className=\"form-group\">\n            <label className=\"form-label\">تلفن</label>\n            <input name=\"phone\" value={formData.phone} onChange={handleChange} className=\"form-control\" placeholder=\"شماره تماس\" />\n          </div>\n          <div className=\"form-group\">\n            <label className=\"form-label\">ایمیل</label>\n            <input name=\"email\" value={formData.email} onChange={handleChange} className=\"form-control\" placeholder=\"example@mail.com\" />\n          </div>\n        </div>\n        <div className=\"card-footer\" style={{ display: 'flex', gap: '10px' }}>\n          <button type=\"submit\" className=\"btn btn-success\" disabled={loading}>{loading ? 'در حال ذخیره...' : 'ذخیره'}</button>\n          <button type=\"button\" className=\"btn btn-light\" onClick={() => navigate('/actors')}>انصراف</button>\n        </div>\n      </form>\n    </div>\n  );\n};\n\nexport default CreateActor;\n","import React, { useState } from 'react';\nimport { useNavigate } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport axios from 'axios';\n\nconst CreateProgram: React.FC = () => {\n  const navigate = useNavigate();\n  const [formData, setFormData] = useState({\n    title: '',\n    description: '',\n    program_type: '',\n    duration: '',\n    genre: '',\n  });\n  const [loading, setLoading] = useState(false);\n\n  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {\n    const { name, value } = e.target;\n    setFormData(prev => ({ ...prev, [name]: value }));\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formData.title || !formData.program_type) {\n      toast.error('عنوان و نوع برنامه الزامی است');\n      return;\n    }\n    try {\n      setLoading(true);\n      const token = localStorage.getItem('token');\n      await axios.post('/api/programs', formData, {\n        headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n      });\n      toast.success('برنامه با موفقیت ایجاد شد');\n      navigate('/programs');\n    } catch (error) {\n      toast.error('ایجاد برنامه با خطا مواجه شد');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"container p-4\">\n      <h1 className=\"mb-3\">ایجاد برنامه جدید</h1>\n      <form onSubmit={handleSubmit} className=\"card\">\n        <div className=\"card-body\">\n          <div className=\"form-group\">\n            <label className=\"form-label\">عنوان</label>\n            <input name=\"title\" value={formData.title} onChange={handleChange} className=\"form-control\" placeholder=\"عنوان برنامه\" />\n          </div>\n          <div className=\"form-group\">\n            <label className=\"form-label\">نوع برنامه</label>\n            <input name=\"program_type\" value={formData.program_type} onChange={handleChange} className=\"form-control\" placeholder=\"نمایش، کنسرت، نشست و ...\" />\n          </div>\n          <div className=\"form-group\">\n            <label className=\"form-label\">مدت زمان</label>\n            <input name=\"duration\" value={formData.duration} onChange={handleChange} className=\"form-control\" placeholder=\"مثلاً 90 دقیقه\" />\n          </div>\n          <div className=\"form-group\">\n            <label className=\"form-label\">ژانر</label>\n            <input name=\"genre\" value={formData.genre} onChange={handleChange} className=\"form-control\" placeholder=\"ژانر برنامه\" />\n          </div>\n          <div className=\"form-group\">\n            <label className=\"form-label\">توضیحات</label>\n            <textarea name=\"description\" value={formData.description} onChange={handleChange} className=\"form-control\" placeholder=\"توضیحات برنامه\" />\n          </div>\n        </div>\n        <div className=\"card-footer\" style={{ display: 'flex', gap: '10px' }}>\n          <button type=\"submit\" className=\"btn btn-success\" disabled={loading}>{loading ? 'در حال ذخیره...' : 'ذخیره'}</button>\n          <button type=\"button\" className=\"btn btn-light\" onClick={() => navigate('/programs')}>انصراف</button>\n        </div>\n      </form>\n    </div>\n  );\n};\n\nexport default CreateProgram;\n","import React from 'react';\nimport Display from './Display';\n\nconst DisplayPage: React.FC = () => {\n  return <Display />;\n};\n\nexport default DisplayPage;","import React, { useState, useEffect } from 'react';\nimport { useParams, useNavigate } from 'react-router-dom';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport './PosterView.css';\nimport Logo from '../components/Logo';\n\nconst PosterView: React.FC = () => {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const [announcement, setAnnouncement] = useState<any>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchAnnouncement();\n  }, [id]);\n\n  const fetchAnnouncement = async () => {\n    try {\n      const response = await axios.get(`/api/announcements/${id}`);\n      setAnnouncement(response.data);\n    } catch (error) {\n      toast.error('خطا در بارگیری اطلاعات آفیش');\n      console.error('Error fetching announcement:', error);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const handleDownload = async () => {\n    try {\n      const element = document.getElementById('poster-content');\n      if (element) {\n        const html2canvas = (await import('html2canvas')).default;\n        const canvas = await html2canvas(element, {\n          scale: 2,\n          useCORS: true,\n          allowTaint: true\n        });\n\n        const link = document.createElement('a');\n        link.download = `poster-${announcement?.id || 'announcement'}.png`;\n        link.href = canvas.toDataURL();\n        link.click();\n      }\n    } catch (error) {\n      toast.error('خطا در دانلود پوستر');\n      console.error('Error downloading poster:', error);\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"poster-view-loading\">\n        <div className=\"spinner\"></div>\n        <p>در حال بارگیری...</p>\n      </div>\n    );\n  }\n\n  if (!announcement) {\n    return (\n      <div className=\"poster-view-error\">\n        <p>آفیش مورد نظر یافت نشد</p>\n        <button onClick={() => navigate('/')} className=\"btn btn-primary\">\n          بازگشت به خانه\n        </button>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"poster-view-container\">\n      <div className=\"print-logo\" aria-hidden=\"true\">\n        <Logo src=\"/logo.png.jpg\" height={144} width={144} alt=\"لوگو\" />\n      </div>\n      <div className=\"poster-actions\">\n        <button onClick={() => navigate(-1)} className=\"btn btn-secondary\">\n          بازگشت\n        </button>\n        <div className=\"action-buttons\">\n          <button onClick={handlePrint} className=\"btn btn-print\">\n            چاپ\n          </button>\n          <button onClick={handleDownload} className=\"btn btn-download\">\n            دانلود\n          </button>\n        </div>\n      </div>\n\n      <div id=\"poster-content\" className=\"poster-content\">\n        <div className=\"poster-header\">\n          <h1>{announcement.title}</h1>\n          <div className=\"announcement-meta\">\n            <span className=\"announcement-date\">\n              {new Date(announcement.date).toLocaleDateString('fa-IR')}\n            </span>\n            <span className=\"announcement-time\">\n              ساعت {announcement.time}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"poster-body\">\n          {announcement.poster_image && (\n            <div className=\"poster-image\">\n              <img\n                src={announcement.poster_image.startsWith('http') ? announcement.poster_image : `/uploads/${announcement.poster_image}`}\n                alt={announcement.title}\n                crossOrigin=\"anonymous\"\n              />\n            </div>\n          )}\n\n          <div className=\"announcement-details\">\n            <div className=\"detail-section\">\n              <h3>توضیحات</h3>\n              <p>{announcement.description}</p>\n            </div>\n\n            {announcement.actors && announcement.actors.length > 0 && (\n              <div className=\"detail-section\">\n                <h3>عوامل</h3>\n                <div className=\"actors-list\">\n                  {announcement.actors.map((actor: any) => (\n                    <div key={actor.id} className=\"actor-item\">\n                      {actor.name}\n                      {actor.role_in_program && (\n                        <span className=\"actor-role\"> — {actor.role_in_program}</span>\n                      )}\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            {announcement.program_title && (\n              <div className=\"detail-section\">\n                <h3>برنامه</h3>\n                <div className=\"programs-list\">\n                  <div className=\"program-item\">{announcement.program_title}</div>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n\n        <div className=\"poster-footer\">\n          <p>سامانه رسا</p>\n          <p className=\"poster-date\">\n            {new Date().toLocaleDateString('fa-IR')}\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default PosterView;\n","import React, { useEffect, useState } from 'react';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport { FaPlus, FaTrash } from 'react-icons/fa';\n\nconst Roles: React.FC = () => {\n  const [roles, setRoles] = useState<any[]>([]);\n  const [code, setCode] = useState('');\n  const [name, setName] = useState('');\n  const [rank, setRank] = useState<number | ''>('');\n  const [loading, setLoading] = useState(true);\n\n  const token = localStorage.getItem('token');\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\n\n  useEffect(() => { fetchRoles(); }, []);\n\n  const fetchRoles = async () => {\n    try {\n      const res = await axios.get('/api/roles');\n      setRoles(res.data);\n    } catch (e) {\n      toast.error('خطا در دریافت نقش‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const addRole = async () => {\n    if (!code.trim() || !name.trim()) {\n      toast.error('کد و نام نقش الزامی است');\n      return;\n    }\n    const rankValue = typeof rank === 'number' ? rank : 999;\n    try {\n      await axios.post('/api/roles', { code, name, rank: rankValue }, { headers: authHeaders });\n      toast.success('نقش با موفقیت ثبت شد');\n      setCode('');\n      setName('');\n      setRank('');\n      fetchRoles();\n    } catch (e) {\n      toast.error('ثبت نقش با خطا مواجه شد');\n    }\n  };\n\n  const deleteRole = async (id: number) => {\n    if (!window.confirm('از حذف نقش مطمئن هستید؟')) return;\n    try {\n      await axios.delete(`/api/roles/${id}`, { headers: authHeaders });\n      toast.success('نقش حذف شد');\n      fetchRoles();\n    } catch (e) {\n      toast.error('حذف نقش با خطا مواجه شد');\n    }\n  };\n\n  if (loading) {\n    return <div className=\"loading-container\"><div className=\"loading-spinner\"></div><p>در حال بارگذاری...</p></div>;\n  }\n\n  return (\n    <div className=\"page-container\">\n      <div className=\"page-header\">\n        <h1>مدیریت نقش‌ها</h1>\n      </div>\n\n      <div className=\"form-card\">\n        <div className=\"form-row\">\n          <label>کد نقش</label>\n          <input value={code} onChange={(e) => setCode(e.target.value)} placeholder=\"مثلاً cameraman\" />\n        </div>\n      <div className=\"form-row\">\n        <label>نام نقش</label>\n        <input value={name} onChange={(e) => setName(e.target.value)} placeholder=\"مثلاً تصویربردار\" />\n      </div>\n      <div className=\"form-row\">\n        <label>رتبه (سلسله‌مراتبی)</label>\n        <input type=\"number\" value={rank} onChange={(e) => setRank(e.target.value ? Number(e.target.value) : '')} placeholder=\"مثلاً 1 برای تهیه‌کننده\" />\n        <small className=\"muted\">عدد کوچکتر یعنی جایگاه بالاتر؛ اگر ندهید 999 در نظر گرفته می‌شود.</small>\n      </div>\n      <button className=\"btn btn-success\" onClick={addRole}><FaPlus /> افزودن نقش</button>\n    </div>\n\n      <div className=\"list-card\">\n        {roles.length === 0 ? (\n          <p>نقشی ثبت نشده است.</p>\n        ) : (\n          <table className=\"data-table\">\n          <thead>\n            <tr>\n              <th>کد</th>\n              <th>نام</th>\n              <th>رتبه</th>\n              <th>عملیات</th>\n            </tr>\n          </thead>\n          <tbody>\n            {roles.map((r) => (\n              <tr key={r.id}>\n                <td>{r.code}</td>\n                <td>{r.name}</td>\n                <td>{r.rank ?? 999}</td>\n                <td>\n                  <button className=\"action-btn delete\" onClick={() => deleteRole(r.id)} title=\"حذف\"><FaTrash /></button>\n                </td>\n              </tr>\n            ))}\n          </tbody>\n          </table>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Roles;","import React, { useEffect, useMemo, useState } from 'react';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport { Link } from 'react-router-dom';\n\nconst toPersianDigits = (str: string | number) => {\n  const s = String(str);\n  const d = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\n  return s.replace(/[0-9]/g, (w) => d[+w]);\n};\n\nconst Estimates: React.FC = () => {\n  const [estimates, setEstimates] = useState<any[]>([]);\n  const [programs, setPrograms] = useState<any[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [programId, setProgramId] = useState<string>('');\n  const token = localStorage.getItem('token');\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\n\n  useEffect(() => {\n    fetchPrograms();\n  }, []);\n\n  useEffect(() => {\n    fetchEstimates();\n  }, [programId]);\n\n  const fetchPrograms = async () => {\n    try {\n      const res = await axios.get('/api/programs');\n      setPrograms(res.data);\n    } catch {\n      toast.error('خطا در دریافت برنامه‌ها');\n    }\n  };\n\n  const fetchEstimates = async () => {\n    setLoading(true);\n    try {\n      const url = programId ? `/api/estimates?program_id=${programId}` : '/api/estimates';\n      const res = await axios.get(url);\n      setEstimates(res.data);\n    } catch {\n      toast.error('خطا در دریافت برآوردها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const deleteEstimate = async (id: number) => {\n    if (!window.confirm('از حذف برآورد مطمئن هستید؟')) return;\n    try {\n      await axios.delete(`/api/estimates/${id}`, { headers: authHeaders });\n      toast.success('برآورد حذف شد');\n      fetchEstimates();\n    } catch {\n      toast.error('حذف برآورد با خطا مواجه شد');\n    }\n  };\n\n  return (\n    <div className=\"page-container\">\n      <div className=\"page-header\">\n        <h1>برآوردهای برنامه‌ها</h1>\n        <Link to=\"/estimates/new\" className=\"btn btn-primary\">ثبت برآورد جدید</Link>\n      </div>\n\n      <div className=\"filters\">\n        <div className=\"form-row\">\n          <label>برنامه</label>\n          <select value={programId} onChange={(e) => setProgramId(e.target.value)}>\n            <option value=\"\">همه</option>\n            {programs.map((p) => (\n              <option key={p.id} value={p.id}>{p.name}</option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {loading ? (\n        <div className=\"loading-container\"><div className=\"loading-spinner\"></div><p>در حال بارگذاری...</p></div>\n      ) : (\n        <div className=\"list-card\">\n          {estimates.length === 0 ? (\n            <p>برآوردی یافت نشد.</p>\n          ) : (\n            <table className=\"data-table\">\n              <thead>\n                <tr>\n                  <th>کد برآورد</th>\n                  <th>برنامه</th>\n                  <th>مدت (دقیقه)</th>\n                  <th>تعداد برنامه</th>\n                  <th>نرخ هر دقیقه</th>\n                  <th>مبلغ کل</th>\n                  <th>تاریخ ثبت</th>\n                  <th>انقضا</th>\n                  <th>عملیات</th>\n                </tr>\n              </thead>\n              <tbody>\n                {estimates.map((e) => {\n                  const totalMinutes = (e.program_count || 0) * (e.duration_minutes || 0);\n                  const totalAmount = totalMinutes * (e.minute_rate || 0);\n                  const prog = programs.find((p) => p.id === e.program_id);\n                  return (\n                    <tr key={e.id}>\n                      <td>{e.estimate_code}</td>\n                      <td>{prog ? prog.name : '—'}</td>\n                      <td>{toPersianDigits(e.duration_minutes)}</td>\n                      <td>{toPersianDigits(e.program_count)}</td>\n                      <td>{toPersianDigits(e.minute_rate)}</td>\n                      <td>{toPersianDigits(totalAmount)}</td>\n                      <td>{e.created_at?.slice(0, 10) || '—'}</td>\n                      <td>{e.expiration_date?.slice(0, 10) || '—'}</td>\n                      <td>\n                        <Link to={`/estimates/${e.id}`} className=\"action-btn\">جزئیات</Link>\n                        <button className=\"action-btn delete\" onClick={() => deleteEstimate(e.id)}>حذف</button>\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Estimates;","import React, { useEffect, useMemo, useState } from 'react';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport { useNavigate } from 'react-router-dom';\nimport DatePicker from 'react-multi-date-picker';\nimport persian from 'react-date-object/calendars/persian';\nimport persian_fa from 'react-date-object/locales/persian_fa';\n\nconst toPersianDigits = (str: string | number) => {\n  const s = String(str);\n  const d = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\n  return s.replace(/[0-9]/g, (w) => d[+w]);\n};\n\nconst CreateEstimate: React.FC = () => {\n  const [programs, setPrograms] = useState<any[]>([]);\n  const [roles, setRoles] = useState<any[]>([]);\n\n  const [form, setForm] = useState<any>({\n    program_id: '',\n    estimate_code: '',\n    duration_minutes: '',\n    program_count: '',\n    minute_rate: '',\n    expiration_date: '',\n    linked_to: '',\n    hospitality_amount: '',\n    transport_amount: '',\n    misc_amount: '',\n    description: ''\n  });\n\n  const [roleWageDraft, setRoleWageDraft] = useState<any>({\n    role_id: '',\n    role_name: '',\n    role_code: '',\n    wage_amount: '',\n    wage_percent: ''\n  });\n\n  const [createdEstimateId, setCreatedEstimateId] = useState<number | null>(null);\n  const navigate = useNavigate();\n\n  const token = localStorage.getItem('token');\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\n\n  useEffect(() => { fetchPrograms(); fetchRoles(); }, []);\n\n  const fetchPrograms = async () => {\n    try { const res = await axios.get('/api/programs'); setPrograms(res.data); }\n    catch { toast.error('خطا در دریافت برنامه‌ها'); }\n  };\n\n  const fetchRoles = async () => {\n    try { const res = await axios.get('/api/roles'); setRoles(res.data); }\n    catch { toast.error('خطا در دریافت نقش‌ها'); }\n  };\n\n  const onChange = (key: string, value: any) => setForm((f: any) => ({ ...f, [key]: value }));\n\n  const submitEstimate = async () => {\n    const required = ['program_id','estimate_code','duration_minutes','program_count','minute_rate'];\n    for (const k of required) {\n      if (!String(form[k] || '').trim()) { toast.error('فیلدهای اصلی را کامل کنید'); return; }\n    }\n    try {\n      const payload = {\n        program_id: Number(form.program_id),\n        estimate_code: form.estimate_code.trim(),\n        duration_minutes: Number(form.duration_minutes),\n        program_count: Number(form.program_count),\n        minute_rate: Number(form.minute_rate),\n        expiration_date: form.expiration_date || null,\n        linked_to: form.linked_to ? Number(form.linked_to) : null,\n        hospitality_amount: form.hospitality_amount ? Number(form.hospitality_amount) : 0,\n        transport_amount: form.transport_amount ? Number(form.transport_amount) : 0,\n        misc_amount: form.misc_amount ? Number(form.misc_amount) : 0,\n      };\n      const res = await axios.post('/api/estimates', payload, { headers: authHeaders });\n      setCreatedEstimateId(res.data.id);\n      toast.success('برآورد ثبت شد، حالا دستمزد نقش‌ها را اضافه کنید');\n    } catch {\n      toast.error('ثبت برآورد با خطا مواجه شد');\n    }\n  };\n\n  const addRoleWage = async () => {\n    if (!createdEstimateId) { toast.error('ابتدا برآورد را ثبت کنید'); return; }\n    const roleCodeFromList = roleWageDraft.role_id ? (roles.find((r)=> String(r.id)===String(roleWageDraft.role_id))?.code || null) : null;\n    const wageType = roleWageDraft.wage_amount ? 'amount' : (roleWageDraft.wage_percent ? 'percent' : null);\n    const wageValue = roleWageDraft.wage_amount ? Number(roleWageDraft.wage_amount) : (roleWageDraft.wage_percent ? Number(roleWageDraft.wage_percent) : null);\n    const payload: any = {\n      role_code: roleWageDraft.role_code || roleCodeFromList,\n      wage_type: wageType,\n      wage_value: wageValue,\n    };\n    if (!payload.role_code || !payload.wage_type || payload.wage_value == null) {\n      toast.error('حداقل یکی از نقش یا نام/کد نقش را وارد کنید');\n      return;\n    }\n    try {\n      await axios.post(`/api/estimates/${createdEstimateId}/roles`, payload, { headers: authHeaders });\n      toast.success('دستمزد نقش اضافه شد');\n      setRoleWageDraft({ role_id: '', role_name: '', role_code: '', wage_amount: '', wage_percent: '' });\n    } catch {\n      toast.error('ثبت دستمزد نقش با خطا مواجه شد');\n    }\n  };\n\n  const totalMinutes = useMemo(() => {\n    const d = Number(form.duration_minutes || 0); const c = Number(form.program_count || 0);\n    return d * c;\n  }, [form.duration_minutes, form.program_count]);\n\n  const totalAmount = useMemo(() => {\n    const r = Number(form.minute_rate || 0); return r * totalMinutes;\n  }, [form.minute_rate, totalMinutes]);\n\n  return (\n    <div className=\"page-container\">\n      <div className=\"page-header\">\n        <h1>ثبت برآورد جدید</h1>\n        <button className=\"btn\" onClick={() => navigate('/estimates')}>بازگشت</button>\n      </div>\n\n      <div className=\"form-card\">\n        <div className=\"form-row\">\n          <label>برنامه</label>\n          <select value={form.program_id} onChange={(e) => onChange('program_id', e.target.value)}>\n            <option value=\"\">انتخاب کنید</option>\n            {programs.map((p) => (\n              <option key={p.id} value={p.id}>{p.title || p.name}</option>\n            ))}\n          </select>\n        </div>\n\n        <div className=\"form-row\">\n          <label>کد برآورد یکتا</label>\n          <input value={form.estimate_code} onChange={(e) => onChange('estimate_code', e.target.value)} placeholder=\"مثلاً EST-1403-001\" />\n        </div>\n\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>مدت هر برنامه (دقیقه)</label>\n            <input type=\"number\" value={form.duration_minutes} onChange={(e) => onChange('duration_minutes', e.target.value)} />\n          </div>\n          <div className=\"form-row\">\n            <label>تعداد برنامه</label>\n            <input type=\"number\" value={form.program_count} onChange={(e) => onChange('program_count', e.target.value)} />\n          </div>\n          <div className=\"form-row\">\n            <label>نرخ هر دقیقه (تومان)</label>\n            <input type=\"number\" value={form.minute_rate} onChange={(e) => onChange('minute_rate', e.target.value)} />\n          </div>\n        </div>\n\n        <div className=\"hint-row\">\n          <span>دقیقه کل: {toPersianDigits(totalMinutes)}</span>\n          <span>مبلغ کل: {toPersianDigits(totalAmount)}</span>\n        </div>\n\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>تاریخ انقضا (شمسی)</label>\n            <DatePicker\n              calendar={persian}\n              locale={persian_fa}\n              value={form.expiration_date ? new Date(form.expiration_date) : undefined}\n              format=\"YYYY-MM-DD\"\n              onChange={(date: any) => {\n                try {\n                  const str = Array.isArray(date) ? '' : date?.format?.('YYYY-MM-DD') || '';\n                  onChange('expiration_date', str);\n                } catch {\n                  onChange('expiration_date', '');\n                }\n              }}\n              inputClass=\"date-input\"\n            />\n          </div>\n          <div className=\"form-row\">\n            <label>برآورد پیوست (اختیاری)</label>\n            <input value={form.linked_to} onChange={(e) => onChange('linked_to', e.target.value)} placeholder=\"شناسه برآورد قبلی\" />\n          </div>\n        </div>\n\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>پذیرایی</label>\n            <input type=\"number\" value={form.hospitality_amount} onChange={(e) => onChange('hospitality_amount', e.target.value)} />\n          </div>\n          <div className=\"form-row\">\n            <label>ایاب و ذهاب</label>\n            <input type=\"number\" value={form.transport_amount} onChange={(e) => onChange('transport_amount', e.target.value)} />\n          </div>\n          <div className=\"form-row\">\n            <label>هزینه‌های متفرقه</label>\n            <input type=\"number\" value={form.misc_amount} onChange={(e) => onChange('misc_amount', e.target.value)} />\n          </div>\n        </div>\n\n        <div className=\"form-row\">\n          <label>توضیحات</label>\n          <textarea value={form.description} onChange={(e) => onChange('description', e.target.value)} />\n        </div>\n\n        <button className=\"btn btn-success\" onClick={submitEstimate}>ثبت برآورد</button>\n      </div>\n\n      <div className=\"form-card\">\n        <h2>تعریف دستمزد نقش‌ها</h2>\n        {!createdEstimateId && <p className=\"muted\">برای اضافه کردن نقش‌ها، ابتدا برآورد را ثبت کنید.</p>}\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>انتخاب از لیست نقش‌ها</label>\n            <small className=\"muted\">مرتب بر اساس رتبه (عدد کوچکتر یعنی جایگاه بالاتر)</small>\n            <select value={roleWageDraft.role_id} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, role_id: e.target.value }))}>\n              <option value=\"\">—</option>\n              {roles.map((r) => <option key={r.id} value={r.id}>{r.name} ({r.code} • رتبه {r.rank ?? 999})</option>)}\n            </select>\n          </div>\n          <div className=\"form-row\">\n            <label>یا کد نقش</label>\n            <input value={roleWageDraft.role_code} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, role_code: e.target.value }))} placeholder=\"مثلاً soundman\" />\n          </div>\n          <div className=\"form-row\">\n            <label>نام نقش</label>\n            <input value={roleWageDraft.role_name} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, role_name: e.target.value }))} placeholder=\"مثلاً صدابردار\" />\n          </div>\n        </div>\n\n        <div className=\"form-grid\">\n          <div className=\"form-row\">\n            <label>حق‌الزحمه عددی (تومان)</label>\n            <input type=\"number\" value={roleWageDraft.wage_amount} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, wage_amount: e.target.value }))} />\n          </div>\n          <div className=\"form-row\">\n            <label>حق‌الزحمه درصدی (%)</label>\n            <input type=\"number\" value={roleWageDraft.wage_percent} onChange={(e) => setRoleWageDraft((d: any) => ({ ...d, wage_percent: e.target.value }))} />\n          </div>\n        </div>\n\n        <button className=\"btn\" onClick={addRoleWage}>افزودن دستمزد نقش</button>\n      </div>\n    </div>\n  );\n};\n\nexport default CreateEstimate;","import React, { useEffect, useState } from 'react';\r\nimport axios from 'axios';\r\nimport { useParams, useNavigate } from 'react-router-dom';\r\nimport { toast } from '../libs/toast';\r\n\r\nconst toPersianDigits = (str: string | number) => {\r\n  const s = String(str);\r\n  const d = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\r\n  return s.replace(/[0-9]/g, (w) => d[+w]);\r\n};\r\n\r\nconst EstimateDetail: React.FC = () => {\r\n  const { id } = useParams();\r\n  const [estimate, setEstimate] = useState<any>(null);\r\n  const [roles, setRoles] = useState<any[]>([]);\r\n  const [savingRoleId, setSavingRoleId] = useState<number | null>(null);\r\n  const [programs, setPrograms] = useState<any[]>([]);\r\n  const navigate = useNavigate();\r\n\r\n  useEffect(() => { fetchPrograms(); }, []);\r\n  useEffect(() => { if (id) fetchEstimate(); }, [id]);\r\n\r\n  const fetchPrograms = async () => {\r\n    try { const res = await axios.get('/api/programs'); setPrograms(res.data); }\r\n    catch { /* ignore */ }\r\n  };\r\n\r\n  const fetchEstimate = async () => {\r\n    try {\r\n      const res = await axios.get(`/api/estimates/${id}`);\r\n      const est = res.data;\r\n      setEstimate(est);\r\n      setRoles(est.roles || []);\r\n    } catch {\r\n      toast.error('دریافت جزئیات برآورد با خطا مواجه شد');\r\n    }\r\n  };\r\n\r\n  const token = localStorage.getItem('token');\r\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\r\n\r\n  const updateRoleWage = async (row: any) => {\r\n    if (!id) return;\r\n    setSavingRoleId(row.id);\r\n    const payload: any = {\r\n      role_id: row.role_id || null,\r\n      role_code: row.role_code || null,\r\n      role_name: row.role_name || null,\r\n      wage_amount: row.wage_amount || null,\r\n      wage_percent: row.wage_percent || null,\r\n    };\r\n    try {\r\n      await axios.post(`/api/estimates/${id}/roles`, payload, { headers: authHeaders });\r\n      toast.success('دستمزد نقش به‌روزرسانی شد');\r\n    } catch {\r\n      toast.error('به‌روزرسانی دستمزد با خطا مواجه شد');\r\n    } finally {\r\n      setSavingRoleId(null);\r\n    }\r\n  };\r\n\r\n  if (!estimate) {\r\n    return <div className=\"loading-container\"><div className=\"loading-spinner\"></div><p>در حال بارگذاری...</p></div>;\r\n  }\r\n\r\n  const prog = programs.find((p) => p.id === estimate.program_id);\r\n  const totalMinutes = (estimate.program_count || 0) * (estimate.duration_minutes || 0);\r\n  const totalAmount = totalMinutes * (estimate.minute_rate || 0);\r\n\r\n  return (\r\n    <div className=\"page-container\">\r\n      <div className=\"page-header\">\r\n        <h1>جزئیات برآورد {estimate.estimate_code}</h1>\r\n        <button className=\"btn\" onClick={() => navigate('/estimates')}>بازگشت</button>\r\n      </div>\r\n\r\n      <div className=\"form-card\">\r\n        <div className=\"info-grid\">\r\n          <div><strong>برنامه:</strong> {estimate.program_title || (prog ? (prog.title || prog.name) : '—')}</div>\r\n          <div><strong>مدت هر برنامه:</strong> {toPersianDigits(estimate.duration_minutes)} دقیقه</div>\r\n          <div><strong>تعداد برنامه:</strong> {toPersianDigits(estimate.program_count)}</div>\r\n          <div><strong>نرخ هر دقیقه:</strong> {toPersianDigits(estimate.minute_rate)} تومان</div>\r\n          <div><strong>دقیقه کل:</strong> {toPersianDigits(totalMinutes)}</div>\r\n          <div><strong>مبلغ کل:</strong> {toPersianDigits(totalAmount)}</div>\r\n          <div><strong>پذیرایی:</strong> {toPersianDigits(estimate.hospitality_amount || 0)}</div>\r\n          <div><strong>ایاب و ذهاب:</strong> {toPersianDigits(estimate.transport_amount || 0)}</div>\r\n          <div><strong>متفرقه:</strong> {toPersianDigits(estimate.misc_amount || 0)}</div>\r\n          <div><strong>تاریخ ثبت:</strong> {estimate.created_at?.slice(0, 10) || '—'}</div>\r\n          <div><strong>انقضا:</strong> {estimate.expiration_date?.slice(0, 10) || '—'}</div>\r\n        </div>\r\n        {estimate.linked_to && (\r\n          <div className=\"hint-row\">پیوست به برآورد: {estimate.linked_to}</div>\r\n        )}\r\n      </div>\r\n\r\n      <div className=\"list-card\">\r\n        <h2>نقش‌ها و دستمزدها</h2>\r\n        {roles.length === 0 ? (\r\n          <p>نقشی برای این برآورد ثبت نشده است.</p>\r\n        ) : (\r\n          <table className=\"data-table\">\r\n            <thead>\r\n              <tr>\r\n                <th>نقش</th>\r\n                <th>کد نقش</th>\r\n                <th>نوع دستمزد</th>\r\n                <th>مقدار</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              {roles.map((r) => (\r\n                <tr key={r.id}>\r\n                  <td>{r.role_name || '—'}</td>\r\n                  <td>{r.role_code || '—'}</td>\r\n                  <td>{r.wage_type === 'percent' ? 'درصدی' : 'عددی'}</td>\r\n                  <td>{toPersianDigits(r.wage_value || 0)}</td>\r\n                </tr>\r\n              ))}\r\n            </tbody>\r\n          </table>\r\n        )}\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default EstimateDetail;","import React, { useState } from 'react';\nimport { toast } from '../libs/toast';\nimport * as XLSX from 'xlsx';\nimport axios from 'axios';\nimport './BulkUpload.css';\n\nconst BulkUpload: React.FC = () => {\n  const [file, setFile] = useState<File | null>(null);\n  const [previewRows, setPreviewRows] = useState<any[]>([]);\n  const [target, setTarget] = useState<'actors' | 'roles'>('actors');\n  const [mapping, setMapping] = useState<any>({});\n  const [loading, setLoading] = useState(false);\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const f = e.target.files?.[0] || null;\n    setFile(f);\n    setPreviewRows([]);\n    setMapping({});\n    if (f) parseFile(f);\n  };\n\n  const parseFile = async (f: File) => {\n    try {\n      const buf = await f.arrayBuffer();\n      const wb = XLSX.read(buf, { type: 'array' });\n      const ws = wb.Sheets[wb.SheetNames[0]];\n      const rows = XLSX.utils.sheet_to_json(ws, { defval: '' });\n      setPreviewRows(rows.slice(0, 20));\n      // Auto map headers by heuristic\n      const headers = Object.keys(rows[0] || {});\n      const lower = (s: string) => s.toLowerCase();\n      const guess: any = {};\n      if (target === 'actors') {\n        guess.name = headers.find(h => /name|نام/.test(lower(h))) || headers[0];\n        guess.role = headers.find(h => /role|نقش/.test(lower(h))) || headers[1] || headers[0];\n        guess.phone = headers.find(h => /phone|تلفن|موبایل/.test(lower(h)));\n        guess.email = headers.find(h => /email|ایمیل/.test(lower(h)));\n        guess.bio = headers.find(h => /bio|زندگی/.test(lower(h)));\n        guess.photo = headers.find(h => /photo|عکس/.test(lower(h)));\n      } else {\n        guess.code = headers.find(h => /code|کد/.test(lower(h))) || headers[0];\n        guess.name = headers.find(h => /name|نام/.test(lower(h))) || headers[1] || headers[0];\n      }\n      setMapping(guess);\n    } catch (e) {\n      toast.error('خطا در خواندن فایل اکسل');\n    }\n  };\n\n  const buildItems = (): any[] => {\n    return previewRows.map((row: any) => {\n      if (target === 'actors') {\n        return {\n          name: row[mapping.name] || '',\n          role: row[mapping.role] || '',\n          phone: mapping.phone ? row[mapping.phone] : undefined,\n          email: mapping.email ? row[mapping.email] : undefined,\n          bio: mapping.bio ? row[mapping.bio] : undefined,\n          photo: mapping.photo ? row[mapping.photo] : undefined,\n        };\n      } else {\n        return {\n          code: row[mapping.code] || '',\n          name: row[mapping.name] || '',\n        };\n      }\n    }).filter(it => (target === 'actors' ? it.name && it.role : it.code && it.name));\n  };\n\n  const handleImport = async () => {\n    const items = buildItems();\n    if (items.length === 0) {\n      toast.error('هیچ رکورد معتبری برای واردسازی یافت نشد');\n      return;\n    }\n    setLoading(true);\n    try {\n      const token = localStorage.getItem('token');\n      const url = target === 'actors' ? '/api/actors/bulk' : '/api/roles/bulk';\n      const res = await axios.post(url, { items }, {\n        headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n      });\n      toast.success(`واردسازی ${res.data.count} رکورد با موفقیت انجام شد`);\n    } catch (e) {\n      toast.error('خطا در واردسازی داده‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"bulk-container\">\n      <div className=\"bulk-header\">\n        <h1>واردسازی اکسل</h1>\n      <p>فایل اکسل عوامل یا نقش‌ها را آپلود و ثبت دسته‌ای انجام دهید.</p>\n      </div>\n\n      <div className=\"bulk-controls\">\n        <div className=\"target-switch\">\n          <label>\n            <input type=\"radio\" checked={target==='actors'} onChange={()=>setTarget('actors')} /> عوامل\n          </label>\n          <label>\n            <input type=\"radio\" checked={target==='roles'} onChange={()=>setTarget('roles')} /> نقش‌ها\n          </label>\n        </div>\n        <input type=\"file\" accept=\".xlsx,.xls\" onChange={handleFileChange} />\n      </div>\n\n      {previewRows.length > 0 && (\n        <div className=\"bulk-preview\">\n          <h3>پیش‌نمایش و نگاشت ستون‌ها</h3>\n          <div className=\"mapping\">\n            {target === 'actors' ? (\n              <>\n                <FieldMap label=\"نام\" value={mapping.name} onChange={(v)=>setMapping({...mapping,name:v})} headers={Object.keys(previewRows[0]||{})} />\n                <FieldMap label=\"نقش\" value={mapping.role} onChange={(v)=>setMapping({...mapping,role:v})} headers={Object.keys(previewRows[0]||{})} />\n                <FieldMap label=\"تلفن\" value={mapping.phone} onChange={(v)=>setMapping({...mapping,phone:v})} headers={Object.keys(previewRows[0]||{})} optional />\n                <FieldMap label=\"ایمیل\" value={mapping.email} onChange={(v)=>setMapping({...mapping,email:v})} headers={Object.keys(previewRows[0]||{})} optional />\n                <FieldMap label=\"بیو\" value={mapping.bio} onChange={(v)=>setMapping({...mapping,bio:v})} headers={Object.keys(previewRows[0]||{})} optional />\n                <FieldMap label=\"عکس\" value={mapping.photo} onChange={(v)=>setMapping({...mapping,photo:v})} headers={Object.keys(previewRows[0]||{})} optional />\n              </>\n            ) : (\n              <>\n                <FieldMap label=\"کد\" value={mapping.code} onChange={(v)=>setMapping({...mapping,code:v})} headers={Object.keys(previewRows[0]||{})} />\n                <FieldMap label=\"نام\" value={mapping.name} onChange={(v)=>setMapping({...mapping,name:v})} headers={Object.keys(previewRows[0]||{})} />\n              </>\n            )}\n          </div>\n\n          <table className=\"preview-table\">\n            <thead>\n              <tr>\n                {Object.keys(previewRows[0]).map((h) => (<th key={h}>{h}</th>))}\n              </tr>\n            </thead>\n            <tbody>\n              {previewRows.map((row, idx) => (\n                <tr key={idx}>\n                  {Object.keys(previewRows[0]).map((h) => (<td key={h}>{row[h]}</td>))}\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      <div className=\"bulk-actions\">\n        <button className=\"import-btn\" disabled={!file || loading} onClick={handleImport}>\n          {loading ? 'در حال واردسازی...' : 'واردسازی'}\n        </button>\n      </div>\n    </div>\n  );\n};\n\nconst FieldMap: React.FC<{ label: string; value?: string; headers: string[]; onChange: (v: string)=>void; optional?: boolean }>\n  = ({ label, value, headers, onChange, optional }) => {\n  return (\n    <div className=\"field-map\">\n      <span className=\"label\">{label}{optional ? ' (اختیاری)' : ''}</span>\n      <select value={value || ''} onChange={(e)=>onChange(e.target.value)}>\n        <option value=\"\">— انتخاب ستون —</option>\n        {headers.map((h) => (<option key={h} value={h}>{h}</option>))}\n      </select>\n    </div>\n  );\n};\n\nexport default BulkUpload;","import React from 'react';\nimport { BrowserRouter as Router, Routes, Route } from 'react-router-dom';\nimport { ToastContainer } from './libs/toast';\n\n// Context\nimport { AuthProvider } from './contexts/AuthContext';\n\n// Components\nimport Layout from './components/Layout/Layout';\nimport ProtectedRoute from './components/Auth/ProtectedRoute';\n\n// Pages\nimport Home from './pages/Home';\nimport Dashboard from './pages/Dashboard';\nimport Login from './pages/Login';\nimport Announcements from './pages/Announcements';\nimport CreateAnnouncement from './pages/CreateAnnouncement';\nimport AnnouncementDetail from './pages/AnnouncementDetail';\nimport Actors from './pages/Actors';\nimport Programs from './pages/Programs';\nimport CreateActor from './pages/CreateActor';\nimport CreateProgram from './pages/CreateProgram';\nimport DisplayPage from './pages/DisplayPage';\nimport PosterView from './pages/PosterView';\nimport Roles from './pages/Roles';\nimport Estimates from './pages/Estimates';\nimport CreateEstimate from './pages/CreateEstimate';\nimport EstimateDetail from './pages/EstimateDetail';\nimport BulkUpload from './pages/BulkUpload';\n\n// Styles\nimport './App.css';\n\nfunction App() {\n  return (\n    <AuthProvider>\n      <Router>\n        <div className=\"App\">\n          <Routes>\n            {/* Public Routes */}\n            <Route path=\"/login\" element={<Login />} />\n            <Route path=\"/display\" element={<DisplayPage />} />\n            <Route path=\"/poster/:id\" element={<PosterView />} />\n\n            {/* Main Layout Routes */}\n            <Route path=\"/\" element={<Layout />}>\n              <Route index element={<Home />} />\n\n              {/* Protected Admin Routes */}\n              <Route path=\"/dashboard\" element={\n                <ProtectedRoute>\n                  <Dashboard />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/announcements\" element={\n                <ProtectedRoute>\n                  <Announcements />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/announcements/create\" element={\n                <ProtectedRoute>\n                  <CreateAnnouncement />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/announcements/new\" element={\n                <ProtectedRoute>\n                  <CreateAnnouncement />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/announcements/:id\" element={\n                <ProtectedRoute>\n                  <AnnouncementDetail />\n                </ProtectedRoute>\n              } />\n\n              <Route path=\"/announcements/edit/:id\" element={\n                <ProtectedRoute>\n                  <CreateAnnouncement />\n                </ProtectedRoute>\n              } />\n              <Route path=\"/announcements/:id/edit\" element={\n                <ProtectedRoute>\n                  <CreateAnnouncement />\n                </ProtectedRoute>\n              } />\n\n             