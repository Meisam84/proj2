:1763111461495,"results":"60","hashOfConfig":"33"},{"size":2198,"mtime":1763066772580,"results":"61","hashOfConfig":"33"},{"size":7410,"mtime":1763112621636,"results":"62","hashOfConfig":"33"},{"size":3966,"mtime":1763112715186,"results":"63","hashOfConfig":"33"},{"filePath":"64","messages":"65","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"1neel2e",{"filePath":"66","messages":"67","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"68","messages":"69","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"70","messages":"71","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"72","messages":"73","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"74","messages":"75","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"76","messages":"77","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"78"},{"filePath":"79","messages":"80","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"81","messages":"82","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"83"},{"filePath":"84","messages":"85","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"86","messages":"87","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"88"},{"filePath":"89","messages":"90","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"91"},{"filePath":"92","messages":"93","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"94","messages":"95","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"96"},{"filePath":"97","messages":"98","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"99","messages":"100","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"101","messages":"102","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"103","messages":"104","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"105"},{"filePath":"106","messages":"107","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"108"},{"filePath":"109","messages":"110","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"111","messages":"112","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"113","messages":"114","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"115","messages":"116","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"117","messages":"118","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"119","messages":"120","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"121"},{"filePath":"122","messages":"123","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"124","messages":"125","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"126"},{"filePath":"127","messages":"128","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"129"},{"filePath":"130","messages":"131","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"132","messages":"133","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"134"},{"filePath":"135","messages":"136","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"D:\\AI_Projects\\proj2\\client\\src\\index.js",[],"D:\\AI_Projects\\proj2\\client\\src\\App.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\libs\\toast.ts",[],"D:\\AI_Projects\\proj2\\client\\src\\contexts\\AuthContext.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\Login.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\Home.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\Dashboard.tsx",["137","138"],"import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport {\n  FaTachometerAlt, FaUsers, FaCalendarAlt, FaFileAlt,\n  FaChartBar, FaCog, FaSignOutAlt, FaPlus, FaEye, FaEdit, FaTrash\n} from 'react-icons/fa';\nimport axios from 'axios';\nimport { useAuth } from '../contexts/AuthContext';\nimport './Dashboard.css';\n\nconst Dashboard: React.FC = () => {\n  const { logout } = useAuth();\n  const [stats, setStats] = useState({\n    totalAnnouncements: 0,\n    todayAnnouncements: 0,\n    totalActors: 0,\n    totalPrograms: 0\n  });\n  const [recentAnnouncements, setRecentAnnouncements] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [currentDate, setCurrentDate] = useState('');\n  const [currentTime, setCurrentTime] = useState('');\n\n  useEffect(() => {\n    fetchDashboardData();\n    // Live date/time\n    const now = new Date();\n    setCurrentDate(now.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }));\n    setCurrentTime(now.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    const dateInterval = setInterval(() => {\n      const d = new Date();\n      setCurrentDate(d.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }));\n    }, 60000);\n    const timeInterval = setInterval(() => {\n      const d = new Date();\n      setCurrentTime(d.toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit', second: '2-digit' }));\n    }, 1000);\n    return () => {\n      clearInterval(dateInterval);\n      clearInterval(timeInterval);\n    };\n  }, []);\n\n  useEffect(() => {\n    const onKey = (e: KeyboardEvent) => {\n      if (e.ctrlKey || e.altKey || e.metaKey) return;\n      const k = e.key.toLowerCase();\n      if (k === 'n') { window.location.href = '/announcements/new'; }\n      if (k === 'a') { window.location.href = '/actors'; }\n      if (k === 'p') { window.location.href = '/programs'; }\n      if (k === 'd') { window.location.href = '/dashboard'; }\n    };\n    window.addEventListener('keydown', onKey);\n    return () => window.removeEventListener('keydown', onKey);\n  }, []);\n\n  const fetchDashboardData = async () => {\n    try {\n      const [announcementsRes, actorsRes, programsRes] = await Promise.all([\n        axios.get('/api/announcements'),\n        axios.get('/api/actors'),\n        axios.get('/api/programs')\n      ]);\n\n      const announcements = announcementsRes.data;\n      const today = new Date().toISOString().split('T')[0];\n      const todayCount = announcements.filter((a: any) => a.date === today).length;\n\n      setStats({\n        totalAnnouncements: announcements.length,\n        todayAnnouncements: todayCount,\n        totalActors: actorsRes.data.length,\n        totalPrograms: programsRes.data.length\n      });\n\n      setRecentAnnouncements(announcements.slice(0, 5));\n    } catch (error) {\n      toast.error('خطا در دریافت اطلاعات داشبورد');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDeleteAnnouncement = async (id: string) => {\n  if (window.confirm('آیا از حذف این آفیش مطمئن هستید؟')) {\n      try {\n        await axios.delete(`/api/announcements/${id}`);\n    toast.success('آفیش با موفقیت حذف شد');\n        fetchDashboardData();\n      } catch (error) {\n    toast.error('خطا در حذف آفیش');\n      }\n    }\n  };\n\n  const menuItems = [\n  { title: 'آفیش‌ها', icon: FaFileAlt, link: '/announcements', color: '#3498db' },\n    { title: 'عوامل', icon: FaUsers, link: '/actors', color: '#2ecc71' },\n    { title: 'برنامه‌ها', icon: FaCalendarAlt, link: '/programs', color: '#e74c3c' },\n    { title: 'نمایش عمومی', icon: FaEye, link: '/display', color: '#9b59b6' },\n  ];\n\n  if (loading) {\n    return (\n      <div className=\"dashboard-loading\">\n        <div className=\"loading-spinner\"></div>\n        <p>در حال بارگذاری...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"dashboard-container\">\n      <div className=\"dashboard-header\">\n        <h1>داشبورد مدیریت</h1>\n        <div className=\"header-actions\">\n          <div className=\"header-meta\">\n            <div className=\"current-date\">{currentDate}</div>\n            <div className=\"live-time\">{currentTime}</div>\n          </div>\n          <button onClick={logout} className=\"btn btn-danger\">\n            <FaSignOutAlt />\n            خروج\n          </button>\n        </div>\n      </div>\n\n      <div className=\"stats-grid\">\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#3498db' }}>\n            <FaFileAlt />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.totalAnnouncements}</h3>\n  <p>کل آفیش‌ها</p>\n          </div>\n        </div>\n\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#2ecc71' }}>\n            <FaCalendarAlt />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.todayAnnouncements}</h3>\n  <p>آفیش‌های امروز</p>\n          </div>\n        </div>\n\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#e74c3c' }}>\n            <FaUsers />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.totalActors}</h3>\n            <p>کل عوامل</p>\n          </div>\n        </div>\n\n        <div className=\"stat-card\">\n          <div className=\"stat-icon\" style={{ backgroundColor: '#f39c12' }}>\n            <FaChartBar />\n          </div>\n          <div className=\"stat-info\">\n            <h3>{stats.totalPrograms}</h3>\n            <p>کل برنامه‌ها</p>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"dashboard-content\">\n        <div className=\"quick-actions\">\n          <h2>عملیات سریع</h2>\n          <div className=\"action-grid\">\n            {menuItems.map((item, index) => (\n              <Link key={index} to={item.link} className=\"action-card\" style={{ borderColor: item.color }}>\n                <div className=\"action-icon\" style={{ color: item.color }}>\n                  <item.icon />\n                </div>\n                <h3>{item.title}</h3>\n              </Link>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"recent-announcements\">\n          <div className=\"section-header\">\n  <h2>آخرین آفیش‌ها</h2>\n            <Link to=\"/announcements/new\" className=\"btn btn-success\">\n              <FaPlus />\n  آفیش جدید\n            </Link>\n          </div>\n\n          <div className=\"announcements-table\">\n            <table>\n              <thead>\n                <tr>\n                  <th>عنوان</th>\n                  <th>تاریخ</th>\n                  <th>زمان</th>\n                  <th>برنامه</th>\n                  <th>عملیات</th>\n                </tr>\n              </thead>\n              <tbody>\n                {recentAnnouncements.length === 0 ? (\n                  <tr>\n  <td colSpan={5} className=\"empty-message\">هیچ آفیشی یافت نشد</td>\n                  </tr>\n                ) : (\n                  recentAnnouncements.map((announcement: any) => (\n                    <tr key={announcement.id}>\n                      <td>{announcement.title}</td>\n                      <td>{announcement.date}</td>\n                      <td>{announcement.time}</td>\n                      <td>{announcement.program_title || '-'}</td>\n                      <td className=\"actions\">\n                        <Link to={`/announcements/${announcement.id}`} className=\"action-btn view\">\n                          <FaEye />\n                        </Link>\n                        <Link to={`/announcements/${announcement.id}/edit`} className=\"action-btn edit\">\n                          <FaEdit />\n                        </Link>\n                        <button\n                          onClick={() => handleDeleteAnnouncement(announcement.id)}\n                          className=\"action-btn delete\"\n                        >\n                          <FaTrash />\n                        </button>\n                      </td>\n                    </tr>\n                  ))\n                )}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Dashboard;\n","D:\\AI_Projects\\proj2\\client\\src\\pages\\AnnouncementDetail.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\Actors.tsx",["139"],"import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport { FaPlus, FaEdit, FaTrash, FaSearch, FaUser } from 'react-icons/fa';\nimport axios from 'axios';\nimport './Actors.css';\nimport { toPersianDigits } from '../utils/locale';\n\nconst Actors: React.FC = () => {\n  const [actors, setActors] = useState([]);\n  const [filteredActors, setFilteredActors] = useState([]);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [roleFilter, setRoleFilter] = useState('');\n  const [presets, setPresets] = useState<Array<{ name: string; search: string; role: string }>>([]);\n  const [presetName, setPresetName] = useState('');\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchActors();\n    const saved = localStorage.getItem('actors_filter_presets');\n    if (saved) { try { setPresets(JSON.parse(saved)); } catch { } }\n  }, []);\n\n  useEffect(() => {\n    filterActors();\n  }, [actors, searchTerm]);\n\n  const fetchActors = async () => {\n    try {\n      const response = await axios.get('/api/actors');\n      setActors(response.data);\n    } catch (error) {\n      toast.error('خطا در دریافت لیست عوامل');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const filterActors = () => {\n    let filtered = actors;\n\n    if (searchTerm) {\n      filtered = filtered.filter((actor: any) =>\n        actor.name.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        actor.role?.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        actor.phone?.includes(searchTerm) ||\n        actor.email?.toLowerCase().includes(searchTerm.toLowerCase())\n      );\n    }\n\n    if (roleFilter) {\n      filtered = filtered.filter((actor: any) => (actor.role || '').toLowerCase() === roleFilter.toLowerCase());\n    }\n\n    setFilteredActors(filtered);\n  };\n\n  const savePreset = () => {\n    if (!presetName.trim()) { toast.error('نام پرِست را وارد کنید'); return; }\n    const next = presets.filter(p => p.name !== presetName).concat([{ name: presetName, search: searchTerm, role: roleFilter }]);\n    setPresets(next);\n    localStorage.setItem('actors_filter_presets', JSON.stringify(next));\n    toast.success('پرِست ذخیره شد');\n  };\n\n  const applyPreset = (name: string) => {\n    const p = presets.find(pp => pp.name === name);\n    if (p) { setSearchTerm(p.search); setRoleFilter(p.role); }\n  };\n\n  const handleDelete = async (id: string) => {\n    if (window.confirm('آیا از حذف این عامل مطمئن هستید؟')) {\n      try {\n        await axios.delete(`/api/actors/${id}`);\n        toast.success('عامل با موفقیت حذف شد');\n        fetchActors();\n      } catch (error) {\n        toast.error('خطا در حذف عامل');\n      }\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"actors-container\">\n        <div className=\"page-header\">\n          <h1>مدیریت عوامل</h1>\n          <button className=\"btn btn-success\" disabled>\n            <FaPlus />\n            عامل جدید\n          </button>\n        </div>\n        <div className=\"filters-section skeleton-block\" />\n        <div className=\"actors-grid\">\n          {Array.from({ length: 6 }).map((_, i) => (\n            <div key={i} className=\"actor-card skeleton\">\n              <div className=\"card-header\">\n                <div className=\"actor-info\">\n                  <div className=\"actor-avatar skeleton-avatar\" />\n                  <div style={{ flex: 1 }}>\n                    <div className=\"skeleton-title\" />\n                    <div className=\"skeleton-small\" />\n                  </div>\n                </div>\n                <div className=\"card-actions\">\n                  <div className=\"skeleton-small\" style={{ width: 35, height: 35 }} />\n                  <div className=\"skeleton-small\" style={{ width: 35, height: 35 }} />\n                </div>\n              </div>\n              <div className=\"card-content\">\n                <div className=\"skeleton-line\" />\n                <div className=\"skeleton-line\" />\n                <div className=\"skeleton-line short\" />\n              </div>\n              <div className=\"card-footer\">\n                <div className=\"skeleton-small\" />\n                <div className=\"skeleton-badge\" />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"actors-container\">\n      <div className=\"page-header\">\n        <h1>مدیریت عوامل</h1>\n        <Link to=\"/actors/new\" className=\"btn btn-success\">\n          <FaPlus />\n          عامل جدید\n        </Link>\n      </div>\n\n      <div className=\"filters-section\">\n        <div className=\"search-box\">\n          <FaSearch />\n          <input\n            type=\"text\"\n            placeholder=\"جستجو در نام، نقش، تلفن یا ایمیل...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"search-input\"\n          />\n        </div>\n        <div className=\"status-filter\" style={{ display: 'flex', gap: '8px', alignItems: 'center' }}>\n          <input\n            type=\"text\"\n            placeholder=\"فیلتر نقش دقیق (مثلاً کارگردان)\"\n            value={roleFilter}\n            onChange={(e) => setRoleFilter(e.target.value)}\n            className=\"search-input\"\n            style={{ maxWidth: '240px' }}\n          />\n          <input type=\"text\" value={presetName} onChange={(e) => setPresetName(e.target.value)} placeholder=\"نام پرِست\" className=\"preset-input\" />\n          <button className=\"btn btn-light\" onClick={savePreset}>ذخیره پرِست</button>\n          {presets.length > 0 && (\n            <select onChange={(e) => applyPreset(e.target.value)} className=\"preset-select\">\n              <option value=\"\">اعمال پرِست...</option>\n              {presets.map(p => (<option key={p.name} value={p.name}>{p.name}</option>))}\n            </select>\n          )}\n        </div>\n      </div>\n\n      <div className=\"actors-grid\">\n        {filteredActors.length === 0 ? (\n          <div className=\"empty-state\">\n            <FaUser />\n            <p>هیچ عاملی یافت نشد</p>\n            <Link to=\"/actors/new\" className=\"btn btn-success\">\n              ایجاد اولین عامل\n            </Link>\n          </div>\n        ) : (\n          filteredActors.map((actor: any) => (\n            <div key={actor.id} className=\"actor-card\">\n              <div className=\"card-header\">\n                <div className=\"actor-info\">\n                  <div className=\"actor-avatar\">\n                    <FaUser />\n                  </div>\n                  <div className=\"actor-details\">\n                    <h3>{actor.name}</h3>\n                    {actor.role && <p className=\"actor-role\">{actor.role}</p>}\n                  </div>\n                </div>\n                <div className=\"card-actions\">\n                  <Link\n                    to={`/actors/${actor.id}/edit`}\n                    className=\"action-btn edit\"\n                    title=\"ویرایش\"\n                  >\n                    <FaEdit />\n                  </Link>\n                  <button\n                    onClick={() => handleDelete(actor.id)}\n                    className=\"action-btn delete\"\n                    title=\"حذف\"\n                  >\n                    <FaTrash />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"card-content\">\n                {actor.phone && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">تلفن:</span>\n                    <span className=\"value\">{toPersianDigits(actor.phone)}</span>\n                  </div>\n                )}\n                {actor.email && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">ایمیل:</span>\n                    <span className=\"value\">{actor.email}</span>\n                  </div>\n                )}\n                {actor.address && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">آدرس:</span>\n                    <span className=\"value\">{actor.address}</span>\n                  </div>\n                )}\n                {actor.description && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">توضیحات:</span>\n                    <span className=\"value\">{actor.description}</span>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"card-footer\">\n                <div className=\"created-info\">\n                  ایجاد شده در: {new Date(actor.created_at).toLocaleDateString('fa-IR')}\n                </div>\n                <div className=\"status-badge\">\n                  {actor.status === 'active' ? 'فعال' : 'غیرفعال'}\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Actors;\n","D:\\AI_Projects\\proj2\\client\\src\\pages\\CreateAnnouncement.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\Programs.tsx",["140"],"import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport { FaPlus, FaEdit, FaTrash, FaSearch, FaCalendarAlt, FaClock } from 'react-icons/fa';\nimport axios from 'axios';\nimport './Programs.css';\nimport { toPersianDigits } from '../utils/locale';\n\nconst Programs: React.FC = () => {\n  const [programs, setPrograms] = useState([]);\n  const [filteredPrograms, setFilteredPrograms] = useState([]);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchPrograms();\n  }, []);\n\n  useEffect(() => {\n    filterPrograms();\n  }, [programs, searchTerm]);\n\n  const fetchPrograms = async () => {\n    try {\n      const response = await axios.get('/api/programs');\n      setPrograms(response.data);\n    } catch (error) {\n      toast.error('خطا در دریافت لیست برنامه‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const filterPrograms = () => {\n    let filtered = programs;\n\n    if (searchTerm) {\n      filtered = filtered.filter((program: any) =>\n        (program.title || '').toLowerCase().includes(searchTerm.toLowerCase()) ||\n        (program.description || '').toLowerCase().includes(searchTerm.toLowerCase()) ||\n        (program.program_type || '').toLowerCase().includes(searchTerm.toLowerCase())\n      );\n    }\n\n    setFilteredPrograms(filtered);\n  };\n\n  const handleDelete = async (id: string) => {\n    if (window.confirm('آیا از حذف این برنامه مطمئن هستید؟')) {\n      try {\n        await axios.delete(`/api/programs/${id}`);\n        toast.success('برنامه با موفقیت حذف شد');\n        fetchPrograms();\n      } catch (error) {\n        toast.error('خطا در حذف برنامه');\n      }\n    }\n  };\n\n  const getProgramTypeColor = (type: string) => {\n    const colors = {\n      'theater': '#e74c3c',\n      'music': '#9b59b6',\n      'dance': '#f39c12',\n      'concert': '#27ae60',\n      'workshop': '#3498db',\n      'exhibition': '#e67e22',\n      'conference': '#1abc9c',\n      'other': '#95a5a6'\n    };\n    return colors[type as keyof typeof colors] || colors.other;\n  };\n\n  const getProgramTypeLabel = (type: string) => {\n    const labels = {\n      'theater': 'تئاتر',\n      'music': 'موسیقی',\n      'dance': 'رقص',\n      'concert': 'کنسرت',\n      'workshop': 'کارگاه',\n      'exhibition': 'نمایشگاه',\n      'conference': 'کنفرانس',\n      'other': 'سایر'\n    };\n    return labels[type as keyof typeof labels] || labels.other;\n  };\n\n  if (loading) {\n    return (\n      <div className=\"loading-container\">\n        <div className=\"loading-spinner\"></div>\n        <p>در حال بارگذاری...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"programs-container\">\n      <div className=\"page-header\">\n        <h1>مدیریت برنامه‌ها</h1>\n        <Link to=\"/programs/new\" className=\"btn btn-success\">\n          <FaPlus />\n          برنامه جدید\n        </Link>\n      </div>\n\n      <div className=\"filters-section\">\n        <div className=\"search-box\">\n          <FaSearch />\n          <input\n            type=\"text\"\n            placeholder=\"جستجو در نام، توضیحات یا نوع برنامه...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"search-input\"\n          />\n        </div>\n      </div>\n\n      <div className=\"programs-grid\">\n        {filteredPrograms.length === 0 ? (\n          <div className=\"empty-state\">\n            <FaCalendarAlt />\n            <p>هیچ برنامه‌ای یافت نشد</p>\n            <Link to=\"/programs/new\" className=\"btn btn-success\">\n              ایجاد اولین برنامه\n            </Link>\n          </div>\n        ) : (\n          filteredPrograms.map((program: any) => (\n            <div key={program.id} className=\"program-card\">\n              <div className=\"card-header\">\n                <div className=\"program-info\">\n                  <div\n                    className=\"program-type-badge\"\n                    style={{ backgroundColor: getProgramTypeColor(program.program_type) }}\n                  >\n                    {getProgramTypeLabel(program.program_type)}\n                  </div>\n                  <h3>{program.title}</h3>\n                </div>\n                <div className=\"card-actions\">\n                  <Link\n                    to={`/programs/${program.id}/edit`}\n                    className=\"action-btn edit\"\n                    title=\"ویرایش\"\n                  >\n                    <FaEdit />\n                  </Link>\n                  <button\n                    onClick={() => handleDelete(program.id)}\n                    className=\"action-btn delete\"\n                    title=\"حذف\"\n                  >\n                    <FaTrash />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"card-content\">\n                {program.description && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">توضیحات:</span>\n                    <span className=\"value\">{program.description}</span>\n                  </div>\n                )}\n                {program.duration && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">مدت زمان:</span>\n                    <span className=\"value duration\">\n                      <FaClock />\n                      {toPersianDigits(program.duration)} دقیقه\n                    </span>\n                  </div>\n                )}\n                {program.capacity && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">ظرفیت:</span>\n                    <span className=\"value\">{toPersianDigits(program.capacity)} نفر</span>\n                  </div>\n                )}\n                {program.price && (\n                  <div className=\"info-item\">\n                    <span className=\"label\">قیمت:</span>\n                    <span className=\"value price\">{toPersianDigits(program.price.toLocaleString())} تومان</span>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"card-footer\">\n                <div className=\"created-info\">\n                  ایجاد شده در: {new Date(program.created_at).toLocaleDateString('fa-IR')}\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Programs;\n","D:\\AI_Projects\\proj2\\client\\src\\pages\\Announcements.tsx",["141","142","143"],"import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport {\n  FaPlus, FaEye, FaEdit, FaTrash, FaSearch, FaCalendar,\n  FaDownload, FaPrint, FaFilePdf\n} from 'react-icons/fa';\nimport axios from 'axios';\nimport DateObject from 'react-date-object';\nimport persian from 'react-date-object/calendars/persian';\nimport gregorian from 'react-date-object/calendars/gregorian';\nimport DatePicker from 'react-multi-date-picker';\nimport { toPersianDigits } from '../utils/locale';\nimport announcementGenerator from '../utils/announcementGenerator';\nimport './Announcements.css';\n\nconst Announcements: React.FC = () => {\n  const [announcements, setAnnouncements] = useState([]);\n  const [filteredAnnouncements, setFilteredAnnouncements] = useState([]);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [dateFilter, setDateFilter] = useState('');\n  const [statusFilter, setStatusFilter] = useState<string>('');\n  const [presetName, setPresetName] = useState('');\n  const [presets, setPresets] = useState<Array<{ name: string; search: string; date: string; status: string }>>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchAnnouncements();\n    const saved = localStorage.getItem('ann_filter_presets');\n    if (saved) {\n      try { setPresets(JSON.parse(saved)); } catch { }\n    }\n  }, []);\n\n  useEffect(() => {\n    filterAnnouncements();\n  }, [announcements, searchTerm, dateFilter]);\n\n  const fetchAnnouncements = async () => {\n    try {\n      const response = await axios.get('/api/announcements');\n      setAnnouncements(response.data);\n    } catch (error) {\n      toast.error('خطا در دریافت آفیش‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const filterAnnouncements = () => {\n    let filtered = announcements;\n\n    if (searchTerm) {\n      filtered = filtered.filter((announcement: any) =>\n        announcement.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        (announcement.program_title || announcement.program?.name || '')\n          .toLowerCase().includes(searchTerm.toLowerCase()) ||\n        announcement.actors?.some((actor: any) =>\n          actor.name.toLowerCase().includes(searchTerm.toLowerCase())\n        )\n      );\n    }\n\n    if (dateFilter) {\n      filtered = filtered.filter((announcement: any) =>\n        announcement.date === dateFilter\n      );\n    }\n\n    if (statusFilter) {\n      filtered = filtered.filter((announcement: any) =>\n        (announcement.status || '') === statusFilter\n      );\n    }\n\n    setFilteredAnnouncements(filtered);\n  };\n\n  const handleDelete = async (id: string) => {\n    if (window.confirm('آیا از حذف این آفیش مطمئن هستید؟')) {\n      try {\n        // Optimistic UI\n        const prev = announcements;\n        setAnnouncements((list: any) => list.filter((a: any) => a.id !== id));\n        setFilteredAnnouncements((list: any) => list.filter((a: any) => a.id !== id));\n        const token = localStorage.getItem('token');\n        await axios.delete(`/api/announcements/${id}`, {\n          headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n        });\n        toast.success('آفیش با موفقیت حذف شد');\n      } catch (error) {\n        toast.error('خطا در حذف آفیش؛ بازگشت به حالت قبل');\n        fetchAnnouncements();\n      }\n    }\n  };\n\n  const savePreset = () => {\n    if (!presetName.trim()) { toast.error('نام پرِست را وارد کنید'); return; }\n    const next = presets.filter(p => p.name !== presetName).concat([{ name: presetName, search: searchTerm, date: dateFilter, status: statusFilter }]);\n    setPresets(next);\n    localStorage.setItem('ann_filter_presets', JSON.stringify(next));\n    toast.success('پرِست ذخیره شد');\n  };\n\n  const applyPreset = (p: { name: string; search: string; date: string; status: string }) => {\n    setSearchTerm(p.search);\n    setDateFilter(p.date);\n    setStatusFilter(p.status);\n  };\n\n  const handlePrint = async (announcement: any) => {\n    try {\n      await announcementGenerator.generatePDF(announcement);\n      toast.success('فایل PDF با موفقیت ایجاد شد');\n    } catch (error) {\n      toast.error('خطا در ایجاد فایل PDF');\n    }\n  };\n\n  const formatDate = (dateString: string) => {\n    try {\n      const obj = new DateObject({ date: new Date(dateString) });\n      return obj.convert(persian).format('YYYY/MM/DD');\n    } catch {\n      return dateString;\n    }\n  };\n\n  const formatTime = (timeString: string) => {\n    return toPersianDigits(timeString || '');\n  };\n\n  if (loading) {\n    return (\n      <div className=\"announcements-container\">\n        <div className=\"page-header\">\n          <h1>مدیریت آفیش‌ها</h1>\n          <button className=\"add-btn\" disabled>\n            <FaPlus />\n            آفیش جدید\n          </button>\n        </div>\n        <div className=\"filters-section skeleton-block\" />\n        <div className=\"announcements-grid\">\n          {Array.from({ length: 6 }).map((_, i) => (\n            <div key={i} className=\"announcement-card skeleton\">\n              <div className=\"skeleton-title\" />\n              <div className=\"skeleton-line\" />\n              <div className=\"skeleton-line\" />\n              <div className=\"skeleton-line short\" />\n              <div className=\"card-footer\">\n                <div className=\"skeleton-badge\" />\n                <div className=\"skeleton-small\" />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"announcements-container\">\n      <div className=\"page-header\">\n        <h1>مدیریت آفیش‌ها</h1>\n        <Link to=\"/announcements/new\" className=\"add-btn\">\n          <FaPlus />\n          آفیش جدید\n        </Link>\n      </div>\n\n      <div className=\"filters-section\">\n        <div className=\"search-box\">\n          <FaSearch />\n          <input\n            type=\"text\"\n            placeholder=\"جستجو در عنوان، برنامه یا عوامل...\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"search-input\"\n          />\n        </div>\n        <div className=\"date-filter\">\n          <FaCalendar />\n          <DatePicker\n            calendar={persian}\n            inputClass=\"date-input\"\n            value={dateFilter ? new DateObject({ date: new Date(dateFilter) }).convert(persian) : null}\n            onChange={(val: any) => {\n              if (!val) { setDateFilter(''); return; }\n              try {\n                const obj = val instanceof DateObject ? val : new DateObject(val);\n                const g = obj.convert(gregorian).format('YYYY-MM-DD');\n                setDateFilter(g);\n              } catch {\n                toast.error('خطا در تنظیم فیلتر تاریخ');\n              }\n            }}\n            format=\"YYYY/MM/DD\"\n            placeholder=\"فیلتر تاریخ (شمسی)\"\n          />\n          {dateFilter && (\n            <button\n              onClick={() => setDateFilter('')}\n              className=\"clear-date-btn\"\n            >\n              حذف فیلتر\n            </button>\n          )}\n        </div>\n        <div className=\"status-filter\">\n          <select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value)} className=\"status-select\">\n            <option value=\"\">همه وضعیت‌ها</option>\n            <option value=\"published\">منتشر شده</option>\n            <option value=\"draft\">پیش‌نویس</option>\n          </select>\n        </div>\n        <div className=\"preset-controls\">\n          <input type=\"text\" value={presetName} onChange={(e) => setPresetName(e.target.value)} placeholder=\"نام پرِست\" className=\"preset-input\" />\n          <button className=\"btn btn-light\" onClick={savePreset}>ذخیره پرِست</button>\n          {presets.length > 0 && (\n            <select onChange={(e) => { const p = presets.find(pp => pp.name === e.target.value); if (p) applyPreset(p); }} className=\"preset-select\">\n              <option value=\"\">اعمال پرِست...</option>\n              {presets.map(p => (<option key={p.name} value={p.name}>{p.name}</option>))}\n            </select>\n          )}\n        </div>\n      </div>\n\n      <div className=\"announcements-grid\">\n        {filteredAnnouncements.length === 0 ? (\n          <div className=\"empty-state\">\n            <FaFilePdf />\n            <p>هیچ آفیشی یافت نشد</p>\n            <Link to=\"/announcements/new\" className=\"create-first-btn\">\n              ایجاد اولین آفیش\n            </Link>\n          </div>\n        ) : (\n          filteredAnnouncements.map((announcement: any) => (\n            <div key={announcement.id} className=\"announcement-card\">\n              <div className=\"card-header\">\n                <h3>{announcement.title}</h3>\n                <div className=\"card-actions\">\n                  <button\n                    onClick={() => handlePrint(announcement)}\n                    className=\"action-btn print\"\n                    title=\"چاپ/دانلود PDF\"\n                  >\n                    <FaDownload />\n                  </button>\n                  <Link\n                    to={`/announcements/${announcement.id}`}\n                    className=\"action-btn view\"\n                    title=\"مشاهده\"\n                  >\n                    <FaEye />\n                  </Link>\n                  <Link\n                    to={`/announcements/${announcement.id}/edit`}\n                    className=\"action-btn edit\"\n                    title=\"ویرایش\"\n                  >\n                    <FaEdit />\n                  </Link>\n                  <button\n                    onClick={() => handleDelete(announcement.id)}\n                    className=\"action-btn delete\"\n                    title=\"حذف\"\n                  >\n                    <FaTrash />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"card-content\">\n                <div className=\"info-row\">\n                  <span className=\"label\">برنامه:</span>\n                  <span className=\"value\">{announcement.program_title || 'بدون برنامه'}</span>\n                </div>\n                <div className=\"info-row\">\n                  <span className=\"label\">تاریخ:</span>\n                  <span className=\"value\">{formatDate(announcement.date)}</span>\n                </div>\n                <div className=\"info-row\">\n                  <span className=\"label\">زمان:</span>\n                  <span className=\"value\">{formatTime(announcement.time)}</span>\n                </div>\n                <div className=\"info-row\">\n                  <span className=\"label\">مکان:</span>\n                  <span className=\"value\">{announcement.venue || 'ثبت نشده'}</span>\n                </div>\n                {/* نمایش عوامل در فهرست نیازمند دریافت جداگانه است؛ فعلاً پنهان می‌ماند */}\n                {announcement.description && (\n                  <div className=\"info-row\">\n                    <span className=\"label\">توضیحات:</span>\n                    <span className=\"value description\">{announcement.description}</span>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"card-footer\">\n                <div className=\"status-badge\">\n                  {announcement.status === 'published' ? 'منتشر شده' : 'پیش‌نویس'}\n                </div>\n                <div className=\"created-info\">\n                  ایجاد شده در: {formatDate(announcement.created_at?.split('T')[0])}\n                </div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Announcements;\n","D:\\AI_Projects\\proj2\\client\\src\\pages\\CreateActor.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\PosterView.tsx",["144"],"import React, { useState, useEffect } from 'react';\nimport { useParams, useNavigate } from 'react-router-dom';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport './PosterView.css';\nimport Logo from '../components/Logo';\n\nconst PosterView: React.FC = () => {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const [announcement, setAnnouncement] = useState<any>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    fetchAnnouncement();\n  }, [id]);\n\n  const fetchAnnouncement = async () => {\n    try {\n      const response = await axios.get(`/api/announcements/${id}`);\n      setAnnouncement(response.data);\n    } catch (error) {\n      toast.error('خطا در بارگیری اطلاعات آفیش');\n      console.error('Error fetching announcement:', error);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const handleDownload = async () => {\n    try {\n      const element = document.getElementById('poster-content');\n      if (element) {\n        const html2canvas = (await import('html2canvas')).default;\n        const canvas = await html2canvas(element, {\n          scale: 2,\n          useCORS: true,\n          allowTaint: true\n        });\n\n        const link = document.createElement('a');\n        link.download = `poster-${announcement?.id || 'announcement'}.png`;\n        link.href = canvas.toDataURL();\n        link.click();\n      }\n    } catch (error) {\n      toast.error('خطا در دانلود پوستر');\n      console.error('Error downloading poster:', error);\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"poster-view-loading\">\n        <div className=\"spinner\"></div>\n        <p>در حال بارگیری...</p>\n      </div>\n    );\n  }\n\n  if (!announcement) {\n    return (\n      <div className=\"poster-view-error\">\n        <p>آفیش مورد نظر یافت نشد</p>\n        <button onClick={() => navigate('/')} className=\"btn btn-primary\">\n          بازگشت به خانه\n        </button>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"poster-view-container\">\n      <div className=\"print-logo\" aria-hidden=\"true\">\n        <Logo src=\"/logo.png.jpg\" height={144} width={144} alt=\"لوگو\" />\n      </div>\n      <div className=\"poster-actions\">\n        <button onClick={() => navigate(-1)} className=\"btn btn-secondary\">\n          بازگشت\n        </button>\n        <div className=\"action-buttons\">\n          <button onClick={handlePrint} className=\"btn btn-print\">\n            چاپ\n          </button>\n          <button onClick={handleDownload} className=\"btn btn-download\">\n            دانلود\n          </button>\n        </div>\n      </div>\n\n      <div id=\"poster-content\" className=\"poster-content\">\n        <div className=\"poster-header\">\n          <h1>{announcement.title}</h1>\n          <div className=\"announcement-meta\">\n            <span className=\"announcement-date\">\n              {new Date(announcement.date).toLocaleDateString('fa-IR')}\n            </span>\n            <span className=\"announcement-time\">\n              ساعت {announcement.time}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"poster-body\">\n          {announcement.poster_image && (\n            <div className=\"poster-image\">\n              <img\n                src={announcement.poster_image.startsWith('http') ? announcement.poster_image : `/uploads/${announcement.poster_image}`}\n                alt={announcement.title}\n                crossOrigin=\"anonymous\"\n              />\n            </div>\n          )}\n\n          <div className=\"announcement-details\">\n            <div className=\"detail-section\">\n              <h3>توضیحات</h3>\n              <p>{announcement.description}</p>\n            </div>\n\n            {announcement.actors && announcement.actors.length > 0 && (\n              <div className=\"detail-section\">\n                <h3>عوامل</h3>\n                <div className=\"actors-list\">\n                  {announcement.actors.map((actor: any) => (\n                    <div key={actor.id} className=\"actor-item\">\n                      {actor.name}\n                      {actor.role_in_program && (\n                        <span className=\"actor-role\"> — {actor.role_in_program}</span>\n                      )}\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            {announcement.program_title && (\n              <div className=\"detail-section\">\n                <h3>برنامه</h3>\n                <div className=\"programs-list\">\n                  <div className=\"program-item\">{announcement.program_title}</div>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n\n        <div className=\"poster-footer\">\n          <p>سامانه رسا</p>\n          <p className=\"poster-date\">\n            {new Date().toLocaleDateString('fa-IR')}\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default PosterView;\n","D:\\AI_Projects\\proj2\\client\\src\\pages\\CreateProgram.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\DisplayPage.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\Roles.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\Estimates.tsx",["145","146"],"import React, { useEffect, useMemo, useState } from 'react';\nimport axios from 'axios';\nimport { toast } from '../libs/toast';\nimport { Link } from 'react-router-dom';\n\nconst toPersianDigits = (str: string | number) => {\n  const s = String(str);\n  const d = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\n  return s.replace(/[0-9]/g, (w) => d[+w]);\n};\n\nconst Estimates: React.FC = () => {\n  const [estimates, setEstimates] = useState<any[]>([]);\n  const [programs, setPrograms] = useState<any[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [programId, setProgramId] = useState<string>('');\n  const token = localStorage.getItem('token');\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\n\n  useEffect(() => {\n    fetchPrograms();\n  }, []);\n\n  useEffect(() => {\n    fetchEstimates();\n  }, [programId]);\n\n  const fetchPrograms = async () => {\n    try {\n      const res = await axios.get('/api/programs');\n      setPrograms(res.data);\n    } catch {\n      toast.error('خطا در دریافت برنامه‌ها');\n    }\n  };\n\n  const fetchEstimates = async () => {\n    setLoading(true);\n    try {\n      const url = programId ? `/api/estimates?program_id=${programId}` : '/api/estimates';\n      const res = await axios.get(url);\n      setEstimates(res.data);\n    } catch {\n      toast.error('خطا در دریافت برآوردها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const deleteEstimate = async (id: number) => {\n    if (!window.confirm('از حذف برآورد مطمئن هستید؟')) return;\n    try {\n      await axios.delete(`/api/estimates/${id}`, { headers: authHeaders });\n      toast.success('برآورد حذف شد');\n      fetchEstimates();\n    } catch {\n      toast.error('حذف برآورد با خطا مواجه شد');\n    }\n  };\n\n  return (\n    <div className=\"page-container\">\n      <div className=\"page-header\">\n        <h1>برآوردهای برنامه‌ها</h1>\n        <Link to=\"/estimates/new\" className=\"btn btn-primary\">ثبت برآورد جدید</Link>\n      </div>\n\n      <div className=\"filters\">\n        <div className=\"form-row\">\n          <label>برنامه</label>\n          <select value={programId} onChange={(e) => setProgramId(e.target.value)}>\n            <option value=\"\">همه</option>\n            {programs.map((p) => (\n              <option key={p.id} value={p.id}>{p.name}</option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {loading ? (\n        <div className=\"loading-container\"><div className=\"loading-spinner\"></div><p>در حال بارگذاری...</p></div>\n      ) : (\n        <div className=\"list-card\">\n          {estimates.length === 0 ? (\n            <p>برآوردی یافت نشد.</p>\n          ) : (\n            <table className=\"data-table\">\n              <thead>\n                <tr>\n                  <th>کد برآورد</th>\n                  <th>برنامه</th>\n                  <th>مدت (دقیقه)</th>\n                  <th>تعداد برنامه</th>\n                  <th>نرخ هر دقیقه</th>\n                  <th>مبلغ کل</th>\n                  <th>تاریخ ثبت</th>\n                  <th>انقضا</th>\n                  <th>عملیات</th>\n                </tr>\n              </thead>\n              <tbody>\n                {estimates.map((e) => {\n                  const totalMinutes = (e.program_count || 0) * (e.duration_minutes || 0);\n                  const totalAmount = totalMinutes * (e.minute_rate || 0);\n                  const prog = programs.find((p) => p.id === e.program_id);\n                  return (\n                    <tr key={e.id}>\n                      <td>{e.estimate_code}</td>\n                      <td>{prog ? prog.name : '—'}</td>\n                      <td>{toPersianDigits(e.duration_minutes)}</td>\n                      <td>{toPersianDigits(e.program_count)}</td>\n                      <td>{toPersianDigits(e.minute_rate)}</td>\n                      <td>{toPersianDigits(totalAmount)}</td>\n                      <td>{e.created_at?.slice(0, 10) || '—'}</td>\n                      <td>{e.expiration_date?.slice(0, 10) || '—'}</td>\n                      <td>\n                        <Link to={`/estimates/${e.id}`} className=\"action-btn\">جزئیات</Link>\n                        <button className=\"action-btn delete\" onClick={() => deleteEstimate(e.id)}>حذف</button>\n                      </td>\n                    </tr>\n                  );\n                })}\n              </tbody>\n            </table>\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default Estimates;","D:\\AI_Projects\\proj2\\client\\src\\pages\\EstimateDetail.tsx",["147","148","149"],"import React, { useEffect, useState } from 'react';\r\nimport axios from 'axios';\r\nimport { useParams, useNavigate } from 'react-router-dom';\r\nimport { toast } from '../libs/toast';\r\n\r\nconst toPersianDigits = (str: string | number) => {\r\n  const s = String(str);\r\n  const d = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];\r\n  return s.replace(/[0-9]/g, (w) => d[+w]);\r\n};\r\n\r\nconst EstimateDetail: React.FC = () => {\r\n  const { id } = useParams();\r\n  const [estimate, setEstimate] = useState<any>(null);\r\n  const [roles, setRoles] = useState<any[]>([]);\r\n  const [savingRoleId, setSavingRoleId] = useState<number | null>(null);\r\n  const [programs, setPrograms] = useState<any[]>([]);\r\n  const navigate = useNavigate();\r\n\r\n  useEffect(() => { fetchPrograms(); }, []);\r\n  useEffect(() => { if (id) fetchEstimate(); }, [id]);\r\n\r\n  const fetchPrograms = async () => {\r\n    try { const res = await axios.get('/api/programs'); setPrograms(res.data); }\r\n    catch { /* ignore */ }\r\n  };\r\n\r\n  const fetchEstimate = async () => {\r\n    try {\r\n      const res = await axios.get(`/api/estimates/${id}`);\r\n      const est = res.data;\r\n      setEstimate(est);\r\n      setRoles(est.roles || []);\r\n    } catch {\r\n      toast.error('دریافت جزئیات برآورد با خطا مواجه شد');\r\n    }\r\n  };\r\n\r\n  const token = localStorage.getItem('token');\r\n  const authHeaders = token ? { Authorization: `Bearer ${token}` } : undefined;\r\n\r\n  const updateRoleWage = async (row: any) => {\r\n    if (!id) return;\r\n    setSavingRoleId(row.id);\r\n    const payload: any = {\r\n      role_id: row.role_id || null,\r\n      role_code: row.role_code || null,\r\n      role_name: row.role_name || null,\r\n      wage_amount: row.wage_amount || null,\r\n      wage_percent: row.wage_percent || null,\r\n    };\r\n    try {\r\n      await axios.post(`/api/estimates/${id}/roles`, payload, { headers: authHeaders });\r\n      toast.success('دستمزد نقش به‌روزرسانی شد');\r\n    } catch {\r\n      toast.error('به‌روزرسانی دستمزد با خطا مواجه شد');\r\n    } finally {\r\n      setSavingRoleId(null);\r\n    }\r\n  };\r\n\r\n  if (!estimate) {\r\n    return <div className=\"loading-container\"><div className=\"loading-spinner\"></div><p>در حال بارگذاری...</p></div>;\r\n  }\r\n\r\n  const prog = programs.find((p) => p.id === estimate.program_id);\r\n  const totalMinutes = (estimate.program_count || 0) * (estimate.duration_minutes || 0);\r\n  const totalAmount = totalMinutes * (estimate.minute_rate || 0);\r\n\r\n  return (\r\n    <div className=\"page-container\">\r\n      <div className=\"page-header\">\r\n        <h1>جزئیات برآورد {estimate.estimate_code}</h1>\r\n        <button className=\"btn\" onClick={() => navigate('/estimates')}>بازگشت</button>\r\n      </div>\r\n\r\n      <div className=\"form-card\">\r\n        <div className=\"info-grid\">\r\n          <div><strong>برنامه:</strong> {estimate.program_title || (prog ? (prog.title || prog.name) : '—')}</div>\r\n          <div><strong>مدت هر برنامه:</strong> {toPersianDigits(estimate.duration_minutes)} دقیقه</div>\r\n          <div><strong>تعداد برنامه:</strong> {toPersianDigits(estimate.program_count)}</div>\r\n          <div><strong>نرخ هر دقیقه:</strong> {toPersianDigits(estimate.minute_rate)} تومان</div>\r\n          <div><strong>دقیقه کل:</strong> {toPersianDigits(totalMinutes)}</div>\r\n          <div><strong>مبلغ کل:</strong> {toPersianDigits(totalAmount)}</div>\r\n          <div><strong>پذیرایی:</strong> {toPersianDigits(estimate.hospitality_amount || 0)}</div>\r\n          <div><strong>ایاب و ذهاب:</strong> {toPersianDigits(estimate.transport_amount || 0)}</div>\r\n          <div><strong>متفرقه:</strong> {toPersianDigits(estimate.misc_amount || 0)}</div>\r\n          <div><strong>تاریخ ثبت:</strong> {estimate.created_at?.slice(0, 10) || '—'}</div>\r\n          <div><strong>انقضا:</strong> {estimate.expiration_date?.slice(0, 10) || '—'}</div>\r\n        </div>\r\n        {estimate.linked_to && (\r\n          <div className=\"hint-row\">پیوست به برآورد: {estimate.linked_to}</div>\r\n        )}\r\n      </div>\r\n\r\n      <div className=\"list-card\">\r\n        <h2>نقش‌ها و دستمزدها</h2>\r\n        {roles.length === 0 ? (\r\n          <p>نقشی برای این برآورد ثبت نشده است.</p>\r\n        ) : (\r\n          <table className=\"data-table\">\r\n            <thead>\r\n              <tr>\r\n                <th>نقش</th>\r\n                <th>کد نقش</th>\r\n                <th>نوع دستمزد</th>\r\n                <th>مقدار</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              {roles.map((r) => (\r\n                <tr key={r.id}>\r\n                  <td>{r.role_name || '—'}</td>\r\n                  <td>{r.role_code || '—'}</td>\r\n                  <td>{r.wage_type === 'percent' ? 'درصدی' : 'عددی'}</td>\r\n                  <td>{toPersianDigits(r.wage_value || 0)}</td>\r\n                </tr>\r\n              ))}\r\n            </tbody>\r\n          </table>\r\n        )}\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default EstimateDetail;","D:\\AI_Projects\\proj2\\client\\src\\pages\\CreateEstimate.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\BulkUpload.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\components\\Layout\\Layout.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\components\\Auth\\ProtectedRoute.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\utils\\persianDate.js",[],"D:\\AI_Projects\\proj2\\client\\src\\utils\\announcementGenerator.js",["150"],"import html2canvas from 'html2canvas';\nimport { jsPDF } from 'jspdf';\nimport persianDate from './persianDate';\n\nexport const announcementGenerator = {\n  // Generate poster HTML\n  generatePosterHTML(announcement) {\n    const {\n      title,\n      description,\n      date,\n      time,\n      venue,\n      price,\n      program_title,\n      program_type,\n      actors\n    } = announcement;\n    \n    const persianDateStr = persianDate.toPersian(date);\n    const dayName = persianDate.getDayName(date);\n    \n    return `\n      <div dir=\"rtl\" style=\"\n        width: 800px;\n        height: 1000px;\n        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        padding: 40px;\n        font-family: 'IRANSans', Tahoma, Arial, sans-serif;\n        color: white;\n        position: relative;\n        overflow: hidden;\n      \">\n        <!-- Decorative background -->\n        <div style=\"\n          position: absolute;\n          top: 0;\n          left: 0;\n          right: 0;\n          bottom: 0;\n          background: url('data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><circle cx=\"20\" cy=\"20\" r=\"2\" fill=\"rgba(255,255,255,0.1)\"/><circle cx=\"80\" cy=\"40\" r=\"1.5\" fill=\"rgba(255,255,255,0.1)\"/><circle cx=\"40\" cy=\"80\" r=\"1\" fill=\"rgba(255,255,255,0.1)\"/></svg>');\n          z-index: 1;\n        \"></div>\n        \n        <!-- Main content -->\n        <div style=\"position: relative; z-index: 2; height: 100%;\">\n          <!-- Header -->\n          <div style=\"\n            text-align: center;\n            margin-bottom: 40px;\n            border-bottom: 2px solid rgba(255,255,255,0.3);\n            padding-bottom: 20px;\n          \">\n            <h1 style=\"\n              font-size: 48px;\n              margin: 0 0 10px 0;\n              font-weight: bold;\n              text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n            \">${title}</h1>\n            ${program_title ? `<h2 style=\"\n              font-size: 32px;\n              margin: 0;\n              font-weight: normal;\n              color: rgba(255,255,255,0.9);\n            \">${program_title}</h2>` : ''}\n          </div>\n          \n          <!-- Date and Time Section -->\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n          \">\n            <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n              <div style=\"text-align: center;\">\n                <div style=\"font-size: 24px; font-weight: bold; margin-bottom: 5px;\">${dayName}</div>\n                <div style=\"font-size: 28px;\">${persianDateStr}</div>\n              </div>\n              <div style=\"text-align: center;\">\n                <div style=\"font-size: 20px; margin-bottom: 5px;\">ساعت</div>\n                <div style=\"font-size: 32px; font-weight: bold;\">${time}</div>\n              </div>\n            </div>\n          </div>\n          \n          <!-- Venue Section -->\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 10px;\">📍 محل برگزاری</div>\n            <div style=\"font-size: 24px; font-weight: bold;\">${venue}</div>\n          </div>\n          \n          <!-- Description -->\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n            min-height: 150px;\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 15px;\">📝 توضیحات</div>\n            <div style=\"font-size: 18px; line-height: 1.6;\">${description}</div>\n          </div>\n          \n          <!-- Actors Section -->\n          ${actors && actors.length > 0 ? `\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            margin-bottom: 30px;\n            backdrop-filter: blur(10px);\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 15px;\">🎭 عوامل</div>\n            <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\">\n              ${actors.map(actor => `\n                <div style=\"font-size: 16px;\">\n                  <strong>${actor.name}</strong>\n                  ${actor.role_in_program ? `<br><small>${actor.role_in_program}</small>` : ''}\n                </div>\n              `).join('')}\n            </div>\n          </div>\n          ` : ''}\n          \n          <!-- Price Section -->\n          ${price ? `\n          <div style=\"\n            background: rgba(255,255,255,0.1);\n            border-radius: 15px;\n            padding: 25px;\n            backdrop-filter: blur(10px);\n            text-align: center;\n          \">\n            <div style=\"font-size: 20px; margin-bottom: 10px;\">💰 قیمت بلیت</div>\n            <div style=\"font-size: 32px; font-weight: bold; color: #FFD700;\">${price}</div>\n          </div>\n          ` : ''}\n          \n          <!-- Footer -->\n          <div style=\"\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            text-align: center;\n            padding: 20px;\n            border-top: 2px solid rgba(255,255,255,0.3);\n          \">\n            <div style=\"font-size: 16px; opacity: 0.8;\">\n              تهیه شده با سامانه رسا\n            </div>\n            <div style=\"font-size: 14px; opacity: 0.6; margin-top: 5px;\">\n              ${persianDate.getCurrentDateTime()}\n            </div>\n          </div>\n        </div>\n      </div>\n    `;\n  },\n  \n  // Generate poster image\n  async generatePosterImage(announcement) {\n    const html = this.generatePosterHTML(announcement);\n    \n    // Create temporary container\n    const container = document.createElement('div');\n    container.innerHTML = html;\n    container.style.position = 'absolute';\n    container.style.left = '-9999px';\n    container.style.top = '-9999px';\n    document.body.appendChild(container);\n    \n    try {\n      const canvas = await html2canvas(container, {\n        width: 800,\n        height: 1000,\n        scale: 2,\n        backgroundColor: null,\n        useCORS: true,\n        allowTaint: true\n      });\n      \n      document.body.removeChild(container);\n      return canvas.toDataURL('image/png', 1.0);\n    } catch (error) {\n      document.body.removeChild(container);\n      throw error;\n    }\n  },\n  \n  // Generate PDF\n  async generatePDF(announcement) {\n    const imageData = await this.generatePosterImage(announcement);\n    \n    const pdf = new jsPDF({\n      orientation: 'portrait',\n      unit: 'mm',\n      format: 'a4'\n    });\n    \n    // Calculate dimensions to fit A4\n    const pdfWidth = 210; // A4 width in mm\n    const pdfHeight = 297; // A4 height in mm\n    const imageWidth = 800;\n    const imageHeight = 1000;\n    \n    // Calculate scaling to fit the page\n    const scale = Math.min(pdfWidth / imageWidth, pdfHeight / imageHeight) * 25.4; // Convert pixels to mm\n    const width = imageWidth * scale / 25.4;\n    const height = imageHeight * scale / 25.4;\n    \n    // Center the image\n    const x = (pdfWidth - width) / 2;\n    const y = (pdfHeight - height) / 2;\n    \n    pdf.addImage(imageData, 'PNG', x, y, width, height);\n    \n    return pdf.output('blob');\n  }\n};\n\nexport default announcementGenerator;","D:\\AI_Projects\\proj2\\client\\src\\utils\\locale.ts",[],"D:\\AI_Projects\\proj2\\client\\src\\components\\Logo.tsx",["151"],"import React, { useEffect, useRef, useState } from 'react';\n\ntype LogoProps = {\n  src?: string;\n  height?: number;\n  width?: number;\n  threshold?: number; // 0-255, higher removes more near-white\n  className?: string;\n  alt?: string;\n};\n\n// Client-side background remover: makes near-white pixels transparent\nexport default function Logo({\n  src = '/logo.png',\n  height = 32,\n  width,\n  threshold = 240,\n  className,\n  alt = 'لوگو',\n}: LogoProps) {\n  const [dataUrl, setDataUrl] = useState<string | null>(null);\n  const [naturalSize, setNaturalSize] = useState<{ w: number; h: number } | null>(null);\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  useEffect(() => {\n    const img = new Image();\n    img.crossOrigin = 'anonymous';\n    img.onload = () => {\n      const w = img.naturalWidth;\n      const h = img.naturalHeight;\n      setNaturalSize({ w, h });\n      const canvas = document.createElement('canvas');\n      canvas.width = w;\n      canvas.height = h;\n      const ctx = canvas.getContext('2d');\n      if (!ctx) return;\n      ctx.drawImage(img, 0, 0);\n      const imageData = ctx.getImageData(0, 0, w, h);\n      const data = imageData.data;\n      for (let i = 0; i < data.length; i += 4) {\n        const r = data[i];\n        const g = data[i + 1];\n        const b = data[i + 2];\n        // If close to white, make transparent\n        if (r >= threshold && g >= threshold && b >= threshold) {\n          data[i + 3] = 0;\n        }\n      }\n      ctx.putImageData(imageData, 0, 0);\n      const url = canvas.toDataURL('image/png');\n      setDataUrl(url);\n      canvasRef.current = canvas;\n    };\n    img.onerror = () => {\n      // Fallback: just use original src\n      setDataUrl(null);\n    };\n    img.src = src;\n  }, [src, threshold]);\n\n  const computedStyle: React.CSSProperties = {\n    height,\n    width,\n    display: 'inline-block',\n    objectFit: 'contain',\n  };\n\n  // If we have a processed data URL, use it; otherwise use raw src\n  const finalSrc = dataUrl ?? src;\n\n  return (\n    <img\n      src={finalSrc}\n      alt={alt}\n      className={className}\n      style={computedStyle}\n      loading=\"eager\"\n    />\n  );\n}\nexport const ThemeToggle: React.FC = () => {\n  const [theme, setTheme] = React.useState<string>(() => localStorage.getItem('theme') || 'light');\n  React.useEffect(() => {\n    document.body.classList.toggle('dark', theme === 'dark');\n    localStorage.setItem('theme', theme);\n  }, [theme]);\n  return (\n    <button onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')} className=\"login-btn\" style={{ marginInlineEnd: 8 }}>\n      {theme === 'dark' ? 'تم روشن' : 'تم تاریک'}\n    </button>\n  );\n};","D:\\AI_Projects\\proj2\\client\\src\\pages\\AnnouncementForm.tsx",["152"],"import React, { useState, useEffect } from 'react';\nimport { useNavigate, useParams } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport { FaSave, FaTimes } from 'react-icons/fa';\nimport axios from 'axios';\nimport './AnnouncementForm.css';\nimport DatePicker from 'react-multi-date-picker';\nimport TimePicker from 'react-multi-date-picker/plugins/time_picker';\nimport persian from 'react-date-object/calendars/persian';\nimport DateObject from 'react-date-object';\nimport gregorian from 'react-date-object/calendars/gregorian';\nimport { normalizeTime } from '../utils/locale';\n\nconst AnnouncementForm: React.FC = () => {\n  const navigate = useNavigate();\n  const { id } = useParams<{ id: string }>();\n  const isEdit = Boolean(id);\n\n  const [formData, setFormData] = useState({\n    title: '',\n    description: '',\n    date: '',\n    time: '',\n    location: '',\n    programId: '',\n    actorIds: [] as string[]\n  });\n  const [status, setStatus] = useState<'draft' | 'published'>('draft');\n\n  const [loading, setLoading] = useState(false);\n  const [programs, setPrograms] = useState<any[]>([]);\n  const [actors, setActors] = useState<any[]>([]);\n  const [actorRoles, setActorRoles] = useState<Record<string, string>>({});\n\n  useEffect(() => {\n    if (isEdit) {\n      fetchAnnouncement();\n    }\n    // Load programs and actors\n    const loadOptions = async () => {\n      try {\n        const [progRes, actRes] = await Promise.all([\n          axios.get('/api/programs', { params: { limit: 100 } }),\n          axios.get('/api/actors', { params: { limit: 100 } })\n        ]);\n        setPrograms(progRes.data);\n        setActors(actRes.data);\n      } catch (err) {\n        // silent fail\n      }\n    };\n    loadOptions();\n    const draft = localStorage.getItem('announcement_draft');\n    if (!isEdit && draft) {\n      try {\n        const d = JSON.parse(draft);\n        setFormData(d.formData || formData);\n        setStatus(d.status || 'draft');\n      } catch { }\n    }\n  }, [id]);\n\n  const fetchAnnouncement = async () => {\n    try {\n      const response = await axios.get(`/api/announcements/${id}`);\n      const announcement = response.data;\n      setFormData({\n        title: announcement.title,\n        description: announcement.description,\n        date: announcement.date,\n        time: announcement.time,\n        location: announcement.venue,\n        programId: announcement.program_id ? String(announcement.program_id) : '',\n        actorIds: announcement.actors?.map((actor: any) => actor.id) || []\n      });\n    } catch (error) {\n      toast.error('خطا در دریافت اطلاعات آفیش');\n      navigate('/announcements');\n    }\n  };\n\n  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {\n    const { name, value } = e.target;\n    setFormData(prev => ({\n      ...prev,\n      [name]: value\n    }));\n    setTimeout(() => {\n      localStorage.setItem('announcement_draft', JSON.stringify({ formData: { ...formData, [name]: value }, status }));\n    }, 0);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.title || !formData.description || !formData.date || !formData.time || !formData.location) {\n      toast.error('لطفاً فیلدهای الزامی را پر کنید');\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const token = localStorage.getItem('token');\n      const payload = {\n        title: formData.title,\n        description: formData.description,\n        program_id: formData.programId || null,\n        date: formData.date,\n        time: normalizeTime(formData.time),\n        venue: formData.location,\n        price: null,\n        actor_ids: formData.actorIds || [],\n        actor_roles: (formData.actorIds || []).map(aid => actorRoles[aid] || null),\n        status,\n      };\n\n      if (isEdit) {\n        await axios.put(`/api/announcements/${id}`, payload, {\n          headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n        });\n        toast.success('آفیش با موفقیت ویرایش شد');\n      } else {\n        await axios.post('/api/announcements', payload, {\n          headers: token ? { Authorization: `Bearer ${token}` } : undefined,\n        });\n        toast.success('آفیش با موفقیت ایجاد شد');\n      }\n\n      navigate('/announcements');\n      localStorage.removeItem('announcement_draft');\n    } catch (error) {\n      toast.error(isEdit ? 'خطا در ویرایش آفیش' : 'خطا در ایجاد آفیش');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"announcement-form-container\">\n      <h2>{isEdit ? 'ویرایش آفیش' : 'ایجاد آفیش جدید'}</h2>\n\n      <form onSubmit={handleSubmit} className=\"announcement-form\">\n        <div className=\"form-group\">\n          <label htmlFor=\"title\">عنوان آفیش *</label>\n          <input\n            type=\"text\"\n            id=\"title\"\n            name=\"title\"\n            value={formData.title}\n            onChange={handleInputChange}\n            className=\"form-input\"\n            required\n          />\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"status\">وضعیت</label>\n          <select id=\"status\" value={status} onChange={(e) => { setStatus(e.target.value as any); localStorage.setItem('announcement_draft', JSON.stringify({ formData, status: e.target.value })); }} className=\"form-select\">\n            <option value=\"draft\">پیش‌نویس</option>\n            <option value=\"published\">منتشر شده</option>\n          </select>\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"description\">توضیحات</label>\n          <textarea\n            id=\"description\"\n            name=\"description\"\n            value={formData.description}\n            onChange={handleInputChange}\n            className=\"form-textarea\"\n            rows={4}\n          />\n        </div>\n\n        <div className=\"form-row\">\n          <div className=\"form-group\">\n            <label htmlFor=\"date\">تاریخ *</label>\n            <DatePicker\n              calendar={persian}\n              inputClass=\"form-input\"\n              value={formData.date ? new DateObject({ date: new Date(formData.date) }).convert(persian) : null}\n              onChange={(val: any) => {\n                if (!val) {\n                  setFormData(prev => ({ ...prev, date: '' }));\n                  return;\n                }\n                try {\n                  const obj = val instanceof DateObject ? val : new DateObject(val);\n                  const greg = obj.convert(gregorian).format('YYYY-MM-DD');\n                  setFormData(prev => ({ ...prev, date: greg }));\n                } catch {\n                  toast.error('خطا در تنظیم تاریخ');\n                }\n              }}\n              format=\"YYYY/MM/DD\"\n              placeholder=\"انتخاب تاریخ به تقویم شمسی\"\n              required\n            />\n          </div>\n\n          <div className=\"form-group\">\n            <label htmlFor=\"time\">زمان *</label>\n            <DatePicker\n              calendar={persian}\n              format=\"HH:mm\"\n              inputClass=\"form-input\"\n              disableDayPicker\n              plugins={[<TimePicker hideSeconds />]}\n              value={formData.time || undefined}\n              onChange={(val: any) => {\n                if (!val) {\n                  setFormData(prev => ({ ...prev, time: '' }));\n                  return;\n                }\n                try {\n                  const obj = val instanceof DateObject ? val : new DateObject(val);\n                  const time = obj.format('HH:mm');\n                  setFormData(prev => ({ ...prev, time }));\n                } catch {\n                  toast.error('خطا در تنظیم زمان');\n                }\n              }}\n              placeholder=\"انتخاب زمان (فارسی)\"\n              required\n            />\n          </div>\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"location\">مکان</label>\n          <input\n            type=\"text\"\n            id=\"location\"\n            name=\"location\"\n            value={formData.location}\n            onChange={handleInputChange}\n            className=\"form-input\"\n          />\n        </div>\n\n        <div className=\"form-group\">\n          <label htmlFor=\"programId\">برنامه مرتبط</label>\n          <select\n            id=\"programId\"\n            name=\"programId\"\n            value={formData.programId}\n            onChange={handleInputChange}\n            className=\"form-select\"\n          >\n            <option value=\"\">بدون برنامه</option>\n            {programs.map((p: any) => (\n              <option key={p.id} value={String(p.id)}>{p.title}</option>\n            ))}\n          </select>\n        </div>\n\n        <div className=\"form-group\">\n          <label>انتخاب عوامل و نقش در برنامه</label>\n          <div className=\"actors-grid\">\n            {actors.map((a: any) => {\n              const checked = formData.actorIds.includes(String(a.id));\n              return (\n                <div className=\"actor-checkbox\" key={a.id}>\n                  <input\n                    type=\"checkbox\"\n                    checked={checked}\n                    onChange={(e) => {\n                      const isChecked = e.target.checked;\n                      setFormData(prev => ({\n                        ...prev,\n                        actorIds: isChecked\n                          ? [...prev.actorIds, String(a.id)]\n                          : prev.actorIds.filter(id => id !== String(a.id))\n                      }));\n                    }}\n                  />\n                  <label>{a.name} <span className=\"actor-role\">({a.role})</span></label>\n                  {checked && (\n                    <input\n                      type=\"text\"\n                      placeholder=\"نقش در برنامه\"\n                      value={actorRoles[String(a.id)] || ''}\n                      onChange={(e) => setActorRoles(prev => ({ ...prev, [String(a.id)]: e.target.value }))}\n                      className=\"form-input\"\n                      style={{ maxWidth: '180px' }}\n                    />\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        <div className=\"form-actions\">\n          <button type=\"submit\" className=\"save-btn\" disabled={loading}>\n            {loading ? (\n              <span>در حال ذخیره...</span>\n            ) : (\n              <>\n                <FaSave />\n                {isEdit ? 'ویرایش آفیش' : 'ایجاد آفیش'}\n              </>\n            )}\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => navigate('/announcements')}\n            className=\"cancel-btn\"\n            disabled={loading}\n          >\n            <FaTimes />\n            انصراف\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => { localStorage.setItem('announcement_draft', JSON.stringify({ formData, status })); toast.success('پیش‌نویس ذخیره شد'); }}\n            className=\"save-btn\"\n            disabled={loading}\n            style={{ marginInlineStart: '8px' }}\n          >\n            ذخیره پیش‌نویس\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n};\n\nexport default AnnouncementForm;\n","D:\\AI_Projects\\proj2\\client\\src\\components\\Layout\\Footer.tsx",[],"D:\\AI_Projects\\proj2\\client\\src\\pages\\Display.tsx",["153"],"import React, { useState, useEffect } from 'react';\nimport { useNavigate } from 'react-router-dom';\nimport { toast } from '../libs/toast';\nimport { FaCalendar, FaClock, FaMapMarkerAlt, FaUser, FaPrint } from 'react-icons/fa';\nimport axios from 'axios';\nimport './Display.css';\nimport Logo from '../components/Logo';\n\ninterface Announcement {\n  id: string;\n  title: string;\n  description: string;\n  date: string;\n  time: string;\n  venue?: string;\n  program_title?: string;\n  poster_image?: string;\n  actors?: Array<{\n    id: string;\n    name: string;\n    role?: string;\n    role_in_program?: string;\n  }>;\n}\n\nconst Display: React.FC = () => {\n  const navigate = useNavigate();\n  const [announcements, setAnnouncements] = useState<Announcement[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [currentDate, setCurrentDate] = useState('');\n  const [currentTime, setCurrentTime] = useState('');\n  const [now, setNow] = useState<Date>(new Date());\n\n  useEffect(() => {\n    fetchAnnouncements();\n    updateCurrentDate();\n    updateCurrentTime();\n    const dateInterval = setInterval(updateCurrentDate, 60000);\n    const timeInterval = setInterval(() => { updateCurrentTime(); setNow(new Date()); }, 1000);\n    const announcementsInterval = setInterval(fetchAnnouncements, 60000);\n    return () => {\n      clearInterval(dateInterval);\n      clearInterval(timeInterval);\n      clearInterval(announcementsInterval);\n    };\n  }, []);\n\n  const updateCurrentDate = () => {\n    const now = new Date();\n    const persianDate = now.toLocaleDateString('fa-IR', {\n      year: 'numeric',\n      month: 'long',\n      day: 'numeric',\n      weekday: 'long'\n    });\n    setCurrentDate(persianDate);\n  };\n\n  const updateCurrentTime = () => {\n    const now = new Date();\n    const timeStr = now.toLocaleTimeString('fa-IR', {\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit'\n    });\n    setCurrentTime(timeStr);\n  };\n\n  const fetchAnnouncements = async () => {\n    try {\n      const today = new Date().toISOString().split('T')[0];\n      const response = await axios.get(`/api/announcements?date=${today}&status=published`);\n      setAnnouncements(response.data);\n    } catch (error) {\n      toast.error('خطا در دریافت آفیش‌ها');\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const formatDate = (dateString: string) => {\n    return new Date(dateString).toLocaleDateString('fa-IR');\n  };\n\n  const timeDiffMinutes = (dateStr: string, timeStr: string) => {\n    try {\n      const [h, m] = (timeStr || '00:00').split(':').map(Number);\n      const dt = new Date(dateStr);\n      dt.setHours(h || 0, m || 0, 0, 0);\n      const diffMs = dt.getTime() - now.getTime();\n      return Math.round(diffMs / 60000);\n    } catch { return null; }\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  if (loading) {\n    return (\n      <div className=\"display-loading\">\n        <div className=\"loading-spinner\"></div>\n        <p>در حال بارگذاری آفیش‌ها...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"display-container\">\n      <div className=\"print-logo\" aria-hidden=\"true\">\n        <Logo src=\"/logo.png.jpg\" height={144} width={144} alt=\"لوگو\" />\n      </div>\n      <header className=\"display-header\">\n        <div className=\"header-content\">\n          <h1 className=\"system-title\">سامانه رسا</h1>\n          <div className=\"header-meta\">\n            <div className=\"current-date\">{currentDate}</div>\n            <div className=\"live-time\">{currentTime}</div>\n          </div>\n          <button onClick={handlePrint} className=\"print-btn\">\n            <FaPrint />\n            چاپ\n          </button>\n        </div>\n      </header>\n\n      <main className=\"display-main\">\n        {announcements.length === 0 ? (\n          <div className=\"no-announcements\">\n            <FaCalendar />\n            <h2>آفیشی برای امروز ثبت نشده است</h2>\n            <p>جهت ثبت آفیش جدید به پنل مدیریت مراجعه کنید</p>\n          </div>\n        ) : (\n          <div className=\"announcements-grid\">\n            {announcements.map(announcement => {\n              const diff = timeDiffMinutes(announcement.date, announcement.time);\n              const isSoon = typeof diff === 'number' && diff >= 0 && diff <= 60;\n              return (\n                <div key={announcement.id} className=\"announcement-card\" style={isSoon ? { boxShadow: '0 0 0 3px #27ae60 inset' } : undefined}>\n                  {announcement.poster_image && (\n                    <div className=\"card-image\">\n                      <img src={announcement.poster_image.startsWith('http') ? announcement.poster_image : `/uploads/${announcement.poster_image}`} alt={announcement.title} />\n                    </div>\n                  )}\n\n                  <div className=\"card-content\">\n                    <h3 className=\"announcement-title\">{announcement.title}</h3>\n\n                    {announcement.description && (\n                      <p className=\"announcement-description\">{announcement.description}</p>\n                    )}\n\n                    {announcement.program_title && (\n                      <div className=\"program-info\">\n                        <h4>برنامه: {announcement.program_title}</h4>\n                      </div>\n                    )}\n\n                    <div className=\"announcement-details\">\n                      <div className=\"detail-item\">\n                        <FaCalendar />\n                        <span>{formatDate(announcement.date)}</span>\n                      </div>\n\n                      <div className=\"detail-item\">\n                        <FaClock />\n                        <span>{announcement.time}</span>\n                      </div>\n\n                      {announcement.venue && (\n                        <div className=\"detail-item\">\n                          <FaMapMarkerAlt />\n                          <span>{announcement.venue}</span>\n                        </div>\n                      )}\n                    </div>\n\n                    {announcement.actors && announcement.actors.length > 0 && (\n                      <div className=\"actors-section\">\n                        <h4><FaUser /> عوامل</h4>\n                        <div className=\"actors-list\">\n                          {announcement.actors.map(actor => (\n                            <div key={actor.id} className=\"actor-item\">\n                              <span className=\"actor-name\">{actor.name}</span>\n                              <span className=\"actor-role\">{actor.role || actor.role_in_program || ''}</span>\n                            </div>\n                          ))}\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                  {typeof diff === 'number' && (\n                    <div className=\"detail-item\" style={{ color: diff < 0 ? '#e74c3c' : '#27ae60' }}>\n                      <FaClock />\n                      <span>{diff < 0 ? `گذشته ${Math.abs(diff)} دقیقه` : `تا شروع ${diff} دقیقه`}</span>\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </main>\n\n      <footer className=\"display-footer\">\n        <p>© 2024 سامانه رسا</p>\n      </footer>\n    </div>\n  );\n};\n\nexport default Display;\n","D:\\AI_Projects\\proj2\\client\\src\\components\\Layout\\Header.tsx",[],{"ruleId":"154","severity":1,"message":"155","line":5,"column":3,"nodeType":"156","messageId":"157","endLine":5,"endColumn":18},{"ruleId":"154","severity":1,"message":"158","line":6,"column":15,"nodeType":"156","messageId":"157","endLine":6,"endColumn":20},{"ruleId":"159","severity":1,"message":"160","line":26,"column":6,"nodeType":"161","endLine":26,"endColumn":26,"suggestions":"162"},{"ruleId":"159","severity":1,"message":"163","line":21,"column":6,"nodeType":"161","endLine":21,"endColumn":28,"suggestions":"164"},{"ruleId":"154","severity":1,"message":"165","line":6,"column":15,"nodeType":"156","messageId":"157","endLine":6,"endColumn":22},{"ruleId":"159","severity":1,"message":"166","line":37,"column":6,"nodeType":"161","endLine":37,"endColumn":45,"suggestions":"167"},{"ruleId":"154","severity":1,"message":"168","line":83,"column":15,"nodeType":"156","messageId":"157","endLine":83,"endColumn":19},{"ruleId":"159","severity":1,"message":"169","line":16,"column":6,"nodeType":"161","endLine":16,"endColumn":10,"suggestions":"170"},{"ruleId":"154","severity":1,"message":"171","line":1,"column":28,"nodeType":"156","messageId":"157","endLine":1,"endColumn":35},{"ruleId":"159","severity":1,"message":"172","line":26,"column":6,"nodeType":"161","endLine":26,"endColumn":17,"suggestions":"173"},{"ruleId":"154","severity":1,"message":"174","line":16,"column":10,"nodeType":"156","messageId":"157","endLine":16,"endColumn":22},{"ruleId":"159","severity":1,"message":"175","line":21,"column":49,"nodeType":"161","endLine":21,"endColumn":53,"suggestions":"176"},{"ruleId":"154","severity":1,"message":"177","line":42,"column":9,"nodeType":"156","messageId":"157","endLine":42,"endColumn":23},{"ruleId":"178","severity":1,"message":"179","line":16,"column":7,"nodeType":"156","messageId":"157","endLine":16,"endColumn":19},{"ruleId":"154","severity":1,"message":"180","line":22,"column":10,"nodeType":"156","messageId":"157","endLine":22,"endColumn":21},{"ruleId":"159","severity":1,"message":"181","line":61,"column":6,"nodeType":"161","endLine":61,"endColumn":10,"suggestions":"182"},{"ruleId":"154","severity":1,"message":"183","line":27,"column":9,"nodeType":"156","messageId":"157","endLine":27,"endColumn":17},"@typescript-eslint/no-unused-vars","'FaTachometerAlt' is defined but never used.","Identifier","unusedVar","'FaCog' is defined but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'filterActors'. Either include it or remove the dependency array.","ArrayExpression",["184"],"React Hook useEffect has a missing dependency: 'filterPrograms'. Either include it or remove the dependency array.",["185"],"'FaPrint' is defined but never used.","React Hook useEffect has a missing dependency: 'filterAnnouncements'. Either include it or remove the dependency array.",["186"],"'prev' is assigned a value but never used.","React Hook useEffect has a missing dependency: 'fetchAnnouncement'. Either include it or remove the dependency array.",["187"],"'useMemo' is defined but never used.","React Hook useEffect has a missing dependency: 'fetchEstimates'. Either include it or remove the dependency array.",["188"],"'savingRoleId' is assigned a value but never used.","React Hook useEffect has a missing dependency: 'fetchEstimate'. Either include it or remove the dependency array.",["189"],"'updateRoleWage' is assigned a value but never used.","no-unused-vars","'program_type' is assigned a value but never used.","'naturalSize' is assigned a value but never used.","React Hook useEffect has missing dependencies: 'fetchAnnouncement', 'formData', and 'isEdit'. Either include them or remove the dependency array. You can also do a functional update 'setFormData(f => ...)' if you only need 'formData' in the 'setFormData' call.",["190"],"'navigate' is assigned a value but never used.",{"desc":"191","fix":"192"},{"desc":"193","fix":"194"},{"desc":"195","fix":"196"},{"desc":"197","fix":"198"},{"desc":"199","fix":"200"},{"desc":"201","fix":"202"},{"desc":"203","fix":"204"},"Update the dependencies array to be: [actors, filterActors, searchTerm]",{"range":"205","text":"206"},"Update the dependencies array to be: [filterPrograms, programs, searchTerm]",{"range":"207","text":"208"},"Update the dependencies array to be: [announcements, searchTerm, dateFilter, filterAnnouncements]",{"range":"209","text":"210"},"Update the dependencies array to 